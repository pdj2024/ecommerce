@rendermode InteractiveServer
@page "/search-page"
using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

<MyHeader dataSourch=@dataSourch  @ref="header_page" />
<PageTitle>Search: @dataSourch.SearchList.TotalCount.ToString() result for @SearchText </PageTitle>
<!-- Start Trending Product Area -->
<section class="trending-product section px-0 px-lg-3 px-xl-2 px-xxl-10" style="margin-top: 70px;">
    <div class="container-fluid" style="position:relative;" >
        <div class="row" style="justify-content: center;width: 100%;position: absolute;z-index: 100; left:1.7%;">
            <div class="col-12">
                <div class="section-title">
                    <h2>Search results</h2>
                </div>
            </div>
            <div class="col-12 col-md-12 col-lg-6 ps-3 pe-2 pe-md-3 px-xl-0">
                <div class="input-group mb-3 style-grup">
                    <span class="input-group-text" id="basic-addon1" style="padding: 0px;"><i class="lni lni-search-1" style="font:normal normal normal 22px/1 'Lineicons';"></i></span>
                    <InputText autocomplete="off" @bind-Value=@SearchText @oninput="@(e => OnSearchInput(e.Value?.ToString()))" type="text" class="form-control search-form" placeholder="Search" aria-label="Search" aria-describedby="basic-addon1" />
                    <button class="clear-search" @onclick="@(e => OnClearInput())" >
                        @if (loadProses)
                        {
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        }
                        else
                        {
                            <span>Clear</span>
                        }
                    </button>
                </div>
            </div>
        </div>


        <div class="row">
            <div class="col-3 d-none d-lg-none d-xl-flex" style="margin-top:40px">
                <div class="filters position-sticky top-0" style="height:fit-content;padding-top:85px; margin-top:20px">
                    <div class="filter-accordion" style="border-bottom: 1px solid darkgray;">
                        <input type="checkbox" id="filter-genre" class="filter-toggle">
                        <label for="filter-genre" style="font-size: 23px;letter-spacing: -1.7px;" class="filter-label search-fil py-4 px-0">Gender</label>
                        <div class="filter-content px-0" >
                            @foreach (var dataKategori in dataSourch?.ListDataKategori)
                            {
                                if (dataKategori.Nama_Kategori == "Men's" || dataKategori.Nama_Kategori == "Women's" || dataKategori.Nama_Kategori == "Kid's")
                                {
                                    <label><input type="checkbox" checked=@dataKategori.Checked_Filter @onchange=@(x => changeFilter(dataKategori, null, x, null)) > 
                                        @dataKategori.Nama_Kategori
                                    </label>
                                }
                            }
                        </div>
                    </div>
                    <div class="filter-accordion" style="border-bottom: 1px solid darkgray;">
                        <input type="checkbox" id="filter-brand" class="filter-toggle">
                        <label for="filter-brand" style="font-size: 23px;letter-spacing: -1.7px;" class="filter-label search-fil py-4 px-0">Brand</label>
                        <div class="filter-content px-0" >
                            @foreach (var dataBrand in dataSourch?.ListDataBrand)
                            {
                                <label><input type="checkbox" checked=@dataBrand.Checked_Filter @onchange=@(x => changeFilter(null, dataBrand, x, null))> @dataBrand.Nama_Brand</label>
                            }
                        </div>
                    </div>
                    <div class="filter-accordion" style="border-bottom: 1px solid darkgray;">
                        <input type="checkbox" id="filter-category" class="filter-toggle">
                        <label for="filter-category" style="font-size: 23px;letter-spacing: -1.7px;" class="filter-label search-fil py-4 px-0">Kategori</label>
                        <div class="filter-content px-0" >
                            @foreach (var dataKategori in dataSourch?.ListDataKategori)
                            {
                                if (dataKategori.Nama_Kategori != "Men's" && dataKategori.Nama_Kategori != "Women's" && dataKategori.Nama_Kategori != "Kid's")
                                {
                                    <label>
                                        <input type="checkbox" checked=@dataKategori.Checked_Filter @onchange=@(x => changeFilter(dataKategori, null, x, null))>
                                        @dataKategori.Nama_Kategori
                                    </label>
                                }
                            }
                        </div>
                    </div>
                    <div class="filter-accordion" style="border-bottom: 1px solid darkgray;">
                        <input type="checkbox" id="filter-price" class="filter-toggle">
                        <label for="filter-price" style="font-size: 23px;letter-spacing: -1.7px;" class="filter-label search-fil py-4 px-0">Harga</label>
                        <div class="filter-content px-0" >
                            <label><input type="radio" name="price" value="0-500"> ≤ Rp 500.000</label>
                            <label><input type="radio" name="price" value="500-1000"> Rp 500.000–1.000.000</label>
                            <label><input type="radio" name="price" value="1000"> > Rp 1.000.000</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-12 col-xl-9" style="margin-top:40px">
                
                <div class="row position-sticky top-0" style="height:fit-content; padding-top:85px; z-index:30;">
                    
                    <div class="col-12 d-flex justify-content-between align-items-center py-md-2 py-3 px-0 px-xl-2 bg-white">
                        
                        <button class="btn-slide px-3 py-2 justify-content-around d-flex d-md-none w-auto" type="button" style="z-index:0;" data-bs-toggle="offcanvas" data-bs-target="#offcanvasFilter" aria-controls="offcanvasLeft"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor"><path d="M528-600v-72h108v-144h72v144h108v72H528Zm108 456v-384h72v384h-72Zm-384 0v-144H144v-72h288v72H324v144h-72Zm0-288v-384h72v384h-72Z" /></svg>
                            <span style="position:relative; z-index:1" class="ms-3">
                                Filter
                            </span>
                        </button>

                        <div class="d-flex d-md-none w-auto gap-1">
                            <button @onclick="@(x => OnChangeViewSm(true))" class="px-3 py-2 justify-content-around @(ShowOneLine ? "bg-primary border-0 text-white" : "btn-slide")" type="button" style="z-index:0;">
                                <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor"><path d="M200-520q-33 0-56.5-23.5T120-600v-160q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v160q0 33-23.5 56.5T760-520H200Zm0-80h560v-160H200v160Zm0 480q-33 0-56.5-23.5T120-200v-160q0-33 23.5-56.5T200-440h560q33 0 56.5 23.5T840-360v160q0 33-23.5 56.5T760-120H200Zm0-80h560v-160H200v160Zm0-560v160-160Zm0 400v160-160Z" /></svg>
                            </button>
                            <button @onclick="@(x => OnChangeViewSm(false))" class="px-3 py-2 justify-content-around @(ShowOneLine ? "btn-slide" : "bg-primary border-0 text-white")" type="button" style="z-index:0;">
                                <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor"><path d="M600-120q-33 0-56.5-23.5T520-200v-560q0-33 23.5-56.5T600-840h160q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H600Zm0-640v560h160v-560H600ZM200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h160q33 0 56.5 23.5T440-760v560q0 33-23.5 56.5T360-120H200Zm0-640v560h160v-560H200Zm560 0H600h160Zm-400 0H200h160Z" /></svg>
                            </button>
                        </div>



                        @if (loadProses)
                        {
                            <div class="spinner-border spinner-border-sm d-none d-md-none d-lg-flex" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        }
                        else
                        {
                            <p class="d-none d-sm-none d-md-flex ps-md-2 ps-xl-0">@dataSourch?.SearchList.TotalCount results</p>
                        }

                        <div class="d-none d-sm-none d-md-flex  gap-4 align-items-center">

                            @if (loadProses)
                            {
                                <div class="spinner-border spinner-border-sm d-flex d-lg-flex d-xl-none" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            }
                            else
                            {
                                <p class="d-flex d-lg-flex d-xl-none">@dataSourch?.SearchList.TotalCount results</p>
                            }

                            <div class="btn-group w-auto">
                                <button class="dropdown-toggle btn-slide py-2 px-3 justify-content-around border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="z-index:0;">
                                    <span style="position:relative; z-index:1; position: relative;z-index: 1;max-width: 150px;overflow: hidden;text-overflow: ellipsis;">
                                        Short by : @ShortActive
                                    </span>
                                    <i class="lni lni-chevron-up ms-2" style="transform: rotateZ(180deg);font-size: 18px;font-weight: 500;" ></i>
                                </button>
                                <ul class="dropdown-menu">
                                    <li class="style-drop">
                                        <button type="button"
                                                class="dropdown-item @(ShortActive == "Name, A - Z" ? "active" : "")"
                                                @onclick="@(() => OnShortChanged("Name, A - Z", true))">
                                            <span>
                                                Name, A - Z
                                            </span>
                                        </button>
                                    </li>
                                    <li class="style-drop">
                                        <button type="button"
                                                class="dropdown-item @(ShortActive == "Name, Z - A" ? "active" : "")"
                                                @onclick="@(() => OnShortChanged("Name, Z - A", false))">
                                            <span>
                                                Name, Z - A
                                            </span>
                                        </button>
                                    </li>
                                    <li class="style-drop">
                                        <button type="button"
                                                class="dropdown-item @(ShortActive == "Price, Low - High" ? "active" : "")"
                                                @onclick="@(() => OnShortChanged("Price, Low - High", true))">
                                            <span>
                                                Price, Low - High
                                            </span> 
                                        </button>
                                    </li>
                                    <li class="style-drop">
                                        <button type="button"
                                                class="dropdown-item @(ShortActive == "Price, High - Low" ? "active" : "")"
                                                @onclick="@(() => OnShortChanged("Price, High - Low", false))">
                                            <span>
                                                Price, High - Low
                                            </span> 
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>


                    </div>
                
                </div>

                @if (ListFilter.Count() >= 1)
                {
                    <div class="row pb-2 pt-3 pt-md-3 pt-lg-3 pt-xl-0">
                        <div class="d-flex flex-row flex-wrap gap-2 px-0 px-md-0 px-lg-0 px-xl-2 mt-2">
                            @foreach (var Filter in ListFilter)
                            {
                                @if (!Filter.Checked) { continue; }
                                <button class="btn-slide w-auto px-3 py-2" @onclick="@(x => changeFilter(null, null, null, x, Filter))" style="z-index:0;">
                                    <span style="position:relative; z-index:1; font-weight: 400;">
                                        @Filter.Nama_Display
                                    </span>
                                    <i class="lni lni-xmark ms-3" style="font-size:19px"></i>
                                </button>
                            }

                            @if (ListFilter.Count() >= 2)
                            {
                                <button class="border-0 bg-transparent ps-2 pe-0 py-0" @onclick=@(x => removeAllFilter()) >
                                    <span class="underline-anim">
                                        Remove All
                                    </span>
                                </button>
                            }
                        </div>
                    </div>
                    
                }



                <div class="row">

                    <div class="col-12">

                    
                        @if (loadContent)
                        {
                            <div class="row">
                                @for (var i = 0; i <= 11; i++)
                                {
                                    <div class="col-lg-3 col-md-4 col-6 col-xl-3 pt-2 pb-2">
                                        <div class="card p-3 border-0" style="border-radius:0px;" aria-busy="true">
                                            <div class="skeleton skeleton-rect mb-3"></div>
                                            <div class="d-flex align-items-center justify-content-between">
                                                <div style="flex:1" class="d-flex flex-column align-items-center">
                                                    <div class="skeleton skeleton-title mb-2" style="width:90%"></div>
                                                    <div class="skeleton skeleton-subtitle mb-2" style="width:50%"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                    
                        <div class="d-flex d-md-none row">
                        
                            @if(ShowOneLine)
                            {
                                @foreach (var dataProduk in dataSourch?.SearchList.SearchProduk)
                                {
                                    <div class="col-12 pt-2 pb-2">
                                        <!-- Start Single Product -->
                                        <PacificWeb.Components.Sections.ProductDisplay DataProduk="dataProduk" selectProduk="@selectProduk" />
                                        <!-- End Single Product -->
                                    </div>
                                }
                            } 
                        
                            else
                            {
                                @foreach (var dataProduk in dataSourch?.SearchList.SearchProduk)
                                {
                                    <div class="col-6 pt-2 pb-2">
                                        <!-- Start Single Product -->
                                        <PacificWeb.Components.Sections.ProductDisplay DataProduk="dataProduk" selectProduk="@selectProduk" />
                                        <!-- End Single Product -->
                                    </div>
                                }
                            }

                    
                        </div>

                        <div class="row d-none d-md-flex">
                        
                            @foreach (var dataProduk in dataSourch?.SearchList.SearchProduk)
                            {
                                <div class="col-lg-3 col-md-4 col-6 col-xxl-3 pt-2 pb-2 product">
                                    <!-- Start Single Product -->
                                    <PacificWeb.Components.Sections.ProductDisplay DataProduk="dataProduk" selectProduk="@selectProduk" />
                                    <!-- End Single Product -->
                                </div>


                            }

                    
                        </div>
                    
                    
                        @if (dataSourch.SearchList.hasMore)
                        {
                            <div class="row">
                                <div class="col-12 w-100 d-flex align-items-center justify-content-center mt-4">
                                    <button @onclick="@(x => showMore())" class="btn-slide px-5" style="width:fit-content;z-index:0;">
                                        @if (loadProses)
                                        {
                                            <div class="spinner-border spinner-border-sm position-relative" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="position-relative">
                                                Lebih Banyak
                                            </span>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                        
                        
                        @if (dataSourch.SearchList.TotalCount <= 0)
                        {
                            <div class="row">
                                <div class="col-12 w-100 d-flex align-items-center justify-content-center mt-4">
                                    <div class="d-flex flex-column align-items-center mt-4" style="color:#6b7280">
                                        <svg xmlns="http://www.w3.org/2000/svg" height="5rem" viewBox="0 -960 960 960" width="5rem" class="mb-3" fill="currentColor">
                                            <path d="m634-440-81-80h69l110-200H353l-80-80h525q23 0 35.5 19.5t.5 42.5L692-482q-11 20-28 31t-30 11ZM280-80q-33 0-56.5-23.5T200-160q0-33 23.5-56.5T280-240q33 0 56.5 23.5T360-160q0 33-23.5 56.5T280-80Zm540 52L566-280H304q-44 0-67-37.5t-3-78.5l42-86-72-162L28-820l56-56L876-84l-56 56ZM486-360l-80-80h-62l-40 80h182Zm136-160h-69 69Zm58 440q-33 0-56.5-23.5T600-160q0-33 23.5-56.5T680-240q33 0 56.5 23.5T760-160q0 33-23.5 56.5T680-80Z" />
                                        </svg>
                                        <h5 style="color:#6b7280">Product Not Found</h5>
                                    </div>

                                </div>
                            </div>
                        }
                
                    </div>
                </div>
            </div>
        </div>
    
    </div>
</section>
<!-- End Trending Product Area -->



<MyFooter dataSourch=@dataSourch @ref="footer_page" />

<PacificWeb.Components.Sections.SelectProduk dataSourch=@dataSourch DataProduk="DataProduk" Quantity="DataProduk.Min_Order" header_page="header_page"/>

<div class="offcanvas offcanvas-start" style="width: 500px;" tabindex="-1" id="offcanvasFilter" aria-labelledby="offcanvasLeftLabel">
    <div class="offcanvas-header">
        <h5 id="offcanvasLeftLabel" style="font-size: 1.5rem;font-weight: 800;">
            Filter
        </h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body pt-0">
        <div class="row">
            <div class="col-12">
                <div class="filters" style="">
                    <div class="py-3 w-100" style="border-bottom: 1px solid darkgray;">
                        <div class="btn-group w-100 pb-2" style="display: flex;justify-content: center;">
                            <button class="dropdown-toggle btn-slide py-3 px-5 justify-content-between w-100" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="z-index:0;">
                                <span style="position:relative; z-index:1; position: relative;z-index: 1;max-width: 150px;overflow: hidden;text-overflow: ellipsis;">
                                    Short by : @ShortActive
                                </span>
                                <i class="lni lni-chevron-up ms-2" style="transform: rotateZ(180deg);font-size: 18px;font-weight: 500;"></i>
                            </button>
                            <ul class="dropdown-menu w-100">
                                <li class="style-drop">
                                    <button type="button"
                                            class="dropdown-item @(ShortActive == "Name, A - Z" ? "active" : "")"
                                            @onclick="@(() => OnShortChanged("Name, A - Z", true))">
                                        <span>
                                            Name, A - Z
                                        </span>
                                    </button>
                                </li>
                                <li class="style-drop">
                                    <button type="button"
                                            class="dropdown-item @(ShortActive == "Name, Z - A" ? "active" : "")"
                                            @onclick="@(() => OnShortChanged("Name, Z - A", false))">
                                        <span>
                                            Name, Z - A
                                        </span>
                                    </button>
                                </li>
                                <li class="style-drop">
                                    <button type="button"
                                            class="dropdown-item @(ShortActive == "Price, Low - High" ? "active" : "")"
                                            @onclick="@(() => OnShortChanged("Price, Low - High", true))">
                                        <span>
                                            Price, Low - High
                                        </span>
                                    </button>
                                </li>
                                <li class="style-drop">
                                    <button type="button"
                                            class="dropdown-item @(ShortActive == "Price, High - Low" ? "active" : "")"
                                            @onclick="@(() => OnShortChanged("Price, High - Low", false))">
                                        <span>
                                            Price, High - Low
                                        </span>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="filter-accordion" style="border-bottom: 1px solid darkgray;">
                        <input type="checkbox" id="filter-genre1" class="filter-toggle">
                        <label for="filter-genre1" style="font-size: 23px;letter-spacing: -1.7px;" class="filter-label search-fil py-4 px-0">Gender</label>
                        <div class="filter-content px-0" >
                            @foreach (var dataKategori in dataSourch?.ListDataKategori)
                            {
                                if (dataKategori.Nama_Kategori == "Men's" || dataKategori.Nama_Kategori == "Women's" || dataKategori.Nama_Kategori == "Kid's")
                                {
                                    <label>
                                        <input type="checkbox" checked=@dataKategori.Checked_Filter @onchange=@(x => changeFilter(dataKategori, null, x, null))>
                                        @dataKategori.Nama_Kategori
                                    </label>
                                }
                            }
                        </div>
                    </div>
                    <div class="filter-accordion" style="border-bottom: 1px solid darkgray;">
                        <input type="checkbox" id="filter-brand1" class="filter-toggle">
                        <label for="filter-brand1" style="font-size: 23px;letter-spacing: -1.7px;" class="filter-label search-fil py-4 px-0">Brand</label>
                        <div class="filter-content px-0" style="border-bottom: 1px solid darkgray;">
                            @foreach (var dataBrand in dataSourch?.ListDataBrand)
                            {
                                <label><input type="checkbox" checked=@dataBrand.Checked_Filter @onchange=@(x => changeFilter(null, dataBrand, x, null))> @dataBrand.Nama_Brand</label>
                            }
                        </div>
                    </div>
                    <div class="filter-accordion" style="border-bottom: 1px solid darkgray;">
                        <input type="checkbox" id="filter-category1" class="filter-toggle">
                        <label for="filter-category1" style="font-size: 23px;letter-spacing: -1.7px;" class="filter-label search-fil py-4 px-0">Kategori</label>
                        <div class="filter-content px-0" style="border-bottom: 1px solid darkgray;">
                            @foreach (var dataKategori in dataSourch?.ListDataKategori)
                            {
                                if (dataKategori.Nama_Kategori != "Men's" && dataKategori.Nama_Kategori != "Women's" && dataKategori.Nama_Kategori != "Kid's")
                                {
                                    <label>
                                        <input type="checkbox" checked=@dataKategori.Checked_Filter @onchange=@(x => changeFilter(dataKategori, null, x, null))>
                                        @dataKategori.Nama_Kategori
                                    </label>
                                }
                            }
                        </div>
                    </div>
                    <div class="filter-accordion" style="border-bottom: 1px solid darkgray;">
                        <input type="checkbox" id="filter-price1" class="filter-toggle">
                        <label for="filter-price1" style="font-size: 23px;letter-spacing: -1.7px;" class="filter-label search-fil py-4 px-0">Harga</label>
                        <div class="filter-content px-0" style="border-bottom: 1px solid darkgray;">
                            <label><input type="radio" name="price" value="0-500"> ≤ Rp 500.000</label>
                            <label><input type="radio" name="price" value="500-1000"> Rp 500.000–1.000.000</label>
                            <label><input type="radio" name="price" value="1000"> > Rp 1.000.000</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>