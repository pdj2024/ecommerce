@rendermode InteractiveServer
@page "/search-page"


<!-- Start Trending Product Area -->
<section class="trending-product section" style="margin-top: 70px;">
    <div class="container-fluid">
        <div class="row" style="justify-content: center; margin-bottom: 2rem;">
            <div class="col-12">
                <div class="section-title">
                    <h2>Search</h2>
                </div>
            </div>
            <div class="col-12 col-md-12 col-lg-6">
                <div class="input-group mb-3 style-grup">
                    <span class="input-group-text" id="basic-addon1" style="padding: 0px;"><i class="lni lni-search-2" style="font:normal normal normal 22px/1 'Lineicons';"></i></span>
                    <InputText @bind-Value=@SearchText @oninput="@(e => OnSearchInput(e.Value?.ToString()))" type="text" class="form-control search-form" placeholder="Search" aria-label="Search" aria-describedby="basic-addon1"/>
                    <button class="clear-search" @onclick="@(e => OnClearInput())" >Clear</button>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-3 d-none d-md-none d-lg-flex">
                <div class="filters">
                    <div class="filter-accordion">
                        <input type="checkbox" id="filter-genre" class="filter-toggle">
                        <label for="filter-genre" class="filter-label">Gender</label>
                        <div class="filter-content">
                            @foreach (var dataKategori in ListDataKategori)
                            {
                                if (dataKategori.Nama_Kategori == "Men's" || dataKategori.Nama_Kategori == "Women's" || dataKategori.Nama_Kategori == "Kid's")
                                {
                                    <label><input type="checkbox"> @dataKategori.Nama_Kategori</label>
                                }
                            }
                        </div>
                    </div>
                    <div class="filter-accordion">
                        <input type="checkbox" id="filter-brand" class="filter-toggle">
                        <label for="filter-brand" class="filter-label">Brand</label>
                        <div class="filter-content">
                            @foreach (var dataBrand in ListDataBrand)
                            {
                                <label><input type="checkbox"> @dataBrand.Nama_Brand</label>
                            }
                        </div>
                    </div>
                    <div class="filter-accordion">
                        <input type="checkbox" id="filter-category" class="filter-toggle">
                        <label for="filter-category" class="filter-label">Kategori</label>
                        <div class="filter-content">
                            @foreach (var dataKategori in ListDataKategori)
                            {
                                if (dataKategori.Nama_Kategori != "Men's" || dataKategori.Nama_Kategori != "Women's" || dataKategori.Nama_Kategori != "Kid's")
                                {
                                    <label><input type="checkbox"> @dataKategori.Nama_Kategori</label>
                                }
                            }
                        </div>
                    </div>
                    <div class="filter-accordion">
                        <input type="checkbox" id="filter-price" class="filter-toggle">
                        <label for="filter-price" class="filter-label">Harga</label>
                        <div class="filter-content">
                            <label><input type="radio" name="price" value="0-500"> ≤ Rp 500.000</label>
                            <label><input type="radio" name="price" value="500-1000"> Rp 500.000–1.000.000</label>
                            <label><input type="radio" name="price" value="1000"> > Rp 1.000.000</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-12 col-lg-9">
                <div class="row">
                    @foreach (var dataProduk in ListDataProduk) {
                        <div class="col-lg-3 col-md-4 col-6 pt-2 pb-2">
                            <!-- Start Single Product -->
                            <div class="single-product">
                                <div class="product-image">
                                    @if (dataProduk.MediaUrls.Count() >= 1)
                                    {
                                        <img src="@dataProduk.MediaUrls[0]?.Id_Media" alt="@dataProduk.Nama_Display">
                                    }
                                    else
                                    {
                                        <img src="https://placehold.co/600x600" alt="@dataProduk.Nama_Display">
                                    }
                                    @if (dataProduk.Diskon1 != null || dataProduk.Diskon1 >= 1) {
                                        <span class="sale-tag">-@dataProduk.Diskon1.ToString()%</span>
                                    }
                                    @if (dataProduk.Tgl_Created != null && (DateTime.Now - dataProduk.Tgl_Created).TotalDays <= 3)
                                    {
                                        <span class="new-tag">New</span>
                                    }
                                    <div class="button">
                                        <NavLink href="@($"/detail-produk/{dataProduk.No_Id}")" class="btn">Tambahkan <i class="lni lni-cart-1 ms-3"></i></NavLink>
                                    </div>
                                </div>
                                <div class="product-info">
                                    <span class="category">
                                        @foreach (var kategori in dataProduk.Nama_Kategori) 
                                        {
                                        @kategori
                                        }
                                    </span>
                                    <h4 class="title clamp-2">
                                        <NavLink href="@($"/detail-produk/{dataProduk.No_Id}")">
                                            @dataProduk.Nama_Display
                                        </NavLink>
                                    </h4>
                                    <div class="price">
                                        <span>@string.Format("Rp. {0:N2}", dataProduk.Harga)</span>
                                        @if (dataProduk.Diskon1 != null || dataProduk.Diskon1 >= 1)
                                        {
                                            <span class="discount-price">@string.Format("Rp. {0:N2}", ((dataProduk.Diskon1/100) * dataProduk.Harga))</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <!-- End Single Product -->
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- End Trending Product Area -->

