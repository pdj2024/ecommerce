@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@using PacificWeb.Components.Sections


@page "/cart-page/{pageTabs}"


@if(pageTabs == "keranjang"){
    <PageTitle>@ti.ToTitleCase(pageTabs)</PageTitle>
} else
{
    <PageTitle>Pesanan - @ti.ToTitleCase(pageTabs)</PageTitle>
}


<MyHeadProfile dataSourch=@dataSourch pageRoute=@pageTabs PesananLoad=@PesananLoad refreshLoad=@RefreshLoad @ref="header_page"/>

@if(pageTabs == "setting"){
    <div class="tab-content mb-5" id="pills-tabContent">
    
        <div class="tab-pane fade show active" id="pills-keranjang" role="tabpanel" aria-labelledby="pills-keranjang-tab">
            
            <div class="row" style="justify-content: center; margin-top: 7rem;">
                <div class="col-12">
                    <div class="section-title" style="margin-bottom:0px;">
                        <h2>Pengaturan</h2>
                    </div>
                </div>
            </div>

            @if (loadContent)
            {
                @for(var i = 0; i <= 3; i++)
                {
                    <div class="" style="padding: 0px 20px 20px 20px; margin-top:20px;">
                        <div class="card p-3 mb-5 border-0" style="border-radius:0px;" aria-busy="true">
                            <div class="skeleton skeleton-rect mb-3"></div>
                                <div class="d-flex align-items-center justify-content-between">
                                    <div style="flex:1">
                                        <div class="skeleton skeleton-title mb-2"></div>
                                        <div class="skeleton skeleton-subtitle mb-2" style="width:50%"></div>
                                </div>
                                <div class="ms-3">
                                    <div class="skeleton skeleton-pill"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            } 
            else
            {
                <div class="cart-page" style="padding: 0px 20px 5rem 20px; margin-top:20px;">

                    <div class="cart-container p-0 px-lg-5 mb-5">
                        <div class="cart-items">

                            <div class="d-flex flex-row gap-1 align-items-center" style="margin: 0px 0px 10px 15px;">
                                <h5 class="me-2" style="font-style:italic; color: #1500b2 !important; font-size:25px;">Profil</h5>
                                @if(readOnlyProfile) 
                                {
                                    <button @onclick=@(x => @editProfile(readOnlyProfile, "profil")) class="btn-slide p-1 border-0" style="width: fit-content; border-radius:100%;" >
                                    
                                            <svg xmlns="http://www.w3.org/2000/svg" height="22px" viewBox="0 -960 960 960" width="22px" fill="currentColor"><path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z"/></svg>
                                    
                                    </button>
                                } 
                                else 
                                {
                                    <button @onclick=@(x => @editProfile(readOnlyProfile, "save-profil")) class="btn-success bg-success p-1 border-0" style="width: fit-content; border-radius:100%; " >                                    
                                        <svg xmlns="http://www.w3.org/2000/svg" style="margin-top: -2px;" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor"><path d="M840-680v480q0 33-23.5 56.5T760-120H200q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h480l160 160Zm-80 34L646-760H200v560h560v-446ZM480-240q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35ZM240-560h360v-160H240v160Zm-40-86v446-560 114Z"/></svg>
                                    </button>

                                    <button @onclick=@(x => @editProfile(readOnlyProfile, "cancel")) class="btn-danger bg-danger p-1 border-0" style="width: fit-content; border-radius:100%;" >                                    
                                        <svg xmlns="http://www.w3.org/2000/svg" style="margin-top: -2px;" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg>
                                    </button>
                                }
                            </div>
                            
                            <div class="col-12">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3" style="@(readOnlyProfile! ? "background-color: #f9f9f9ba" : "")">
                                    <InputText disabled=@readOnlyProfile style="background-color:transparent !important; font-weight: 700; font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Username" aria-label="Search" aria-describedby="basic-addon1" @bind-value=@ScopedDataServices.ScopedData.DataLogin.DataUser.UserName />
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Username</label>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3" style="@(readOnlyProfile! ? "background-color: #f9f9f9ba" : "")">
                                    <InputText disabled=@readOnlyProfile style="background-color:transparent !important; font-weight: 700; font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Email" aria-label="Search" aria-describedby="basic-addon1" @bind-value=@ScopedDataServices.ScopedData.DataLogin.DataUser.Email />
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Email</label>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3" style="@(readOnlyProfile! ? "background-color: #f9f9f9ba" : "")">
                                    <InputText disabled=@readOnlyProfile style="background-color:transparent !important; font-weight: 700; font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Kota" aria-label="Search" aria-describedby="basic-addon1" @bind-value=@ScopedDataServices.ScopedData.DataLogin.DataUser.Kota />
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Kota</label>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3" style="@(readOnlyProfile! ? "background-color: #f9f9f9ba" : "")">
                                    <InputTextArea rows="2" disabled=@readOnlyProfile style="background-color:transparent !important; font-weight: 700;  font-size:15px;"  class="form-control search-form form-text" placeholder="Alamat" aria-label="Search" aria-describedby="basic-addon1" @bind-value=@ScopedDataServices.ScopedData.DataLogin.DataUser.Alamat />
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Alamat</label>
                                </div>
                            </div>

                            @if (updateProfil) {
                                <div class="toast show showing align-items-center mt-1 mb-3 mx-auto border-0 shadow-none" style="opacity : 1 !important;" role="alert" aria-live="assertive" aria-atomic="true">
                                    <div class="d-flex w-100">
                                        <div class="toast-body text-center w-100">
                                            <strong class="me-auto text-danger text-center">Gagal memperbarui profil pengguna</strong>
                                        </div>
                                    </div>
                                </div>
                            } 

                        </div>
                    </div>
                
                    <div class="cart-container p-0 px-lg-5">

                        <div class="cart-items">
                            
                            <div class="d-flex flex-row gap-3 align-items-center" style="margin: 0px 0px 10px 15px;">
                                <h5 style="font-style:italic; color: #1500b2 !important; font-size:25px;">Akun</h5>
                            </div>

                            <div class="col-12 d-flex align-items-center gap-4 pe-3 mb-3" style="background-color: #f9f9f9ba;">
                                <div class="input-group style-grup px-1 border-1 form-style position-relative pb-1 pt-3" style="@(readOnlyAkun! ? "background-color: #f9f9f9ba; border-color:transparent;" : "border-color:transparent;")">
                                    <input disabled=@readOnlyAkun style="background-color:transparent !important; font-weight: 700; font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Password" aria-label="Search" aria-describedby="basic-addon1" value="@ScopedDataServices?.ScopedData?.DataLogin?.DataUser?.Telepon" />
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Nomer Telepon</label>
                                </div>
                                <button @onclick="@(x => changeLogin("sign-up", true))" data-bs-toggle="modal" data-bs-target="#exampleModalChangeNumber"  class="btn-slide p-2 border-0" style="width: fit-content; border-radius:100%; z-index:5" >
                                    @if(readOnlyAkun) 
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z"/></svg>
                                    } 
                                    else 
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M840-680v480q0 33-23.5 56.5T760-120H200q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h480l160 160Zm-80 34L646-760H200v560h560v-446ZM480-240q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35ZM240-560h360v-160H240v160Zm-40-86v446-560 114Z"/></svg>
                                    }
                                </button>
                            </div>

                            

                            <div class="col-12 d-flex align-items-center gap-4 pe-3" style="background-color: #f9f9f9ba;">
                                <div class="input-group style-grup px-1 border-1 form-style position-relative pb-1 pt-3" style="@(readOnlyAkun! ? "background-color: #f9f9f9ba; border-color:transparent;" : "border-color:transparent;")">
                                    <input disabled=@readOnlyAkun style="background-color:transparent !important; font-weight: 700; font-size:15px;" type="password" class="form-control search-form form-text" placeholder="Password" aria-label="Search" aria-describedby="basic-addon1" value="@ScopedDataServices?.ScopedData?.DataLogin?.DataUser?.Password" />
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Password</label>
                                </div>
                                <button @onclick="@(x => changeLogin("log-in", true))" data-bs-toggle="modal" data-bs-target="#exampleModalChangeNumber" class="btn-slide p-2 border-0" style="width: fit-content; border-radius:100%; z-index:5" >
                                    @if(readOnlyAkun) 
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z"/></svg>
                                    } 
                                    else 
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M840-680v480q0 33-23.5 56.5T760-120H200q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h480l160 160Zm-80 34L646-760H200v560h560v-446ZM480-240q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35ZM240-560h360v-160H240v160Zm-40-86v446-560 114Z"/></svg>
                                    }
                                </button>
                            </div>

                        </div>
                    </div>
                
                </div>
            }

        </div>
    </div>
} 
else
{
    <div class="tab-content mb-5" id="pills-tabContent">
    
        <div class="tab-pane fade @(pageTabs == "keranjang" ? "show active" : "")" id="pills-keranjang" role="tabpanel" aria-labelledby="pills-keranjang-tab">
            <div class="row" style="justify-content: center; margin-top: 6rem;">
                <div class="col-12">
                    <div class="section-title" style="margin-bottom:0px;">
                    </div>
                </div>
            </div>
            <div class="row position-relative" style="justify-content: center; margin-top: 0rem;">
                <div class="col-12 position-absolute" style="top:16px">
                    <div class="section-title" style="margin-bottom:0px;">
                        <h2>Keranjang</h2>
                    </div>
                </div>
            </div>
            <div class="cart-page" style="padding: 0px 20px 5rem 20px; margin-top:20px;">
                <div class="cart-container d-flex flex-xl-row flex-column">

                    <div class="cart-items col-12 col-xl-8">
                    
                        <div class="py-5"></div>
                        <!-- Contoh looping item -->
                        <div class="cart-item d-none d-lg-flex" style="padding: 0px 16px;">
                            <div class="img-harga" style="width:5%">
                                <p class="item-price"></p>
                            </div>
                            <div class="img-item" style="width:45%">
                                <p class="item-price">Produk</p>
                            </div>
                            <div class="img-nama" style="width:20%">
                                <p class="item-price">Harga</p>
                            </div>
                            <div class="img-qty" style="width:25%">
                                <p class="item-price">Qty</p>
                            </div>
                            <div class="img-harga" style="width:5%">
                                <p class="item-price"></p>
                            </div>
                        </div>

                        @if (loadContent)
                        {
                            @for(var i = 0; i <= 5; i++)
                            {
                                <div class="" style="padding: 0px 20px 20px 20px; margin-top:20px;">
                                    <div class="card p-3 mb-5 border-0" style="border-radius:0px;" aria-busy="true">
                                        <div class="skeleton skeleton-rect mb-3"></div>
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div style="flex:1">
                                                <div class="skeleton skeleton-title mb-2"></div>
                                                <div class="skeleton skeleton-subtitle mb-2" style="width:50%"></div>
                                            </div>
                                            <div class="ms-3">
                                                <div class="skeleton skeleton-pill"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        } else
                        {
                            @foreach (var item in ScopedDataServices?.ScopedData?.ListDataCart)
                            {
                                <div class="cart-item d-none d-lg-flex border-bottom-0 pb-0" style="@(item.Qty < item.Min_Order || item.Qty > item.Stock ? "background-color:whitesmoke" : "background-color:white")">
                                    <div class="img-harga d-flex align-items-center gap-3" style="width:5%">
                                        <label class="custom-checkbox d-flex">
                                            <input type="checkbox" checked="@item.SelectCart" @onchange="(e) => SelectItemCart(item)">
                                            <span></span>
                                        </label>
                                    </div>
                                
                                    <div class="img-item" style="width:45%">
                                        @if(item.Id_Media != null && item.Id_Media != "")
                                        {
                                            <img class="cart-img" src="@item.Id_Media" style="min-width:80px; max-width:80px; height: 80px; margin-right:0px;" alt="#">
                                        } else
                                        {
                                            <img class="cart-img" src="/images/products/placeholder1.png" style="min-width:80px; max-width:80px; height: 80px; margin-right:0px;" alt="#">
                                        }
                                        <div class="item-produk d-flex flex-column justify-content-center gap-2">
                                            <h2 class="item-name">@item.Nama_Display</h2>
                                            <p class="variant fst-italic" style="background-color: #eee;width: fit-content;padding: 1px 5px;border-radius: 0px;">
                                                @($"{item.Option_Label}, {item.Size_Label}")
                                            </p>
                                        </div>
                                    </div>
                                    <div class="img-nama" style="width:20%">
                                        <h2 class="item-name">@string.Format("Rp {0:N0}", (item?.Harga - (item?.Harga * (item?.Diskon1 / 100))))</h2>
                                    </div>
                                    <div class="img-qty" style="width:25%">
                                        <div class="item-qty">
                                            <button style="@(item.Show_Min_Order || item.Qty <= item.Min_Order ? "cursor:not-allowed" : "")" disabled=@(item.Show_Min_Order || item.Qty <= item.Min_Order) @onclick="() => Decrease(item.Id_Cart)">–</button>
                                            <span>@item.Qty</span>
                                            <button style="@(item.Show_Max_Order || item.Qty >= item.Stock ? "cursor:not-allowed" : "")" disabled=@(item.Show_Max_Order || item.Qty >= item.Stock) @onclick="() => Increase(item.Id_Cart)">+</button>
                                        </div>
                                    </div>
                                    <div class="img-harga d-flex align-items-center gap-3" style="width:5%">
                                        <a @onclick=@(() => deleteItemCart(item)) class="hapus-card-item" style="cursor:pointer;" title="Remove this item">
                                            @if (loadProses)
                                            {
                                                <div class="spinner-border spinner-border-sm" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span>
                                                    <svg xmlns="http://www.w3.org/2000/svg" height="30px" viewBox="0 -960 960 960" width="30px" fill="currentColor">
                                                        <path d="M312-144q-29.7 0-50.85-21.15Q240-186.3 240-216v-480h-48v-72h192v-48h192v48h192v72h-48v479.57Q720-186 698.85-165T648-144H312Zm336-552H312v480h336v-480ZM384-288h72v-336h-72v336Zm120 0h72v-336h-72v336ZM312-696v480-480Z"/>
                                                    </svg>
                                                </span>
                                            }
                                        </a>
                                    </div>
                                
                                </div>
                                <div class="w-100 d-none d-lg-flex ps-5 pt-3 " style="border-bottom: 1px solid #e5e7eb; @(item.Qty < item.Min_Order || item.Qty > item.Stock ? "background-color:whitesmoke" : "background-color:white")">
                                    @if (item.Show_Min_Order || item.Qty < item.Min_Order)
                                    {
                                        <span class="text-danger pb-2" style="font-size: 13px; font-weight: 700;">
                                            *Minimal order @item?.Min_Order item
                                        </span>
                                    }

                                    @if (item.Show_Max_Order || item.Qty > item.Stock)
                                    {
                                        <span class="text-danger pb-2" style="font-size: 13px; font-weight: 700;">
                                            *Maximal order @item?.Stock item
                                        </span>
                                    }

                                    @if (item.Show_Add_Product)
                                    {
                                        <span class="text-danger pb-2" style="font-size: 13px; font-weight: 700;">
                                            *Produk gagal ditambahkan
                                        </span>
                                    }

                                </div>
                            }
                    
                    
                            <div class="cart-item d-flex d-lg-none flex-column" style="padding: 0px 0px;">
                                <ul class="shopping-list w-100 pe-0 gap-0" style="overflow:unset; max-height: unset">

                                    @if(ScopedDataServices?.ScopedData?.ListDataCart.Count() >= 0)
                                    {
                                        <li class="flex-wrap pb-3 px-3" style="background-color:white; gap: 10px;align-items: center;justify-content: flex-start;">
                                            <label class="custom-checkbox d-flex">
                                                <input type="checkbox" checked=@checkAll @onchange=@( e => checkAllItem(e) ) >
                                                <span></span>
                                            </label>
                                            <h5 style="font-size: 14px">Pilih Semua</h5>
                                        </li>
                                    }


                                    @foreach (var cart in ScopedDataServices?.ScopedData?.ListDataCart)
                                    {
                                        <li class="flex-wrap py-3 px-3" style=@(cart.Qty < cart.Min_Order || cart.Qty > cart.Stock ? "background-color:whitesmoke" : "background-color:white")>
                                            <div class="cart-img-head d-flex flex-row gap-3" >
                                                @if(cart.Id_Media != null && cart.Id_Media != "")
                                                {
                                                    <img class="cart-img" src="@cart.Id_Media" style="min-width:80px; max-width:80px; height: 80px; margin-right:0px;" alt="#">
                                                } else
                                                {
                                                    <img class="cart-img" src="/images/products/placeholder1.png" style="min-width:80px; max-width:80px; height: 80px; margin-right:0px;" alt="#">
                                                }
                                                <div class="d-flex flex-column justify-content-center h-100" style="gap:5px;">
                                                    <h4>
                                                        <a href="javascript:void(0)" class="line-clamp-1" style="font-size:15px">
                                                            @(cart.Nama_Display)
                                                        </a>
                                                    </h4>
                                                    <p class="variant fst-italic" style="background-color: #eee;width: fit-content;padding: 1px 5px;border-radius: 0px;">
                                                        @($"{cart.Option_Label}, {cart.Size_Label}")
                                                    </p>
                                                    <p class="quantity">
                                                        <span class="amount" style="font-size:16px; font-weight:600;">@string.Format("Rp. {0:N0}", (cart?.Harga - (cart?.Harga * (cart?.Diskon1 / 100))))</span>
                                                    </p>
                                                </div>
                                            </div>

                                            <div class="content content-qty">
                                                <div style="display: flex;justify-content:space-between;flex-direction: row-reverse;width:80%;">
                                                    <a @onclick=@(() => deleteItemCart(cart)) class="hapus-card-item" style="cursor:pointer;" title="Remove this item">
                                                        @if (loadProses)
                                                        {
                                                            <div class="spinner-border spinner-border-sm" role="status">
                                                                <span class="visually-hidden">Loading...</span>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span>
                                                                <svg xmlns="http://www.w3.org/2000/svg" height="25px" viewBox="0 -960 960 960" width="25px" fill="currentColor">
                                                                    <path d="M312-144q-29.7 0-50.85-21.15Q240-186.3 240-216v-480h-48v-72h192v-48h192v48h192v72h-48v479.57Q720-186 698.85-165T648-144H312Zm336-552H312v480h336v-480ZM384-288h72v-336h-72v336Zm120 0h72v-336h-72v336ZM312-696v480-480Z" />
                                                                </svg>
                                                            </span>
                                                        }
                                                    </a>
                                                    <label class="custom-checkbox">
                                                        <input type="checkbox" checked="@cart.SelectCart" @onchange="(e) => SelectItemCart(cart)">
                                                        <span></span>
                                                    </label>
                                                </div>
                                                <div class="qty-box" style="width: 80%;height: 34px;padding: 21px 5px;gap: 8px;">
                                                    <button disabled=@(cart.Show_Min_Order || cart.Qty <= cart.Min_Order) style="font-size: 15px; @(cart.Show_Min_Order || cart.Qty <= cart.Min_Order ? "cursor:not-allowed" : "") " @onclick="() => Decrease(cart.Id_Cart)">–</button>
