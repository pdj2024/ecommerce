@rendermode InteractiveServer
@inject IJSRuntime JS

<div class="row m-0 px-3 pt-3">
    <div class="col-12 col-lg-6">
        <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
            <input style="background-color:transparent !important; font-weight: 700; font-size:15px;" type="text" class="form-control search-form form-text" placeholder="" aria-label="Search" aria-describedby="basic-addon1" required />
            <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Nama Penerima <span class="text-danger">*</span></label>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
            <input style="background-color:transparent !important; font-weight: 700; font-size:15px;" type="text" class="form-control search-form form-text" placeholder="" aria-label="Search" aria-describedby="basic-addon1" required />
            <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Telpon Penerima <span class="text-danger">*</span></label>
        </div>
    </div>
    <div class="col-12 mb-3">
        <button class="btn btn-primary w-100" @onclick=@( x => openMaps() ) >📍 Pilih dari Maps</button>
    </div>
    <div id="map-wrapper" class="col-12 flex-column gap-3 mb-3" style="display:none">
        <div class="input-group style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
            <input style="background-color:transparent !important; font-weight: 700; font-size:15px;" id="autocomplete" type="text" class="form-control search-form form-text" placeholder="Ketik nama jalan / lokasi" aria-label="Search" aria-describedby="basic-addon1" />
            <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Cari Alamat <span class="text-danger"></span></label>
        </div>

        <div id="map" class="w-100" style="height:400px;border-radius: 8px;"></div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
            <input style="background-color:transparent !important; font-weight: 700; font-size:15px;" id="province" type="text" class="form-control search-form form-text" placeholder="" aria-label="Search" aria-describedby="basic-addon1" @onclick=openSelectAlamat required />
            <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Provinsi <span class="text-danger"></span></label>
        </div>
    </div>

    <button style="opacity: 0;position: absolute;width: 0;height: 0;padding: 0;" id="staticAlamat2" type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#staticAlamat" />

    <div class="col-12 col-lg-6">
        <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
            <input style="background-color:transparent !important; font-weight: 700; font-size:15px;" id="city" type="text" class="form-control search-form form-text" placeholder="" aria-label="Search" aria-describedby="basic-addon1" required />
            <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Kota / Kabupaten <span class="text-danger"></span></label>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
            <input style="background-color:transparent !important; font-weight: 700; font-size:15px;" id="district" type="text" class="form-control search-form form-text" placeholder="" aria-label="Search" aria-describedby="basic-addon1" required />
            <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Kecamatan <span class="text-danger"></span></label>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
            <input style="background-color:transparent !important; font-weight: 700; font-size:15px;" id="postcode" type="text" class="form-control search-form form-text" placeholder="" aria-label="Search" aria-describedby="basic-addon1" required />
            <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Kode Pos <span class="text-danger"></span></label>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
            <input style="background-color:transparent !important; font-weight: 700; font-size:15px;" id="lat" type="text" class="form-control search-form form-text" placeholder="" aria-label="Search" aria-describedby="basic-addon1" required />
            <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Latitude <span class="text-danger"></span></label>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
            <input style="background-color:transparent !important; font-weight: 700; font-size:15px;" id="lng" type="text" class="form-control search-form form-text" placeholder="" aria-label="Search" aria-describedby="basic-addon1" required />
            <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Longitude <span class="text-danger"></span></label>
        </div>
    </div>
    <div class="col-12">
        <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
            <textarea rows="2" style="background-color:transparent !important; font-weight: 700;  font-size:15px;" class="form-control search-form form-text" placeholder="" aria-label="Search" aria-describedby="basic-addon1" required />
            <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Detail Lainnya (Blok / Unit No., Patokan) <span class="text-danger"></span></label>
        </div>
    </div>
</div>


<div class="modal fade review-modal" id="staticAlamat" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel">
    <div class="modal-dialog modal-dialog-centered" style="max-width:600px;">
        <div class="modal-content" style="border-radius: 0px;">
            <div class="modal-header justify-content-between d-flex border-bottom-0 pb-0">
                <h5 class="modal-title w-100 text-center" id="exampleModalLabel" style="letter-spacing: -1px; font-size: 22px;font-weight: 400;">Konfirmasi Pesanan</h5>
            </div>

                <div class="modal-body">
                    <div class="row m-0">

                        <div class="col-12">
                            <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                <select style="background-color:transparent !important; font-weight: 700; font-size:15px;" class="form-control search-form form-text"  @onchange="OnProvinsi">
                                    @foreach (var p in Provinsi)
                                    {
                                        <option value="@p.id">@p.value</option>
                                    }
                                </select>
                            <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Pilih Provinsi</label>
                            </div>
                        </div>
                        

                        <div class="col-12">
                            <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                            <select style="background-color:transparent !important; font-weight: 700; font-size:15px;" class="form-control search-form form-text" @onchange="OnKota">
                                    @foreach (var p in Kota)
                                    {
                                        <option value="@p.id">@p.value</option>
                                    }
                                </select>
                            <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Pilih Kota / Kabupaten</label>
                            </div>
                        </div>
                        

                        <div class="col-12">
                            <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                <select style="background-color:transparent !important; font-weight: 700; font-size:15px;" class="form-control search-form form-text" @onchange="OnKecamatan">
                                @foreach (var p in Kecamatan)
                                    {
                                        <option value="@p.id">@p.value</option>
                                    }
                                </select>
                            <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Pilih Kecamatan</label>
                            </div>
                        </div>
                        

                        <div class="col-12">
                            <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                <select style="background-color:transparent !important; font-weight: 700; font-size:15px;" class="form-control search-form form-text" @onchange="OnKodePos">
                                    @foreach (var p in KodePos)
                                    {
                                        <option value="@p.postal_code">@p.postal_code</option>
                                    }
                                </select>
                                <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Kode Pos</label>
                            </div>
                        </div>
                        
                        
                    </div>
                </div>

                <div class="modal-footer justify-content-center button border-top-0 pt-2 px-5">
                    <button type="button" class="btn btn-danger bg-danger border-0" data-bs-dismiss="modal">Batal</button>
                    <button type="button" class="btn btn-success bg-success border-0">
                        Simpan
                    </button>
                </div>

            }

        </div>
    </div>
</div>