                                                    <div class="d-flex flex-row justify-content-between gap-3 py-1 ">

                                                        <button class="bg-transparent border-0" @onclick=@(x => JSRuntime.InvokeVoidAsync("history.back")) style="font-size:15px; cursor:pointer; color:#1500b2; font-weight:600">
                                                            <span class="me-1" style="font-size:18px">
                                                                @("<")
                                                            </span>
                                                            @("KEMBALI")
                                                        </button>

                                                        <div class="d-flex flex-row justify-content-between align-items-center gap-3">
                                                            <h5 style="font-size:1rem">
                                                                @($"Order ID : {item.No_Tracking}")
                                                            </h5>
                                                            <h5 class="mx-2" style="font-size:0.7rem">
                                                                |
                                                            </h5>
                                                            <p style="color:#1500b2">
                                                                @( item != null ? item.Status_Order_1?.ToUpper() ?? "DIBATALKAN" : "DIBATALKAN")
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </h2>

