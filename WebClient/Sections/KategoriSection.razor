<!-- Start Banner Area -->
<section class="banner section px-0 px-lg-3 px-xl-5 px-xxl-10 kate-shimer" style="display:none">
    <div class="container-fluid">
        <div class="row">
            @for (var i = 0; i <= 2; i++)
            {
                <div class="col-lg-4 col-md-4 col-12">
                    <div class="card py-3 px-0 border-0" style="border-radius:0px;" aria-busy="true">
                        <div class="skeleton skeleton-rect mb-3" style="border-radius:0px;height:100dvh"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="banner section px-0 px-lg-3 px-xl-5 px-xxl-10 kate-content" style="display:flex">
    <div class="container-fluid d-none d-md-block">
        <div class="row">
            @foreach (var kategori in @GlobalDataService.GlobalData.DataHomepage.Categories.Where(x => x.Muncul_Section_Kategori == true).ToList())
            {
                <div class="col-lg-4 col-md-4 col-12" style="margin-bottom: 20px;">
                    <div class="single-banner">
                        <div @onclick=@(x => searchCombo(null, null, kategori)) class="content" style="overflow: hidden; height:40vw;cursor:pointer;">
                            <Image Style="" Src="@(kategori?.Id_Media != null && kategori?.Id_Media != "" ? kategori?.Id_Media : "/images/products/placeholder1.png")" Class="image-content" />
                            <div class="content-single">
                                <div class="button">
                                    <button @onclick=@(x => searchCombo(null, null, kategori)) class="btn content-btn">Katalog @kategori.Nama_Kategori</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="container-fluid d-block d-md-none">
        <div class="row">
            @foreach (var kategori in @GlobalDataService.GlobalData.DataHomepage.Categories.Where(x => x.Muncul_Section_Kategori == true).ToList())
            {
                <div class="col-lg-4 col-md-4 col-12" style="margin-bottom: 20px;">
                    <div class="single-banner">
                        <div @onclick=@(x => searchCombo(null, null, kategori)) class="content" style="overflow: hidden; height:60vw;cursor:pointer;">
                            <Image Style="" Src="@(kategori?.Id_Media != null && kategori?.Id_Media != "" ? kategori?.Id_Media : "/images/products/placeholder1.png")" Class="image-content" />
                            <div class="content-single">
                                <div class="button">
                                    <button @onclick=@(x => searchCombo(null, null, kategori)) class="btn content-btn">Katalog @kategori.Nama_Kategori</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
