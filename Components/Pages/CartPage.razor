        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                @foreach(var Head in Pesanan_Create.Header)
                {
                    <div class="modal-body" style="padding: 2rem 2rem 1rem 2rem; gap: 10px; display: flex; flex-direction: column;">

                        <div style="display:flex; flex-direction:row;">
                            <div style="display:flex; flex-direction:column; gap:5px; width:50%;">
