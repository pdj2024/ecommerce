@rendermode InteractiveServer
@page "/detail-produk/{id}"


<MyHeader dataSourch=@dataSourch @ref="header_page" />

<!-- Start Breadcrumbs -->
<div class="breadcrumbs padding-style py-0 px-0 px-lg-3 px-xl-5 px-xxl-10" style="margin-top: 70px;">

</div>
<!-- End Breadcrumbs -->

<!-- Start Item Details -->
<section class="item-details section py-0 px-0 px-lg-3 px-xl-2 px-xxl-10">
    <div class="container-fluid px-0 px-lg-4">
        <div class="top-area py-0 d-flex flex-column flex-lg-column justify-content-center align-items-center flex-xl-row">
            
            @if (loadContent)
            {
                <div class="row w-100" style="margin-top:-3rem;">
                    <div class="col-lg-6 col-md-12 col-12 pe-lg-4 pe-0" style="">
                        <div class="position-sticky top-0 ps-0 ps-lg-4">
                        
                            <div class="col-12 py-xl-2">
                            </div>

                            <div class="breadcrumbs p-0 py-4" style="">
                                <div class="container-fluid px-2">
                                    <div class="row align-items-center">
                                        <div class="col-12 px-0 pb-2">
                                            <ul class="breadcrumb-nav">
                                                <li><div class="skeleton skeleton-subtitle mb-2" style="width:50%"></div></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div style="--swiper-navigation-color: #fff; --swiper-pagination-color: #fff" class="swiper mySwiper2">
                                <div class="row">
                                    <div class="w-100 col-12">
                                        <div class="skeleton skeleton-rect mb-3" style="border-radius:0px;height:30rem;width:100%;"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12 d-flex">
                                    <div class="col-3">
                                        <div class="skeleton skeleton-rect mb-3" style="border-radius:0px;height:10rem;width:100%;"></div>
                                    </div>
                                    <div class="col-3">
                                        <div class="skeleton skeleton-rect mb-3" style="border-radius:0px;height:10rem;width:100%;"></div>
                                    </div>
                                    <div class="col-3">
                                        <div class="skeleton skeleton-rect mb-3" style="border-radius:0px;height:10rem;width:100%;"></div>
                                    </div>
                                    <div class="col-3">
                                        <div class="skeleton skeleton-rect mb-3" style="border-radius:0px;height:10rem;width:100%;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12 col-12 ps-lg-4 px-0">
                        <div class="product-info position-sticky top-0" style="">
                            <div class="col-12 py-xl-4 py-2">
                            </div>
                            <div class="col-12 py-xl-4 py-0">
                            </div>

                            <div>
                                <form aria-busy="true" class="mb-5">
                                    <div class="mb-3">
                                        <div class="skeleton" style="height:38px;width:40%;border-radius:.375rem"></div>
                                    </div>
                                    <div class="mb-3">
                                        <div class="skeleton skeleton-subtitle mb-2" style="width:25%"></div>
                                        <div class="skeleton skeleton-subtitle mb-2" style="width:20%"></div>
                                        <div class="skeleton" style="height:38px;width:70%;border-radius:.375rem"></div>
                                    </div>
                                </form>
                                <form aria-busy="true" class="mb-5">
                                    <div class="mb-3">
                                        <div class="skeleton skeleton-subtitle mb-2" style="width:100%"></div>
                                        <div class="skeleton skeleton-subtitle mb-2" style="width:100%"></div>
                                        <div class="skeleton skeleton-subtitle mb-2" style="width:100%"></div>
                                        <div class="skeleton skeleton-subtitle mb-2" style="width:100%"></div>
                                    </div>
                                    <div class="mb-3">
                                        <div class="skeleton skeleton-subtitle mb-2" style="width:100%"></div>
                                        <div class="skeleton" style="width:20%;height:38px;border-radius:.375rem"></div>
                                        <div class="skeleton" style="width:20%;height:38px;border-radius:.375rem"></div>
                                        <div class="skeleton" style="width:20%;height:38px;border-radius:.375rem"></div>
                                        <div class="skeleton" style="width:20%;height:38px;border-radius:.375rem"></div>
                                        <div class="skeleton" style="width:20%;height:38px;border-radius:.375rem"></div>
                                        <div class="skeleton" style="width:20%;height:38px;border-radius:.375rem"></div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <div class="skeleton" style="width:100%;height:38px;border-radius:.375rem"></div>
                                        <div class="skeleton" style="width:100%;height:38px;border-radius:.375rem"></div>
                                    </div>
                                    <div class="d-flex gap-2 mt-2">
                                        <div class="skeleton" style="width:120px;height:38px;border-radius:.375rem"></div>
                                        <div class="skeleton" style="width:80px;height:38px;border-radius:.375rem"></div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="row w-100">
                    @if(dataSourch?.DataProduk != null ) {
                        <div class="col-lg-6 col-md-12 col-12 pe-lg-4 pe-0" style="">
                            <div class="position-sticky top-0 ps-0 ps-lg-4">
                        
                                <div class="col-12 py-xl-2">
                                </div>

                                <div class="breadcrumbs p-0 py-4" style="">
                                    <div class="container-fluid px-2">
                                        <div class="row align-items-center">
                                            <div class="col-12 px-0 pb-2">
                                                <ul class="breadcrumb-nav">
                                                    <li><a href="index.html">Home</a></li>
                                                    <li><a href="index.html">@dataSourch?.DataProduk?.Nama_Display</a></li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div style="--swiper-navigation-color: #fff; --swiper-pagination-color: #fff" class="swiper mySwiper2">
                                    <div class="swiper-wrapper">
                                        @foreach (var img in dataSourch?.DataProduk?.MediaUrls)
                                        {
                                            <div class="swiper-slide">
                                                <Image Src="@img.Id_Media" Class="vw-100 h-100" />
                                            </div>
                                        }
                                    </div>
                                    <div class="swiper-button-next"></div>
                                    <div class="swiper-button-prev"></div>
                                </div>

                                <div thumbsSlider="" class="swiper mySwiper">
                                    <div class="swiper-wrapper">
                                        @foreach (var img in dataSourch?.DataProduk?.MediaUrls)
                                        {
                                            <div class="swiper-slide">
                                                <Image Src="@img.Id_Media" Class="vw-100 h-100" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6 col-md-12 col-12 ps-lg-4 px-0">


                            <div class="product-info position-sticky top-0" style="">
                                <div class="col-12 py-xl-4 py-2">
                                </div>
                                <div class="col-12 py-xl-4 py-0">
                                </div>

                                <div>
                                    @if (dataSourch?.DataProduk?.Diskon1 != null || dataSourch?.DataProduk?.Diskon1 >= 1)
                                    {
                                        <span class="badge bg-primary" style="padding: 8px 14px;font-size: 15px;display: flex;width: fit-content;align-items: center;gap: 8px;margin-bottom: 10px;font-weight: 700;border-radius: 0px;">
                                            Potongan @string.Format("Rp. {0:N0}", ((dataSourch?.DataProduk?.Diskon1 / 100) * dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Harga))
                                        </span>
                                    }
                                    <h2 class="title">@dataSourch?.DataProduk?.Nama_Display</h2>
                                    <p class="category" style="display: flex;align-items: center;">
                                        <svg xmlns="http://www.w3.org/2000/svg" style="width: 14px;transform: scaleX(-1);margin-right: 6px;" viewBox="0 0 640 640">
                                            <path d="M96.5 160L96.5 309.5C96.5 326.5 103.2 342.8 115.2 354.8L307.2 546.8C332.2 571.8 372.7 571.8 397.7 546.8L547.2 397.3C572.2 372.3 572.2 331.8 547.2 306.8L355.2 114.8C343.2 102.7 327 96 310 96L160.5 96C125.2 96 96.5 124.7 96.5 160zM208.5 176C226.2 176 240.5 190.3 240.5 208C240.5 225.7 226.2 240 208.5 240C190.8 240 176.5 225.7 176.5 208C176.5 190.3 190.8 176 208.5 176z" />
                                        </svg>
                                        Kategori:
                                        @foreach (var kategori in dataSourch?.DataProduk?.Nama_Kategori)
                                        {
                                            <a href="javascript:void(0)">
                                                @kategori
                                            </a>
                                        }
                                    </p>
                                    <h3 class="price d-flex align-items-center">
                                        @if (dataSourch?.DataProduk?.Diskon1 != null || dataSourch?.DataProduk?.Diskon1 >= 1)
                                        {
                                            @string.Format("Rp. {0:N0}", (dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Harga - ((dataSourch?.DataProduk?.Diskon1 / 100) * dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Harga)))
                                        }
                                        else
                                        {
                                            @string.Format("Rp. {0:N0}", dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Harga)
                                        }
                                        @if (dataSourch?.DataProduk?.Diskon1 != null || dataSourch?.DataProduk?.Diskon1 >= 1) 
                                        {
                                            <span style="font-size:1.3rem" class="">@string.Format("Rp. {0:N0}", dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Harga)</span>
                                        }
                                    </h3>
                                    <p class="info-text">
                                        @dataSourch?.DataProduk?.Deskripsi
                                    </p>
                                </div>

                                <div class="pt-3">
                                    <div class="row" style="margin-bottom:20px;">
                                        <h5 class="tag-variasi" style="font-weight:400;"><span style="font-weight:800">Opsi:</span> @dataSourch?.DataProduk?.Option_Default</h5>
                                        <div class="size-options d-flex flex-row flex-wrap" style="gap: 10px;">
                                            @foreach (var Option in dataSourch?.DataProduk?.Options)
                                            {
                                                <label style="gap: 15px; width:fit-content; justify-content:start;" class="size-box pe-3 @(dataSourch?.DataProduk?.Id_Option_Default == Option.Option_Id ? "active" : "")">
                                                    <Image Style="width:50px; height:50px;" Src="@Option.MediaUrl?.Id_Media" />
                                                    <input 
                                                        type="radio" 
                                                        name="variant" 
                                                        value="@Option.Option_Id" 
                                                        disabled="@(dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == Option.Option_Id && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Stock >= dataSourch?.DataProduk?.Min_Order ? false : true)" 
                                                        checked="@(dataSourch?.DataProduk?.Id_Option_Default == Option.Option_Id)"
                                                        @onchange="() => OnVariantChanged(Option.Option_Id)" 
                                                    />
                                                    <span style="width: fit-content;overflow: hidden;text-overflow: ellipsis; text-align:center; z-index:1; position:relative;">@Option.Option_Label</span>
                                                </label>
                                            }
                                        </div>
                                    </div>

                                    <div class="row">
                                        <h5 class="tag-variasi" style="font-weight:400;"><span style="font-weight:800">Size:</span> @dataSourch?.DataProduk?.Size_Default</h5>
                                        <div class="size-options d-flex flex-row flex-wrap" style="gap: 10px;">
                                            @foreach (var size in dataSourch?.DataProduk?.Sizes)
                                            {
                                                <label class="size-box @(dataSourch?.DataProduk?.Id_Size_Default == size.Size_Id ? "active" : "")">
                                                    <input 
                                                        type="radio" 
                                                        name="size" 
                                                        value="@size.Size_Id"
                                                        disabled="@(dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == size.Size_Id)?.Stock >= dataSourch?.DataProduk?.Min_Order ? false : true)"
                                                        checked="@(dataSourch?.DataProduk?.Id_Size_Default == size.Size_Id)"
                                                        @onchange="() => OnSizeChanged(size.Size_Id)" 
                                                />
                                                    <span style="z-index:1; position:relative;">@size.Size_Label</span>
                                                </label>
                                            }
                                        </div>
                                    </div>

                                    @if (dataSourch?.DataProduk?.Id_Option_Default != "" && dataSourch?.DataProduk?.Id_Size_Default != "")
                                    {
                                        if (dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default) != null)
                                        {
                                            <div class="row mt-4">

                                                @if(dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Stock <= 5) {
                                                    <div class="col-12">
                                                        <div style="position:relative" class="d-flex flex-column justify-content-center">
                                                            <div class="spinner-grow spinner-grow-sm text-warning position-absolute top-2 left-0" style="animation: .85s linear infinite spinner-grow;" role="status">
                                                                <span class="visually-hidden">Loading...</span>
                                                            </div>

                                                            <div class="spinner-grow spinner-grow-sm text-warning position-absolute top-2 left-0" role="status">
                                                                <span class="visually-hidden">Loading...</span>
                                                            </div>

                                                            <div class="spinner-grow spinner-grow-sm text-warning position-absolute top-2 left-0" style="animation: .65s linear infinite spinner-grow;" role="status">
                                                                <span class="visually-hidden">Loading...</span>
                                                            </div>
                                                            <p class="ms-4 text-warning">Cepat, hanya tersisa @( dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Stock.ToString()) barang dalam stok.
                                                                
                                                                @if(dataSourch.DataProduk.Show_Min_Order)
                                                                {
                                                                    <span class="ms-3 text-danger" style="font-size: 13px; font-weight: 700;" >
                                                                        *Minimal order @dataSourch?.DataProduk?.Min_Order item
                                                                    </span>
                                                                }

                                                                @if(dataSourch.DataProduk.Show_Max_Order)
                                                                {
                                                                    <span class="ms-3 text-danger" style="font-size: 13px; font-weight: 700;" >
                                                                        *Maximal order @dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default).Stock item
                                                                    </span>
                                                                }
                                                            </p>
                                                        </div>
                                                    </div>
                                                } else {
                                                    <div class="col-12">
                                                        <div style="position:relative" class="d-flex flex-column justify-content-center">
                                                            <div class="spinner-grow spinner-grow-sm text-primary position-absolute top-2 left-0" style="animation: .85s linear infinite spinner-grow;" role="status">
                                                                <span class="visually-hidden">Loading...</span>
                                                            </div>

                                                            <div class="spinner-grow spinner-grow-sm text-primary position-absolute top-2 left-0" role="status">
                                                                <span class="visually-hidden">Loading...</span>
                                                            </div>

                                                            <div class="spinner-grow spinner-grow-sm text-primary position-absolute top-2 left-0" style="animation: .65s linear infinite spinner-grow;" role="status">
                                                                <span class="visually-hidden">Loading...</span>
                                                            </div>
                                                            <p class="ms-4 text-primary">Tersisa @( dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Stock.ToString()) stok
                                                                
                                                                @if(dataSourch.DataProduk.Show_Min_Order)
                                                                {
                                                                    <span class="ms-3 text-danger" style="font-size: 13px; font-weight: 700;" >
                                                                        *Minimal order @dataSourch?.DataProduk?.Min_Order item
                                                                    </span>
                                                                }

                                                                @if(dataSourch.DataProduk.Show_Max_Order)
                                                                {
                                                                    <span class="ms-3 text-danger" style="font-size: 13px; font-weight: 700;" >
                                                                        *Maximal order @dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default).Stock item
                                                                    </span>
                                                                }
                                                            </p>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        } else
                                        {
                                            <p class="text-danger">
                                                Stock tidak tersedia

                                                @if(dataSourch.DataProduk.Show_Min_Order)
                                                {
                                                    <span class="ms-3 text-danger" style="font-size: 13px; font-weight: 700;" >
                                                        *Minimal order @dataSourch?.DataProduk?.Min_Order item
                                                    </span>
                                                }

                                                @if(dataSourch.DataProduk.Show_Max_Order)
                                                {
                                                    <span class="ms-3 text-danger" style="font-size: 13px; font-weight: 700;" >
                                                        *Maximal order @dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default).Stock item
                                                    </span>
                                                }
                                            </p>
                                        }
                                    }

                                    
                                    <div id="hidden-flayer" class="bottom-content mt-3">
                                        <div class="row align-items-start row-style" style="">

                                            <div class="col-lg-4 col-md-4 col-12 rowbox-style">
                                                <div class="qty-box">
                                                    <button @onclick="Decrease">-</button>
                                                    <span style="font-size:15px">@Quantity</span>
                                                    <button @onclick="Increase">+</button>
                                                </div>
                                            </div>

                                            <div class="col-lg-8 col-md-8 col-12 rowbox-style ps-md-2 ps-0">
                                                <div class="wish-button">
                                                    <button class="btn" @onclick=@(() => tambahKeranjang(dataSourch?.DataProduk, "detail")) style="border-radius:0px;">
                                                        Tambahkan <i class="lni lni-cart-2 ms-1"></i>
                                                    </button>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="row align-items-end mt-3 row-style">

                                            <div class="col-12 rowbox-style">
                                                <div class="button cart-button" >
                                                    <NavLink class="btn" href="@($"/payment-page")" style="width: 100%;display: flex; border-radius:0px;">Beli Sekarang</NavLink>
                                                </div>
                                            </div>

                                        </div>

                                    </div>
                        
                                    <div class="d-flex gap-4 pt-3 justify-content-center justify-content-lg-start" >

                                        <button class="d-flex justify-content-center align-items-center w-auto border-0 gap-2" style="background-color:transparent; font-size: 16px;font-weight: 500;" data-bs-toggle="modal" data-bs-target="#exampleModal1">
                                                <i class="lni lni-share-1"></i> 
                                                <span class="underline-anim" style="padding-bottom: 0px;">
                                                    Share
                                                </span>
                                        </button>

                                        <button class="d-flex justify-content-center align-items-center w-auto border-0 gap-2" style="background-color:transparent; font-size: 16px;font-weight: 500;" data-bs-toggle="modal" data-bs-target="#exampleModal3">
                                            <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="#1f1f1f"><path d="M480-312q20 0 32.5-13.27 12.5-13.28 12.5-32.5 0-19.23-13.07-31.73t-32-12.5Q461-402 448-389.5t-13 31.73q0 19.22 13.05 32.5Q461.1-312 480-312Zm-32-144h66q0-13.68 1-23.34t5-17.66q4-8 9.95-15.77Q535.9-520.55 547-532q20-20 38.5-40.5T604-631q0-53-36-83t-88-30q-48 0-80 27t-44 63l59 25q6-18 21-36t44-18q32 0 46 17t14 37q0 23-17 40t-36 35q-13 12-20 21t-11.5 20q-4.5 11-6 24t-1.5 33Zm32 408L336-192H216q-29 0-50.5-21.5T144-264v-528q0-29 21.5-50.5T216-864h528q29.7 0 50.85 21.5Q816-821 816-792v528q0 29-21.15 50.5T744-192H624L480-48ZM216-264h149l115 115 114-115h150v-528H216v528Zm264-264Z"/>
                                            </svg>
                                            <span class="underline-anim" style="padding-bottom: 0px;">
                                                Ask a question
                                            </span>
                                        </button>

                                    </div>
                                </div>

                            </div>

                        </div>
                    }

                    else
                    {
                        <div class="col-12 d-flex py-5 justify-content-center align-items-center">
                            <div class="py-5 px-3 d-flex flex-column justify-content-center align-items-center mt-5">
                                <svg xmlns="http://www.w3.org/2000/svg" height="5rem" viewBox="0 -960 960 960" width="5rem" fill="#1f1f1f"><path d="M481-792 245-657l235 135 235-135-234-135ZM144-320v-320q0-19.77 9.45-35.94Q162.9-692.12 180-702l262.62-152.27Q452-859 460.82-862q8.82-3 19.04-3 10.21 0 19.5 3 9.28 3 17.64 8l263 152q17.1 9.88 26.55 26.06Q816-659.77 816-640v184h-72v-135L479-439 216-591v270l240 139v83L180-258q-17-9-26.5-25.45T144-320ZM720-96q9.6 0 16.8-7.2 7.2-7.2 7.2-16.8 0-9.6-7.2-16.8-7.2-7.2-16.8-7.2-9.6 0-16.8 7.2-7.2 7.2-7.2 16.8 0 9.6 7.2 16.8Q710.4-96 720-96Zm-24-96h48v-96h-48v96ZM719.77 0Q640 0 584-56.23q-56-56.22-56-136Q528-272 584.23-328q56.22-56 136-56Q800-384 856-327.77q56 56.22 56 136Q912-112 855.77-56q-56.22 56-136 56ZM480-487Z"/></svg>
                                <h4 class="pt-1" style="font-weight: 500; font-size: 18px;">product not found</h4>
                            </div>
                        </div>
                    }
            
                </div>
            }
        </div>
    </div>
</section>
<!-- End Item Details -->



<!-- Review Modal -->
<div class="modal fade review-modal" id="exampleModal3" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
        <div class="modal-content" style="border-radius: 0px;" >
