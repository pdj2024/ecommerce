                                                            <Image Src="@display?.Id_Media" Alt="@display?.Nama_Display" />
                                                        }
                                                    </div>
                                                    <div style="height: 100%;display: flex;flex-direction: column;justify-content: space-between;padding: 2px 0px; gap:5px;">
