@rendermode InteractiveServer


<!-- Start Hero Area -->
<section class="hero-area hero-shimer" style="margin-top: 85px;">
    <div class="container p-0 pe-lg-3" style="width:100%; max-width:100%;">
        <div class="row">
            <div class="col-12 custom-padding-right">
                <div class="card py-3 px-0 border-0" style="border-radius:0px;" aria-busy="true">
                    <div class="skeleton skeleton-rect mb-3" style="border-radius:0px;height:100dvh"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="hero-area hero-content" style="margin-top: 85px; display:none;">
    <div class="container p-0 pe-lg-3" style="width:100%; max-width:100%;">
        <div class="row">
            <div class="col-12 custom-padding-right d-none d-md-none d-lg-none d-xl-none d-xxl-flex">

                <div class="hero-slider-new-pc hero-slider-new">

                    @foreach (var banner in GlobalDataService?.GlobalData?.ListDataBanner)
                    {
                        <div class="slide-new @( GlobalDataService?.GlobalData?.ListDataBanner.FirstOrDefault(x => x.No_Id == banner.No_Id) != null ? "active-new" : ""  )">
                            @if (@banner.Media_Desktop.Id_Media != null || @banner.Media_Desktop.Id_Media != "")
                            {
                                <Image Src="@banner.Media_Desktop.Id_Media" Class="img-cover" Style=""></Image>
                            }
                            else
                            {
                                <Image Src="/images/products/placeholder1.png" Class="img-cover" Style=""></Image>
                            }

                            <div class="caption-new">
                                @* <h3>OWN THE ICON :</h3>
                                <h1>SAMBA OG</h1> *@
                            </div>
                        </div>
                    }


                    <button class="nav-new prev-new"><span>&#10094;</span></button>
                    <button class="nav-new next-new"><span>&#10095;</span></button>

                    <div class="dots-new"></div>

                </div>

            </div>

            <div class="col-12 custom-padding-right d-none d-md-none d-lg-none d-xl-flex d-xxl-none">

                <div class="hero-slider-new-laptop hero-slider-new">

                    @foreach (var banner in GlobalDataService?.GlobalData?.ListDataBanner)
