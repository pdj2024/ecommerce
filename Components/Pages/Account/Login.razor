@using Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using System.Text.Json;
@inject NavigationManager navigationManager
@using Services
@inject pdjService pdjService
@inject IJSRuntime jsRuntime
@page "/login"

<div class="modal fade review-modal show" id="exampleModal-login" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" style="display:block; background-color:whitesmoke">
    <div class="modal-dialog modal-dialog-centered" style="max-width:480px;height: 33rem;">
        <div class="modal-content" style="border-radius: 0px; border-radius: 0px; height: fit-content; overflow: hidden;" >
            <div class="d-flex flex-column login-effect">

                <div class="login-page" style="visibility: visible;position: relative;opacity: 1;top: 0px;height: 100%;overflow: hidden;">
                    <div class="modal-header justify-content-center d-flex flex-column border-bottom-0 pb-0">
                        <h5 class="modal-title w-100 text-xl-center" id="exampleModalLabel" style="letter-spacing: -1px; font-size: 22px;font-weight: 400;">Log In Here</h5>
                        <p style="font-size:13px; font-weight:300 " class="text-xl-center w-100">
                            don't have an account?
                            <span class="underline-anim" style="font-weight:500">Sign Up</span> .
                        </p>
                    </div>

                    <EditForm Model="Model" OnValidSubmit="Authenticate" FormName="LoginForm">
                        <DataAnnotationsValidator />
                        <div class="modal-body pb-3">
                            <div class="row">
                                <div class="col-12">
                                    <div class="input-group mb-3 style-grup px-1 border-1 py-1 pb-2 form-style">
                                        <InputText type="text" style="font-size: 14px;" @bind-Value="Model.Email" id="Email" class="form-control search-form form-text" placeholder="Your email*" autocomplete="off" aria-label="Search" aria-describedby="basic-addon1" required />
                                    </div>
                                    <div class="input-group mb-3 style-grup px-1 border-1 py-1 pb-2 form-style">
                                        <InputText type="password" @bind-Value="Model.Password" id="Password" style="font-size: 14px;" class="form-control search-form form-text" placeholder="Your password*" autocomplete="off" aria-label="Search" aria-describedby="basic-addon1" required />
                                    </div>
                                    <p style="font-size:13px; font-weight:300; font-style:italic;">The fields marked * are required.</p>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer justify-content-center button border-top-0 pt-5 pb-3 px-5">
                            <button type="submit" class="btn-slide py-2 px-4" style="font-weight:500; font-size:15px; z-index:0; letter-spacing:-0.5px; width:fit-content;">
                                <span class="position-relative">Log In</span>
                            </button>
                        </div>
                    </EditForm>

                    <button type="button" class="btn btn-primary border-0" id="liveToastBtn" style="width:0px; height:0px; overflow:hidden"></button>

                    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
                        <div id="liveToast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true">
                            <div class="toast-header">
                                <strong class="me-auto">email dan password tidak sesuai!</strong>
                                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer justify-content-center button border-top-0 pt-2 pb-0 px-5">
                        <p style="font-size:13px; font-weight:300" class="text-center">log in with a Google account?</p>
                    </div>
                    
                    <div class="modal-footer justify-content-center button border-top-0 pt-0 px-5">
                        <button type="button" class="btn-slide py-2" style="font-weight:500; font-size:15px; z-index:0; letter-spacing:-0.5px; width:fit-content;">
                            <i class="lni lni-google me-3"></i>
                            <span class="position-relative">Log in with google</span>
                        </button>
                    </div>

                </div>
            
            </div>
        </div>
    </div>
</div>
@code {

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    public LoginViewModel Model { get; set; } = new();


    private async Task Authenticate()
    {

        var param = new ParameterApi
            {
                routeApi = "customer",
                prosesApi = "getAll",
                ParamUrl = new ParameterApi.ParameterUrl { email = Model.Email }
            };

        var loginStatus = await pdjService.LoginUserApi(param, Model);

        if (loginStatus.Item2)
        {
            navigationManager.NavigateTo("/", forceLoad: true);
        } else
        {
            Console.WriteLine("gagal login");
        }

    }

