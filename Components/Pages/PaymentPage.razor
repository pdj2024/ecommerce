@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@page "/payment-page/{CartList}/{itemVariant}"


<!-- Start Content Area -->

<!-- Grid Utama -->
<div class="checkout">
    <!-- Kiri: Form -->
    <div class="checkout-main">
        <div class="checkout-header">
            <NavLink @onclick="@(x => NavigationManager.NavigateTo("/", true))" style="cursor:pointer;" >
                <img src="@(@dataSourch?.ListDataCompany?.FirstOrDefault()?.Media?.FirstOrDefault(x => x.Media_Type == "landscape").Id_Media ?? "images/logo/logo-pdj.png")" alt="Logo" class="checkout-logo">
            </NavLink>
            <NavLink @onclick="@(x => NavigationManager.NavigateTo("/cart-page/keranjang", true))" class="checkout-button" style="">
                <i class="lni lni-cart-1 cart-icon-pay" </i>
            </NavLink>
        </div>
        
        <div class="accordion accordion-flush d-block d-md-block d-lg-none" id="accordionFlushExample">
          <div class="accordion-item" style="background-color:#f5f5f5">
            <h2 class="accordion-header" id="flush-headingOne">
              <button class="accordion-button collapsed" style="font-weight: 700;" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseOne" aria-expanded="false" aria-controls="flush-collapseOne">
                Ringkasan Pesanan
              </button>
            </h2>
            <div id="flush-collapseOne" class="accordion-collapse collapse" aria-labelledby="flush-headingOne" data-bs-parent="#accordionFlushExample">
              <div class="accordion-body" style="padding:0px">
                  <div class="summary__items" style="max-height: 400px;">
                    <div style="max-height: 335px;overflow-y: auto;padding: 10px 10px;display: flex;flex-direction: column;gap: 10px;">
                        @foreach (var display in dataSourch?.ListDataCart)
                        {
                            <div class="summary-item" style="padding-bottom: 10px;border-bottom: 1px solid #e5e7eb;">
                                <div class="summary-item__thumb">
                                    @if(@display?.Id_Media != null)
                                    {
                                        <Image Src="@display?.Id_Media" />
                                    }
                                    else
                                    {
                                        <div class="w-100 h-100" style="display:flex; align-items:center;justify-content:center; border-radius:5px; background-color:lightgray; color:dimgrey">
                                            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M73-889 889-73l-57 57-104-104H200q-33 0-56.5-23.5T120-200v-528L16-832l57-57Zm287 447L200-282v82h448L544-304l-22 24-162-162ZM200-648v252l126-126-126-126Zm36-192h524q33 0 56.5 23.5T840-760v524l-80-80v-234L650-426l-57-57 167-187v-90H316l-80-80Zm357 357Zm-158 70ZM326-522Zm34 80Zm176-98Z"/></svg>
                                        </div>
                                    }
                                </div>
                                <div style="height: 100%;display: flex;flex-direction: column;justify-content: space-between;padding: 2px 0px;">
                                    <div class="summary-item__title">
                                        <p class="line-clamp-2" style="margin: 0;padding: 0;font-size: 12px;line-height: 16px;">
                                            @display.Nama_Display
                                        </p>
                                    </div>
                                    <div class="summary-item__meta">@($"{display?.Qty} x " + string.Format("Rp. {0:N0}", @display?.Harga))</div>
                                </div>
                                <div style="font-weight: 600;">@string.Format("Rp. {0:N0}", @display?.Harga * display?.Qty)</div>
                            </div>
                        }
                    </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="panel section-payment">
            <div class="panel__header">Informasi Pengiriman</div>
            <div class="panel__body panel_custom">
                @foreach(var Head in Pesanan_Info.Header) 
                {
                    <div class="form-grid">
                        <div class="field">
                            <label>Nama Penerima</label>
                            <input type="text" @bind-value=@Head.Nama_Penerima class="input">
                        </div>
                        <div class="field">
                            <label>Telpon Penerima</label>
                            <input type="text" @bind-value=@Head.Telpon_Penerima class="input">
                        </div>
                    </div>
                    <div class="form-grid form-grid--single">
                        <div class="field">
                            <label>Alamat Kirim</label>
                            <input type="text" @bind-value=@Head.Alamat_Kirim class="input">
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="panel section-payment">
            <div class="panel__header">Metode Pengiriman</div>
            <div class="panel__body shipping-list">
                @foreach(var shipping_method in dataSourch?.ListDataPengiriman)
                {
                    <label class="shipping-item">
                        <div class="custom-payment w-75">
                            <input type="radio" name="ship" checked="@shipping_method.selectShipping" @onchange="(e) => SelectShipingMethod(shipping_method)">
                            <span class="w-75" style="text-overflow:ellipsis; overflow:hidden;">@shipping_method.Nama</span>
                        </div>
                        <div class="shipping-item__right">@string.Format("Rp. {0:N0}", @shipping_method.Fee)</div>
                    </label>
                }
            </div>
        </div>

        <div class="panel section-payment">
            <div class="panel__header">Metode Pembayaran</div>
            <div class="panel__body payment-list">
                @foreach(var payment_method in dataSourch?.ListDataPembayaran)
                {
                    <label class="payment-item">
                        <div class="custom-payment w-75">
                            <input type="radio" name="pay" checked="@payment_method.selectPayment" @onchange="(e) => SelectPaymentMethod(payment_method)">
                            <span class="" style="text-overflow:ellipsis; overflow:hidden;">@payment_method.Display</span>
                        </div>
                        <div class="shipping-item__right">@string.Format("Rp. {0:N0}", @payment_method.Fee)</div>
                    </label>
                }
                
            </div>
        </div>

        <aside class="checkout-summary2 panel d-flex d-md-flex d-lg-none">
            <div class="summary__items" style="max-height: 400px;">
                <div class="panel__header" style="padding: 5px 20px 18px 0px; font-size:22px;" >Ringkasan Pesanan</div>
                <div style="max-height: 335px;overflow-y: auto;padding: 10px 10px;display: flex;flex-direction: column;gap: 10px;">
                    @foreach (var display in dataSourch?.ListDataCart)
                    {
                        <div class="summary-item" style="padding-bottom: 10px;border-bottom: 1px solid #e5e7eb;">
                            <div class="summary-item__thumb">
                                @if(@display?.Id_Media != null)
                                {
                                    <Image Src="@display?.Id_Media" />
                                }
                                else
                                {
                                    <div class="w-100 h-100" style="display:flex; align-items:center;justify-content:center; border-radius:5px; background-color:lightgray; color:dimgrey">
                                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M73-889 889-73l-57 57-104-104H200q-33 0-56.5-23.5T120-200v-528L16-832l57-57Zm287 447L200-282v82h448L544-304l-22 24-162-162ZM200-648v252l126-126-126-126Zm36-192h524q33 0 56.5 23.5T840-760v524l-80-80v-234L650-426l-57-57 167-187v-90H316l-80-80Zm357 357Zm-158 70ZM326-522Zm34 80Zm176-98Z"/></svg>
                                    </div>
                                }
                            </div>
                            <div style="height: 100%;display: flex;flex-direction: column;justify-content: space-between;padding: 2px 0px;">
                                <div class="summary-item__title">
                                    <p class="line-clamp-2" style="margin: 0;padding: 0;font-size: 12px;line-height: 16px;">
                                        @display.Nama_Display
                                    </p>
                                </div>
                                <div class="summary-item__meta">@($"{display?.Qty} x " + string.Format("Rp. {0:N0}", @display?.Harga))</div>
                            </div>
                            <div style="font-weight: 600;">@string.Format("Rp. {0:N0}", @display?.Harga * display?.Qty)</div>
                        </div>
                    }
                </div>
            </div>
            <div>
                <div class="summary__line">
                    <span>Subtotal</span>
                    <span style="font-weight:600;">@string.Format("Rp. {0:N0}", dataSourch?.ListDataCart.Sum(x => x.Qty * x.Harga))</span>
                </div>
                <div class="summary__line">
                    <span>Pengiriman</span>
                    <span style="font-weight:600;">@string.Format("Rp. {0:N0}", shipingMethodFee)</span>
                </div>
                <div class="summary__line">
                    <span>Biaya Platform</span>
                    <span style="font-weight:600;">@string.Format("Rp. {0:N0}", paymentMethodFee)</span>
                </div>
                <div class="summary__line summary__line--bold">
                    <span>Total</span>
                    <span>@string.Format("Rp. {0:N0}", nettoKeranjang)</span>
                </div>
            </div>
        </aside>

        <div style="padding: 0px 20px;">
            <button class="btn btn--primary btn--full" @onclick="@( () => FinisedOrder())" >Selesaikan Pesanan</button>
            @if(alertPayment) {
                <span class="mt-2" style="color:red;">
                    * Pastikan anda telah memilih metode pembayaran dan pengiriman.
                </span>
            }
            @if(alertProfile) {
                <span class="mt-1" style="color:red;">
                    * Pastikan anda telah mengisi alamat kirim, nama dan telepon penerima.
                </span>
            }
        </div>

        <div style="padding: 0px 0px;">
            <button style="opacity: 1;position: absolute;width: 0;height: 0;padding: 0;" id="modalPaymentStatus" type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#staticBackdrop"/>
        </div>

        <div style="padding: 0px 0px;">
            <button style="opacity: 1;position: absolute;width: 0;height: 0;padding: 0;" id="modalPaymentStatus2" type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#staticBackdrop2"/>
        </div>


        <!-- Footer -->
        <footer class="checkout-footer text-center">
            <p>Copyright by Pacific Data Jaya ©2025</p>
        </footer>

    </div>

    <!-- Kanan: Ringkasan Order -->
    <aside class="checkout-summary panel d-none d-md-none d-lg-flex">
        <div class="summary__items" style="max-height: 400px;">
            <div class="panel__header" style="padding: 5px 20px 18px 0px; font-size:22px;" >Ringkasan Pesanan</div>
            <div style="max-height: 335px;overflow-y: auto;padding: 10px 10px;display: flex;flex-direction: column;gap: 10px;">
                @foreach (var display in dataSourch?.ListDataCart)
                {
                    <div class="summary-item" style="padding-bottom: 10px;border-bottom: 1px solid #e5e7eb;">
                        <div class="summary-item__thumb">
                            @if(@display?.Id_Media != null)
                            {
                                <Image Src="@display?.Id_Media" />
                            }
                            else
                            {
                                <div class="w-100 h-100" style="display:flex; align-items:center;justify-content:center; border-radius:5px; background-color:lightgray; color:dimgrey">
                                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M73-889 889-73l-57 57-104-104H200q-33 0-56.5-23.5T120-200v-528L16-832l57-57Zm287 447L200-282v82h448L544-304l-22 24-162-162ZM200-648v252l126-126-126-126Zm36-192h524q33 0 56.5 23.5T840-760v524l-80-80v-234L650-426l-57-57 167-187v-90H316l-80-80Zm357 357Zm-158 70ZM326-522Zm34 80Zm176-98Z"/></svg>
                                </div>
                            }
                        </div>
                        <div style="height: 100%;display: flex;flex-direction: column;justify-content: space-between;padding: 2px 0px;">
                            <div class="summary-item__title">
                                <p class="line-clamp-2" style="margin: 0;padding: 0;font-size: 12px;line-height: 16px;">
                                    @display.Nama_Display
                                </p>
                            </div>
                            <div class="summary-item__meta">@($"{display?.Qty} x " + string.Format("Rp. {0:N0}", @display?.Harga))</div>
                        </div>
                        <div style="font-weight: 600;">@string.Format("Rp. {0:N0}", @display?.Harga * display?.Qty)</div>
                    </div>
                }
            </div>
        </div>
        <div>
            <div class="summary__line">
                <span>Subtotal</span>
                <span style="font-weight:600;">@string.Format("Rp. {0:N0}", dataSourch?.ListDataCart.Sum(x => x.Qty * x.Harga))</span>
            </div>
            <div class="summary__line">
                <span>Pengiriman</span>
                <span style="font-weight:600;">@string.Format("Rp. {0:N0}", shipingMethodFee)</span>
            </div>
            <div class="summary__line">
                <span>Biaya Platform</span>
                <span style="font-weight:600;">@string.Format("Rp. {0:N0}", paymentMethodFee)</span>
            </div>
            <div class="summary__line summary__line--bold">
                <span>Total</span>
                <span>@string.Format("Rp. {0:N0}", nettoKeranjang)</span>
            </div>
        </div>
    </aside>

    <!-- Modal -->

    <div class="modal fade review-modal" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel">
        <div class="modal-dialog modal-dialog-centered" style="max-width:600px;">
            <div class="modal-content" style="border-radius: 0px;" >
                <div class="modal-header justify-content-between d-flex border-bottom-0 pb-0">
                    <h5 class="modal-title w-100 text-center" id="exampleModalLabel" style="letter-spacing: -1px; font-size: 22px;font-weight: 400;">Informasi Pesanan</h5>
                </div>

                @foreach (var Head in Pesanan_Info.Header)
                {
                    <div class="modal-body">
                        <div class="row">

                            <div class="col-12">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                    <input readonly style="background-color:transparent !important; font-weight: 700; font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your name*" aria-label="Search" aria-describedby="basic-addon1" required value="@Head?.Nama_Penerima" />
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Nama Penerima</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                    <input readonly style="background-color:transparent !important; font-weight: 700; font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your name*" aria-label="Search" aria-describedby="basic-addon1" required value="@Head?.Telpon_Penerima" />
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Telpon Penerima</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                    <textarea rows="4" readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px;"  class="form-control search-form form-text" placeholder="Your phone" aria-label="Search" aria-describedby="basic-addon1" required value="@Head?.Alamat_Kirim"/>
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Alamat Kirim</label>
                                </div>
                            </div>
                            
                            <div class="col-6">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                    <input readonly style="background-color:transparent !important; font-weight: 700; font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your name*" aria-label="Search" aria-describedby="basic-addon1" required value="@($"{dataLayanan?.Cara_Bayar}")" />
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Metode Pembayaran</label>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                    <input readonly style="background-color:transparent !important; font-weight: 700; font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your name*" aria-label="Search" aria-describedby="basic-addon1" required value="@($"{dataKirim?.Nama}")" />
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Pengiriman</label>
                                </div>
                            </div>

                            <div class="col-12">
                                <aside class="checkout-summary2 panel" style="background-color:white; padding:0px; height:fit-content; margin-bottom:0px; margin-top:20px">
                                    <div>
                                        <div class="summary__line" style="border-top: unset;">
                                            <span>Subtotal Item</span>
                                            <span style="font-weight:600;">@string.Format("Rp. {0:N0}", dataSourch?.ListDataCart.Sum(x => x.Qty * x.Harga))</span>
                                        </div>
                                        <div class="summary__line">
                                            <span>Pengiriman</span>
                                            <span style="font-weight:600;">@string.Format("Rp. {0:N0}", shipingMethodFee)</span>
                                        </div>
                                        <div class="summary__line">
                                            <span>Biaya Platform</span>
                                            <span style="font-weight:600;">@string.Format("Rp. {0:N0}", paymentMethodFee)</span>
                                        </div>
                                        <div class="summary__line summary__line--bold">
                                            <span>Total</span>
                                            <span>@string.Format("Rp. {0:N0}", nettoKeranjang)</span>
                                        </div>
                                    </div>
                                </aside>
                    
                                @if(alertCreate) {
                                    <span class="mt-1" style="color:red;">
                                        * Terjadi kesalahan ketika membuat order, coba lagi.
                                    </span>
                                }
                            </div>                        
                        </div>
                    </div>
            
                    <div class="modal-footer justify-content-center button border-top-0 pt-2 px-5">
                        <button type="button" class="btn btn-secondary bg-secondary" data-bs-dismiss="modal">Batal</button>
                        <button type="button" class="btn btn-primary" @onclick="@( () => PayOrder())" >
                            @if(loadProses) 
                            {
                                <div class="spinner-border spinner-border-sm" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            } 
                            else
                            {
                                @("Buat Pembayaran")
                            }
                        </button>
                    </div>
                    
                }
            
            </div>
        </div>
    </div>

    <div class="modal fade review-modal" id="staticBackdrop2" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel">
        <div class="modal-dialog modal-dialog-centered" style="max-width:600px; overflow:auto !important;">
            <div class="modal-content" style="border-radius: 0px;" >
                <div class="modal-header justify-content-between d-flex border-bottom-0 pb-0">
                    <h5 class="modal-title w-100 text-center" id="exampleModalLabel" style="letter-spacing: -1px; font-size: 22px;font-weight: 400;">Informasi Pembayaran</h5>
                </div>

                @foreach (var Head in Pesanan_Create.Header)
                {
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-6">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                    <input readonly style="background-color:transparent !important; font-weight: 700; font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your name*" aria-label="Search" aria-describedby="basic-addon1" required value="@Head?.No_Bukti" />
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Order Id</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                    <input readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px; @(Head?.Status_Order_1 == "belum bayar" ? "color:red" : "color:orange")" type="text" class="form-control search-form form-text" placeholder="Your email*" aria-label="Search" aria-describedby="basic-addon1" required value="@ti.ToTitleCase(Head?.Status_Order_1)"/>
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Status</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                    <input readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your phone" aria-label="Search" aria-describedby="basic-addon1" required value="@Head?.Metode_Bayar"/>
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Metode Pembayaran</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                    <input readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your phone" aria-label="Search" aria-describedby="basic-addon1" required value="@Head?.Expiry_Time.ToString()" />
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Expired</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                    <input readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your phone" aria-label="Search" aria-describedby="basic-addon1" required value="@string.Format("Rp. {0:N0}", @Head?.Grand_Total)" />
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Total Pembayaran</label>
                                </div>
                            </div>

                            <div class="col-12">
                                @if (@Head?.Metode_Bayar == "QRIS" && @Head?.Status_Order_1 == "belum bayar") 
                                {
                                    <div class="d-flex align-items-center justify-content-center mt-3">
                                        <img class="qr-payment" style="max-width:50%" src="@Head?.QrBase64" alt="Alternate Text" />
                                    </div>
                                }
                                else if (@Head?.Metode_Bayar != "QRIS" && @Head?.Status_Order_1 == "belum bayar")
                                {
                                    @if (@Head?.Metode_Bayar == "VA MANDIRI" || @Head?.Metode_Bayar == "COUNTER INDOMARET") {
                                        <div class="col-12 ">
                                            <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3 va-box" style="border-radius:0px; max-width:100%" data-va="@Head?.Payment_Number_1">
                                                <input readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your phone" aria-label="Search" aria-describedby="basic-addon1" required value="@Head?.Payment_Number_1" />
                                                <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">
                                                    @(Head?.Metode_Bayar == "VA MANDIRI" ? "Biller Code" : "Payment Code")
                                                </label>
                                                <button class="copy-btn copy-btn-@Head?.Payment_Number_1-code border-0" style="border-radius: 0px;position: absolute;top: 12px;right: 15px;" type="button" aria-label="Copy VA" @onclick=@( x => clickCopy(Head, $"{Head?.Payment_Number_1}-code"))>Copy</button>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3 va-box" style="border-radius:0px; max-width:100%" data-va="@Head?.Payment_Number_2">
                                                <input readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your phone" aria-label="Search" aria-describedby="basic-addon1" required value="@Head?.Payment_Number_2" />
                                                <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">
                                                    @(Head?.Metode_Bayar == "VA MANDIRI" ? "Bill Key" : "Merchant Id")
                                                </label>

                                                <button class="copy-btn copy-btn-@Head?.Payment_Number_2-code border-0" style="border-radius: 0px;position: absolute;top: 12px;right: 15px;" type="button" aria-label="Copy VA" @onclick=@( x => clickCopy(Head, $"{Head?.Payment_Number_2}-code"))>Copy</button>
                                            </div>
                                        </div>
                                    }
                                    else {
                                        <div class="col-12">
                                            <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3 va-box" style="border-radius:0px; max-width:100%" data-va="@Head?.Payment_Number_1">
                                                <input readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your phone" aria-label="Search" aria-describedby="basic-addon1" required value="@Head?.Payment_Number_1" />
                                                <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">
                                                    Virtual Account
                                                </label>
                                                <button class="copy-btn copy-btn-@Head?.Payment_Number_1-code border-0" style="border-radius: 0px;position: absolute;top: 12px;right: 15px;" type="button" aria-label="Copy VA" @onclick=@( x => clickCopy(Head, $"{Head?.Payment_Number_1}-code"))>Copy</button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            @if (@Head?.Status_Order_1 != "belum bayar")
                            {
                                <p style="font-size:13px; font-weight:500; font-style:italic;" class="text-success">
                                    Pembayaran berhasil, dalam @countRedirect detik anda akan berpindah halaman
                                </p>
                            }

                        </div>
                    </div>
            
                    <div class="modal-footer justify-content-center button border-top-0 pt-2 px-5">
                        @if (@Head?.Status_Order_1 == "belum bayar") {
                            <button type="button" style="min-width:7rem; border-radius:0px;" disabled=@loadProses class="btn btn-primary" @onclick="@( x => refreshStatus(Head))" >
                                @if(loadProses) 
                                {
                                    <div class="spinner-border spinner-border-sm" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                } 
                                else
                                {
                                    @("Refresh")
                                }
                            </button>
                        }

                        @if (@Head?.Metode_Bayar == "QRIS" && @Head?.Status_Order_1 == "belum bayar") 
                        {
                            <button type="button" class="btn btn-success" @onclick="@( x => DownloadImage(Head))" >Download</button>
                        }

                        <button type="button" class="@( @Head?.Status_Order_1 == "belum bayar" ? "btn btn-secondary" : "btn btn-success" )" @onclick="@( x => directStatus(@Head))" > @(Head.Status_Order_1 == "belum bayar" ? "Selesaikan Nanti" : "Lihat Pesanan")</button>
                    </div>

                }
                
                @if(loadRefresh) 
                {
                    <form aria-busy="true" class="mb-5 px-3">
                        <div class="mb-3">
                            <div class="skeleton skeleton-subtitle mb-2" style="width:25%"></div>
                            <div class="skeleton" style="height:38px;width:100%;border-radius:.375rem"></div>
                        </div>
                        <div class="mb-3">
                            <div class="skeleton skeleton-subtitle mb-2" style="width:20%"></div>
                            <div class="skeleton" style="height:38px;width:100%;border-radius:.375rem"></div>
                        </div>
                        <div class="d-flex gap-2">
                            <div class="skeleton" style="width:120px;height:38px;border-radius:.375rem"></div>
                            <div class="skeleton" style="width:80px;height:38px;border-radius:.375rem"></div>
                        </div>
                    </form>

                    <div class="modal-footer justify-content-center button border-top-0 pt-2 px-5"> 
                        <button type="button" style="min-width:7rem; border-radius:0px;" disabled=@(!loadRefresh) class="btn btn-primary" @onclick="@( x => refreshStatus(Pesanan_Create.Header.FirstOrDefault()))" >
                            @("Refresh")
                        </button>

                    </div>
                }
            

            
            </div>
        </div>
    </div>

    <div class="modal fade review-modal" id="staticBackdrop3" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel">
        <div class="modal-dialog modal-dialog-centered" style="max-width:600px; overflow:auto !important;">
            <div class="modal-content" style="border-radius: 0px;" >
                <div class="modal-header justify-content-between d-flex border-bottom-0 pb-0">
                    <h5 class="modal-title w-100 text-center" id="exampleModalLabel" style="letter-spacing: -1px; font-size: 22px;font-weight: 400;">Informasi Pesanan</h5>
                </div>

                @foreach (var Head in Pesanan_Create.Header)
                {
                    <div class="modal-body">
                        <div class="row">
                            <p style="font-size:13px; font-weight:500; font-style:italic;" class="text-danger">
                                Jumlah pembelian melebihi stock, periksa kembali pesanan anda.
                            </p>
                            <p style="font-size:13px; font-weight:500; font-style:italic;">
                                Anda akan diarahkan kembali ke halamana sebelumnya.
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>


</div>

<!-- End Content Area -->
