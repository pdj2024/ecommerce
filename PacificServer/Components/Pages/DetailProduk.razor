                                <div class="col-12 py-xl-2">
                                </div>

                                <div class="breadcrumbs p-0 py-4" style="">
                                    <div class="container-fluid px-2">
                                        <div class="row align-items-center">
                                            <div class="col-12 px-0 pb-2">
                                                <ul class="breadcrumb-nav">
                                                    <li><a>@dataSourch?.DataProduk?.Nama_Brand</a></li>
                                                    <li><a>@dataSourch?.DataProduk?.Nama_Display</a></li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div style="--swiper-navigation-color: #fff; --swiper-pagination-color: #fff" class="swiper mySwiper2">
                                    <div class="swiper-wrapper">
                                        @foreach (var img in dataSourch?.DataProduk?.MediaUrls)
                                        {
                                            <div class="swiper-slide">
                                                <Image Src="@img.Id_Media" Class="vw-100 h-100" />
                                            </div>
                                        }
                                    </div>
                                    <div class="swiper-button-next"></div>
                                    <div class="swiper-button-prev"></div>
                                </div>

                                <div thumbsSlider="" class="swiper mySwiper">
                                    <div class="swiper-wrapper">
                                        @foreach (var img in dataSourch?.DataProduk?.MediaUrls)
                                        {
                                            <div class="swiper-slide">
                                                <Image Src="@img.Id_Media" Class="vw-100 h-100" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6 col-md-12 col-12 ps-lg-4 px-0">


                            <div class="product-info position-sticky top-0" style="">
                                <div class="col-12 py-xl-4 py-2">
                                </div>
                                <div class="col-12 py-xl-4 py-0">
                                </div>

                                <div>
                                    @if (dataSourch?.DataProduk?.Diskon1 != null && dataSourch?.DataProduk?.Diskon1 >= 1)
                                    {
                                        <span class="badge bg-primary" style="padding: 8px 14px;font-size: 15px;display: flex;width: fit-content;align-items: center;gap: 8px;margin-bottom: 10px;font-weight: 700;border-radius: 0px;">
                                            Potongan @string.Format("Rp. {0:N0}", ((dataSourch?.DataProduk?.Diskon1 / 100) * dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Harga))
                                        </span>
                                    }
