<style>
    .section-footer h5 {
        font-weight: 400;
        font-size: 22px;
        letter-spacing: -0.7px;
    }
    .section-footer p {
        font-weight: 400;
        font-size: 14px;
    }
    .section-footer li {
        font-weight: 400;
        font-size: 14px;
        margin-bottom:5px;
    }
    .section-footer li {
        display:flex;
        flex-direction:row;
        gap:10px;
        align-items:center;
        justify-content:start;
    }

    .filter-content {
        border:unset;
    }

    .filter-content p {
        font-weight: 400;
        font-size: 14px;
    }
    
    label.filter-label {
        font-weight: 400;
        font-size: 18px;
        letter-spacing: -0.7px;
    }
</style>
