<!-- Review Modal -->
<div class="modal fade review-modal" id="exampleModal3" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
        <div class="modal-content" style="border-radius: 0px;" >
            <div class="modal-header justify-content-between d-flex border-bottom-0 pb-0">
                <h5 class="modal-title w-100 text-xl-center" id="exampleModalLabel" style="letter-spacing: -1px; font-size: 22px;font-weight: 400;">Ajukan pertanyaan</h5>
                <button type="button" class="btn-close m-0" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="input-group mb-3 style-grup px-1 border-1 form-style">
                            <InputText type="text" class="form-control search-form form-text" @bind-value=@nama placeholder="Nama" aria-label="Search" aria-describedby="basic-addon1" required />
                        </div>
                        <div class="input-group mb-3 style-grup px-1 border-1 form-style">
                            <InputText type="text" class="form-control search-form form-text" @bind-value=@email placeholder="Telepon" aria-label="Search" aria-describedby="basic-addon1" required />
                        </div>
                        <div class="input-group mb-1 style-grup px-1 border-1 form-style">
                            <InputTextArea Rows="4" class="form-control search-form form-text" @bind-value=@pesan placeholder="Pesan" aria-label="Search" aria-describedby="basic-addon1" required />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-center button border-top-0 pt-2 px-5">
                <button @onclick=@KirimPesan type="button" class="btn-slide border-0" style="font-weight:500; font-size:15px; z-index:0; letter-spacing:-0.5px; width:fit-content;">
                    <span class="position-relative">Kirim Pertanyaan</span>
                </button>
            </div>
        </div>
    </div>
</div>
<!-- End Review Modal -->

<!-- Review Modal -->
<div class="modal fade review-modal" id="exampleModal1" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered px" style="max-width:480px;">
        <div class="modal-content" style="border-radius: 0px;" >
            <div class="modal-header justify-content-end d-flex border-bottom-0 pb-0 pt-3">
                <button type="button" class="btn-close m-0" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-0 px-3">
                <div class="row px-3">
                    <div class="col-12">
                        <p style="font-size:18px; font-weight:400; letter-spacing:-1px; margin-top: -15px; width:fit-content" class="mb-3">
                            Bagikan produk ini
                        </p>
                        <div class="input-group mb-3 va-box" style="border-radius:0px; border: 1px solid #d7d7d7;" data-va="@NavigationManager.Uri">
                            <input type="text" class="form-control" value="@NavigationManager.Uri" placeholder="Url Product" aria-label="Recipient's username" aria-describedby="button-addon2" readonly style="border: none; border-radius: 0px;background-color: white; overflow: hidden !important; text-overflow: ellipsis; font-size: 14px;">
                            <button label="Copy VA" class="btn-slide px-3 copy-btn copy-btn-1-code" @onclick=@( x => clickCopy(null, $"{1}-code")) type="button" id="button-addon2" style="font-weight:500; font-size:15px; z-index:0; letter-spacing:-0.5px; width:fit-content; border-left: 1px solid #d7d7d7;border-top: unset;border-bottom: unset;border-right: unset;">
                                <span class="position-relative">Copy</span>
                            </button>
                        </div>
                        <div class="d-flex flex-row gap-3 mt-3">
                            @foreach (var company in dataSourch.ListDataCompanySocial)
                            {
                                <div style="width:30px; height:25px;">
                                    <NavLink target="_blank" class="w-100 h-100 media-sosial" style="border-radius: 5px;" href="@company.Url"><img class="w-100 h-100" src="@company.Id_Media" alt="Alternate Text" /></NavLink>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End Review Modal -->

<div class="col-12 mt-4 pt-5">
    <div class="section-title mb-1 pt-5">
        <h2>Anda mungkin juga menyukainya</h2>
    </div>
</div>

<!-- Start Trending Product Area -->
<section class="trending-product section pt-3">
    <div class="container-fluid">

        <div class="row px-0 px-lg-3 px-xl-4 px-xxl-10"> 

            @foreach (var dataProduk in GlobalDataService.GlobalData?.DataHomepage.Products)
            {
                <div class="col-lg-3 col-md-4 col-6 col-xxl-2 pt-2 pb-2 product">
                    <!-- Start Single Product -->
                    <PacificWeb.Components.Sections.ProductDisplay DataProduk="dataProduk" selectProduk="@selectProduk" />
                    <!-- End Single Product -->
                </div>
            }    
        
        </div>
    
        <div class="w-100 d-flex mt-5 flex-column align-items-center justify-content-center">
            <button class="btn-slide px-3 w-auto" style="z-index: 0;" @onclick=@(x => NavigateToHome("search-page?keyword=")) >
                Tampilkan lebih banyak
            </button>
        </div>
    </div>
</section>
<!-- End Trending Product Area -->

<SelectProduk @ref=@select_produk header_page="@header_page" DataProduk=@ScopedDataServices.ScopedData.DataProduk/>

@if (dataSourch?.DataProduk != null)
{
    <div id="flayer" class="d-flex flex-row px-2 py-1 px-xl-5">
        <div class="col-12 col-md-5 d-none d-md-flex gap-3">
            <Image Src="@dataSourch?.DataProduk?.MediaUrls.FirstOrDefault()?.Id_Media" Class="h-100 w-auto p-1" />

            <div class="d-flex flex-column justify-content-center gap-1">

                <h5 class="title" style="font-size: 0.9rem;font-weight: 400;letter-spacing: -0.5px;">@dataSourch?.DataProduk?.Nama_Display</h5>

                <p style="color:black;font-weight: 700;" class="d-flex align-items-center">
                    @if (dataSourch?.DataProduk?.Diskon1 != null || dataSourch?.DataProduk?.Diskon1 >= 1)
                    {
                        <span class="text-primary">
                            @string.Format("Rp. {0:N0}", (dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Harga - ((dataSourch?.DataProduk?.Diskon1 / 100) * dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Harga)))
                        </span>
                    }
                    else
                    {
                        <span class="text-primary" >
                            @string.Format("Rp. {0:N0}", dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Harga)
                        </span>
                    }

                    @if (dataSourch?.DataProduk?.Diskon1 != null || dataSourch?.DataProduk?.Diskon1 >= 1) 
                    {
                        <span style="display: inline-block; margin-left: 15px; color: #888; text-decoration: line-through; font-size: 12px; font-weight: 400; font-style:italic" >
                            @string.Format("Rp. {0:N0}", dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Harga)
                        </span>
                    }
                </p>

            </div>
        </div>

        <div class="col-12 col-md-7 d-flex">
            <div class="bottom-content d-flex align-items-center justify-content-center justify-content-lg-end" style="width: 100%;">
                <div class="row px-0 px-lg-3 align-items-end justify-content-center justify-content-lg-end row-style d-flex w-100" style="">
                
                    <div class="col-4 col-xl-3 px-1 px-lg-2">
                        <div class="btn-group w-100">
                            <button class="dropdown-toggle btn-slide px-0 justify-content-around" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span style="width: 54%;overflow: hidden;text-overflow: ellipsis;">
                                    @(dataSourch?.DataProduk?.Option_Default == "" ? "Empty" : dataSourch?.DataProduk?.Option_Default)
                                </span>
                                <i class="lni lni-chevron-up" style="transform: rotateZ(180deg);font-size: 18px;font-weight: 500;"></i>
                            </button>
                            <ul class="dropdown-menu">
                                @foreach (var Option in dataSourch?.DataProduk?.Options)
                                    {
                                        <li class="style-drop">
                                            <button 
                                                type="button" 
                                                class="dropdown-item @(dataSourch?.DataProduk?.Id_Option_Default == Option.Option_Id ? "active" : "") d-flex flex-row align-items-center gap-2"
                                                disabled="@(dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == Option.Option_Id && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default && x.Status == "aktif")?.Stock >= dataSourch?.DataProduk?.Min_Order ? false : true)"
                                                @onclick="() => OnVariantChanged(Option.Option_Id)">
                                                <Image Style="width:50px; height:50px;" Src="@Option.MediaUrl?.Id_Media" />
                                                @(Option.Option_Label == "" ? "Empty" : Option.Option_Label)
                                            </button>
                                        </li>
                                    }
                            </ul>
                        </div>
                    </div>
                    <div class="col-3 col-xl-3 px-1 px-lg-2">
                        <div class="btn-group w-100">
                            <button class="dropdown-toggle btn-slide px-0 justify-content-around" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span style="width: 54%;overflow: hidden;text-overflow: ellipsis;">
                                    @(dataSourch?.DataProduk?.Size_Default == "" ? "Kosong" : dataSourch?.DataProduk?.Size_Default)
                                </span>
                                <i class="lni lni-chevron-up" style="transform: rotateZ(180deg);font-size: 18px;font-weight: 500;" ></i>
                            </button>
                            <ul class="dropdown-menu">
                                @foreach (var size in dataSourch?.DataProduk?.Sizes)
                                {
                                    <li class="style-drop">
                                        <button 
                                            type="button"
                                            disabled="@(dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == size.Size_Id && x.Status == "aktif")?.Stock >= dataSourch?.DataProduk?.Min_Order ? false : true)"
                                            class="dropdown-item @(dataSourch?.DataProduk?.Id_Size_Default == size.Size_Id ? "active" : "")" 
                                            @onclick="() => OnSizeChanged(size.Size_Id)">
                                            @(size.Size_Label == "" ? "Kosong" : size.Size_Label)
                                        </button>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                    <div class="col-3 d-none d-xl-flex">
                        <div class="qty-box">
                            <button @onclick="Decrease">-</button>
                            <span style="font-size:15px; color:black;">@Quantity</span>
                            <button @onclick="Increase">+</button>
                        </div>
                    </div>
                    <div class="col-5 col-lg-3 px-1 px-lg-2">
                        @if(dataSourch.DataProduk.Id_Option_Default != "" || dataSourch.DataProduk.Id_Size_Default != "") {
                            <div class="btn-group w-100" style="">
                                <button disabled=@(dataSourch.DataProduk.Id_Option_Default == "" || dataSourch.DataProduk.Id_Size_Default == "") class="btn-slide" @onclick=@(() => tambahKeranjang(dataSourch?.DataProduk, "detail"))  type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Tambahkan <i class="lni lni-cart-2 ms-2"></i>
                                </button>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>}


