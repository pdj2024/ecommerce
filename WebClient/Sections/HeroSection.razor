<!-- Start Hero Area -->


<div class="hero-shimer" style="margin-top: 85px;width: 100%;display: none;">
    <div class="row w-100 m-0">
        <div class="col-12 w-100">
            <div class="card py-3 px-0 border-0" style="border-radius:0px;" aria-busy="true">
                <div class="skeleton skeleton-rect mb-3" style="border-radius:0px;height:100dvh"></div>
            </div>
        </div>
    </div>
</div>

<div class="hero-content" style="margin-top: 85px;width: 100%;display: flex;">
    <div class="row w-100 m-0">

        <div class="col-12 p-0 d-none d-md-none d-lg-none d-xl-flex d-xxl-flex w-100">
            <div id="carouselExampleDark1" class="carousel carousel-dark slide w-100" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    @foreach (var banner in GlobalDataService?.GlobalData?.DataHomepage.Banners)
                    {
                        <button type="button" data-bs-target="#carouselExampleDark1" data-bs-slide-to="@(GlobalDataService?.GlobalData?.DataHomepage.Banners.IndexOf(banner))" class="@(GlobalDataService?.GlobalData?.DataHomepage.Banners.FirstOrDefault()?.No_Id == banner.No_Id ? "active" : $"Slide {(GlobalDataService?.GlobalData?.DataHomepage.Banners.IndexOf(banner) + 1)}")" aria-current="true" aria-label=@($"Slide {GlobalDataService?.GlobalData?.DataHomepage.Banners.IndexOf(banner) + 1}")></button>
                    }
                </div>
                <div class="carousel-inner w-100">
                    @foreach (var banner in GlobalDataService?.GlobalData?.DataHomepage.Banners)
                    {
                        <div class="carousel-item @(GlobalDataService?.GlobalData?.DataHomepage.Banners.FirstOrDefault()?.No_Id == banner.No_Id ? "active" : "" )" data-bs-interval="10000">
                            @if (@banner?.Media_Desktop?.Id_Media != null && @banner?.Media_Desktop?.Id_Media != "")
                            {
                                <img src="@banner?.Media_Desktop?.Id_Media" class="d-block w-100 img-cover" alt="...">
                            }
                            else
                            {
                                <img src="/images/products/placeholder1.png" class="d-block w-100 img-cover" alt="...">
                            }
                            <div class="carousel-caption d-none d-md-block">
                                @* <h5 class="text-white">@banner.Nama_Banner</h5>
                                <p class="text-white">Some representative placeholder content for the first slide.</p> *@
                            </div>
                        </div>
                    }
                </div>
                <button class="carousel-control-prev text-white" type="button" data-bs-target="#carouselExampleDark1" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next text-white" type="button" data-bs-target="#carouselExampleDark1" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>

        <div class="col-12 p-0 d-none d-md-flex d-lg-flex d-xl-none w-100">

            <div id="carouselExampleDark2" class="carousel carousel-dark slide w-100" data-bs-ride="carousel">
