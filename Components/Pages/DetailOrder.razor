                                                            </svg>
                                                        </div>
                                                        <div class="w-100 d-flex flex-row position-absolute" style="height:5px;">
                                                            <div class="col-6 bg-primary" style="height:5px;">

                                                            </div>
                                                            <div class="col-6" style="height:5px;">

                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-1 d-flex align-items-center justify-content-center"/>
                                                </div>
                                                <div class="d-flex flex-row w-100 pt-2" style="background-color: white;">
                                                    <div class="col-1 d-flex align-items-center justify-content-center"/>
                                                    <div class="col-2 d-flex flex-column align-items-center justify-content-center position-relative" >
                                                        <div class=" d-flex flex-column align-items-center justify-content-center">
                                                            <p>
                                                                Pesanan Dibuat
                                                            </p>
                                                            <p>
                                                                @* @item.Created_At *@
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <div class="col-2 d-flex flex-column align-items-center justify-content-center position-relative" >
                                                        <div class="d-flex flex-column align-items-center justify-content-center">
                                                            <p>
                                                                Pesanan Dibayar
                                                            </p>
                                                            <p>
                                                                @* @item.Created_At *@
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <div class="col-2 d-flex flex-column align-items-center justify-content-center position-relative" >
                                                        <div class="d-flex flex-column align-items-center justify-content-center">
                                                            <p>
                                                                Pesanan Dikemas
                                                            </p>
                                                            <p>
                                                                @* @item.Created_At *@
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <div class="col-2 d-flex flex-column align-items-center justify-content-center position-relative" >
                                                        <div class="d-flex flex-column align-items-center justify-content-center">
                                                            <p>
                                                                Pesanan Dikirim
                                                            </p>
                                                            <p>
                                                                @* @item.Created_At *@
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <div class="col-2 d-flex flex-column align-items-center justify-content-center position-relative" >
                                                        <div class="d-flex flex-column align-items-center justify-content-center">
                                                            <p>
                                                                Pesanan Diterima
                                                            </p>
                                                            <p>
                                                                @* @item.Created_At *@
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <div class="col-1 d-flex align-items-center justify-content-center"/>
                                                </div> 
                                            </div>
                                            
                                            <div class="mail-line"/>
                                            
                                            <div class="d-flex flex-column w-100 py-4" style="background-color: white;">
                                                <div class="col-12 d-flex align-items-center justify-content-between px-3" >
                                                    <h4 style="" class="">
                                                        <span style="font-size:20px; font-weight:400;">
                                                            Alamat Pengiriman
                                                        </span>
                                                    </h4>
                                                    <h4 style="" class="">
                                                        <span style="font-size:16px; color:#1500b2; font-weight:500;">
                                                            @item.Nama_Shipping_Option
                                                        </span>
                                                    </h4>
                                                </div>
                                                <div class="col-12 d-flex flex-column align-items-start px-3 pt-3" >
                                                    <p style="color:black;font-weight:500">
                                                        @item.Nama_Penerima
                                                    </p>
                                                    <p style="color:gray;font-weight:400">
                                                        @item.Telpon_Penerima
                                                    </p>
                                                    <p style="color:gray;font-weight:400">
                                                        @item.Alamat_Kirim
                                                    </p>
                                                </div>
                                            </div>
                                            
                                            <div class="mail-line mb-2"/>
                                            
                                            <h2 class="accordion-itemer rounded-0 border-0" id="panelsStayOpen-itemingOne">
                                                <div class="d-flex w-100 flex-column gap-3 px-3" style="background-color: white; border-radius:5px;"> 
                                                    @foreach (var produk in ScopedDataServices?.ScopedData?.DataPesananDetail?.Data.Items.Where(x => x.No_Bukti == item.No_Bukti).ToList())
                                                    {
                                                        <div class="d-flex flex-row justify-content-between w-100 py-3" 
                                                        style="@(ScopedDataServices?.ScopedData?.DataPesananDetail?.Data.Items.Where(x => x.No_Bukti == item.No_Bukti).ToList().Count() >= 2 ? "border-bottom: 1px solid #e6e6e6;" : "")">
                                                            <div class="col-1">
                                                                @if(@produk.Var_Id_Media != null && @produk.Var_Id_Media != "")
                                                                {
                                                                    <img class="h-100" src="@produk.Var_Id_Media" style="" alt="#">
                                                                } 
                                                        
                                                                else
                                                                {
                                                                    <img class="h-100" src="/images/products/placeholder1.png" style="" alt="#">
                                                                }
                                                            </div>
                                                            <div class="col-9 d-flex align-items-start px-3" >
                                                                <div class="d-flex w-100 flex-column gap-2">
                                                                    <h5 style="font-size:15px;" class="line-clamp-1">
                                                                        @produk.Nama_Display
                                                                    </h5>
                                                                    <p class="variant" style="background-color: #eee;width: fit-content;padding: 1px 5px;border-radius: 0px;">
                                                                        @($"{@produk.Var_Option_Label}, {@produk.Var_Size_Label}")
                                                                    </p>
                                                                    <h5 style="font-size:15px;" class="">
                                                                        @string.Format("Rp. {0:N0}", @produk.Harga_Satuan) 
                                                                        @($" x {produk.Qty} ")
                                                                    </h5>
                                                                </div>
                                                            </div>
                                                            <div class="col-2 d-flex align-items-center justify-content-end">
                                                                <h5 style="font-size:15px;" class="d-flex line-clamp-1">
                                                                    <span style="color:#1500b2; font-weight:600;">
                                                                        @string.Format("Rp. {0:N0}", produk.Harga_Total)
                                                                    </span>
                                                                </h5>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </h2>

                                            <div class="d-flex flex-row w-100" style="background-color: #fbfbfb;">

                                                <div class="col-6 h-100" style="border-top: 1px solid #e6e6e6; border-bottom: 1px solid #e6e6e6;">
                                                    <div class="d-flex flex-row w-100" style="text-align: center">
                                                        <div class="col-6 px-3 py-2" style="border-bottom: 1px solid #e6e6e6; color: black;">
                                                            <span style="font-size:15px; font-weight:300;">
                                                                Metode Pembayaran
                                                            </span>
                                                        </div>
                                                        <div class="col-6 px-3 py-2" style="border-bottom: 1px solid #e6e6e6; color:#1500b2; font-weight:600;">
                                                            @item.Metode_Bayar
                                                        </div>
                                                    </div>

                                                    <div class="d-flex flex-row w-100" style="min-height:170px;border-right: 1px solid #e6e6e6;">
                                                        @if(@item?.Status_Order_1 == "belum bayar") 
                                                        {

                                                            <div class="col-12 px-3 py-2" style="">

                                                                @if (@item?.Metode_Bayar == "QRIS" && @item?.Status_Order_1 == "belum bayar")
                                                                {
                                                                    <div class="d-flex align-items-center justify-content-center position-relative">
                                                                        <img class="qr-payment" style="max-width:50%" src="@item?.QrBase64" alt="Alternate Text" />
                                                                        @if (@item?.Metode_Bayar == "QRIS" && @item?.Status_Order_1 == "belum bayar")
                                                                        {
                                                                            <button type="button" class="btn btn-success bg-success position-absolute" style="border-radius: 100%;height: 40px;width: 40px;padding: 0px 0px;top: 30px;left: 70px;" @onclick="@(x => DownloadImage(item))">
                                                                                <svg xmlns="http://www.w3.org/2000/svg" height="24px" style="margin-top:-4px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M480-320 280-520l56-58 104 104v-326h80v326l104-104 56 58-200 200ZM240-160q-33 0-56.5-23.5T160-240v-120h80v120h480v-120h80v120q0 33-23.5 56.5T720-160H240Z" /></svg>
                                                                            </button>
                                                                        }
                                                                    </div>
                                                                }
                                                                else if (@item?.Metode_Bayar != "QRIS" && @item?.Status_Order_1 == "belum bayar")
                                                                {
                                                                    @if (@item?.Metode_Bayar == "VA MANDIRI" || @item?.Metode_Bayar == "COUNTER INDOMARET")
                                                                    {
                                                                        <div class="col-12 ">
                                                                            <div class="input-group style-grup px-1 border-1 form-style position-relative pb-1 pt-3 va-box mb-0" style="border-radius:0px; max-width:100%" data-va="@item?.Payment_Number_1">
                                                                                <div readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your phone" aria-label="Search" aria-describedby="basic-addon1">
                                                                                    @item?.Payment_Number_1
                                                                                </div>
                                                                                <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">
                                                                                    @(item?.Metode_Bayar == "VA MANDIRI" ? "Biller Code" : "Payment Code")
                                                                                </label>
                                                                                <button class="copy-btn copy-btn-@item?.Payment_Number_1-code border-0 w-auto" style="border-radius: 0px;position: absolute;top: 12px;right: 15px;" type="button" aria-label="Copy VA" @onclick=@(x => clickCopy(item, $"{item?.Payment_Number_1}-code"))>Copy</button>
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-12 mt-2">
                                                                            <div class="input-group style-grup px-1 border-1 form-style position-relative pb-1 pt-3 va-box mb-0" style="border-radius:0px; max-width:100%" data-va="@item?.Payment_Number_2">
                                                                                <div readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your phone" aria-label="Search" aria-describedby="basic-addon1">
                                                                                    @item?.Payment_Number_2
                                                                                </div>
                                                                                <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">
                                                                                    @(item?.Metode_Bayar == "VA MANDIRI" ? "Bill Key" : "Merchant Id")
                                                                                </label>

                                                                                <button class="copy-btn copy-btn-@item?.Payment_Number_2-code border-0 w-auto" style="border-radius: 0px;position: absolute;top: 12px;right: 15px;" type="button" aria-label="Copy VA" @onclick=@(x => clickCopy(item, $"{item?.Payment_Number_2}-code"))>Copy</button>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="col-12">
                                                                            <div class="input-group style-grup px-1 border-1 form-style position-relative pb-1 pt-3 va-box mb-0" style="border-radius:0px; max-width:100%" data-va="@item?.Payment_Number_1">
                                                                                <div readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your phone" aria-label="Search" aria-describedby="basic-addon1">
                                                                                    @item?.Payment_Number_1
                                                                                </div>
                                                                                <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">
                                                                                    Virtual Account
                                                                                </label>
                                                                                <button class="copy-btn copy-btn-@item?.Payment_Number_1-code border-0 w-auto" style="border-radius: 0px;position: absolute;top: 12px;right: 15px;" type="button" aria-label="Copy VA" @onclick=@(x => clickCopy(item, $"{item?.Payment_Number_1}-code"))>Copy</button>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                }

                                                            
                                                            </div>

                                                        }
                                                    </div>

                                                </div>

                                                <div class="col-6" style="border-bottom: 1px solid #e6e6e6; text-align:right">
                                                    <div class="d-flex flex-row w-100" style="">
                                                        <div class="col-6 px-3 py-2" style="border: 1px solid #e6e6e6; border-right:0px; border-bottom:0px; color: black;">
                                                            <span style="font-size:15px; font-weight:300;">
                                                                Subtotal Barang
                                                            </span>
                                                        </div>
                                                        <div class="col-6 px-3 py-2" style="border: 1px solid #e6e6e6; border-right:0px; border-bottom:0px;">
                                                            @string.Format("Rp. {0:N0}", item.Subtotal - (ScopedDataServices?.ScopedData?.DataPesananDetail?.Data.Biaya.Where(x => x.No_Bukti == item.No_Bukti)?.ToList().Sum(x => x.Harga_Total) ?? 0))
                                                        </div>
                                                    </div>
                                                    <div class="d-flex flex-row w-100" style="">
                                                        <div class="col-6 px-3 py-2" style="border-top: 1px solid #e6e6e6; color: black;">
                                                            <span style="font-size:15px; font-weight:300;">
                                                                Biaya Pengiriman
                                                            </span>
                                                        </div>
                                                        <div class="col-6 px-3 py-2" style="border: 1px solid #e6e6e6; border-right:0px; border-bottom:0px;">
                                                            @string.Format("Rp. {0:N0}", ScopedDataServices?.ScopedData?.DataPesananDetail?.Data.Biaya.FirstOrDefault(x => x.Jenis_Item.ToLower() == "ongkir")?.Harga_Total)
                                                        </div>
                                                    </div>
                                                    <div class="d-flex flex-row w-100" style="">
                                                        <div class="col-6 px-3 py-2" style="border-top: 1px solid #e6e6e6; color: black;">
                                                            <span style="font-size:15px; font-weight:300;">
                                                                Biaya Layanan
                                                            </span>
                                                        </div>
                                                        <div class="col-6 px-3 py-2" style="border: 1px solid #e6e6e6; border-right:0px; border-bottom:0px;">
                                                            @string.Format("Rp. {0:N0}", ScopedDataServices?.ScopedData?.DataPesananDetail?.Data.Biaya.FirstOrDefault(x => x.Jenis_Item.ToLower() == "layanan")?.Harga_Total)
                                                        </div>
                                                    </div>
                                                    @if (item?.Incl_PPN == false)
                                                    {
                                                        <div class="d-flex flex-row w-100" style="">
                                                            <div class="col-6 px-3 py-2" style="border-top: 1px solid #e6e6e6; color: black;">
                                                                <span style="font-size:15px; font-weight:300;">
                                                                    PPN (@item.PPN%)
                                                                </span>
                                                            </div>
                                                            <div class="col-6 px-3 py-2" style="border: 1px solid #e6e6e6; border-right:0px; border-bottom:0px;">
                                                                item.Tot_PPN
                                                            </div>
                                                        </div>
                                                    }
                                                    <div class="d-flex flex-row w-100" style="">
                                                        <div class="col-6 px-3 py-2" style="border-top: 1px solid #e6e6e6; color: black;">
                                                            <span style="font-size:15px; font-weight:300;">
                                                                Total Pesanan
                                                            </span>
                                                        </div>
                                                        <div class="col-6 px-3 py-2" style="border: 1px solid #e6e6e6; border-right:0px; border-bottom:0px;">
                                                            <span style="font-size:20px; color:#1500b2; font-weight:700;" class="d-lg-inline d-none">
                                                                @string.Format("Rp. {0:N0}", item.Grand_Total)
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            
                                            </div>
                                                                            
                                            <div class="d-flex flex-row justify-content-between w-100 pt-3 pb-4" style="background-color: white; border-bottom: 1px solid #e6e6e6;">
                                                <div class="col-12 d-flex align-items-start px-3" >
                                                    <div class="d-flex w-100 flex-row align-items-end justify-content-end gap-3">
                                                        <button type="button" @onclick="@( x => BatalkanPesanan(item))" class="btn btn-danger bg-danger px-2" style="font-weight:500; font-size:15px; z-index:0; letter-spacing:-0.5px; width:fit-content;border-radius:0px;" data-bs-toggle="modal" data-bs-target="#staticBackdrop4">
                                                            <span class="position-relative">Batalkan Pesanan</span>
                                                        </button>
                                                        <button @onclick="@( x => GantiMethod(item))" class="btn none-accord btn-primary bg-primary" style="height: 45px !important;border-radius: 0px !important;font-size: 13px !important;padding: 0px 14px !important;" data-bs-toggle="modal" data-bs-target="#staticBackdrop3" type="button">
                                                            Ganti Pembayaran
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        
                                        </div>
                                    }

                                </div>

                            </div>
                        </div>
                    </div>
                } else
                {
                    <div class=" w-100 d-flex justify-content-center align-items-center" style="height: 30rem;margin-bottom: 10rem;background-color: #f5f5f5;margin-top: 10px" >
                        <h5 style="font-size:1rem; color:lightgray; text-decoration:underline" >Tidak Ada Transaksi</h5>
                    </div>
                }
            }

        </div>
    </div>
</div>