                                                                        <ul>
                                                                            @foreach (var brand in Navbar?.Brand)
                                                                            {
                                                                                    <li @onclick=@( x => searchCombo(Navbar, brand, null) ) class="py-2" style="" >
                                                                                    <label style="display: flex;width: 100%;cursor: pointer;">
                                                                                        <span class="" style="font-size:20px; font-weight:400;" >
                                                                                            @brand.Nama_Brand
                                                                                        </span>
                                                                                    </label>
                                                                                </li>
                                                                            }
                                                                        </ul>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </li>

                                                        <li class="py-2" style="" >
                                                            <label @onclick=@(() => ShowNavbar($"{Navbar?.Nav_Type}-kategori-item", true) ) style="display: flex;width: 100%;align-items: center;justify-content: space-between;cursor: pointer;">
                                                                <span class="" style="font-size:20px; font-weight:400;" >Kategori</span>
                                                                <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z"/></svg>
                                                            </label>
                                                            <div class="display-info @($"{Navbar?.Nav_Type}-kategori-item")" style="z-index:40; height:100%; top:0px" >
                                                                
                                                                <div class="py-2 px-3 back-nav-phone" style="" >
                                                                    <label @onclick=@(() => ShowNavbar($"{Navbar?.Nav_Type}-kategori-item", false) ) style="display: flex;width: 100%;cursor: pointer;align-items: center;border-bottom: 1px solid #dee2e6;color: darkgray;">
                                                                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z"/></svg>
                                                                        <span class="ms-3" style="font-size:20px; font-weight:400;" >Kategori</span>
                                                                    </label>
                                                                </div>

                                                                <div class="row px-0">
                                                                    <div class="col-12 px-0">
                                                                        <ul>
                                                                            @foreach (var kategori in Navbar?.Kategori)
                                                                            {
                                                                                <li @onclick=@( x => searchCombo(Navbar, null, kategori) ) class="py-2" style="" >
                                                                                    <label style="display: flex;width: 100%;cursor: pointer;">
                                                                                        <span class="" style="font-size:20px; font-weight:400;" >@kategori.Nama_Kategori</span>
                                                                                    </label>
                                                                                </li>
                                                                            }
                                                                        </ul>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </li>
                                               
                                                    </ul>
                                            
                                                </div>
                                        
                                            </div>
                                        
                                            
                                            <div class="row pt-4 px-4">

                                                @foreach (var dataProduk in Navbar?.Produk)
                                                {
                                                    <div class="col-12">
                                                        <!-- Start Single Product -->
                                                        <div class="single-product">
                                                            <div class="product-image">
                                                                @if (dataProduk.MediaUrls.Count() >= 2)
                                                                {
                                                                    <img src="@(dataProduk.MediaUrls[0]?.Id_Media == null || dataProduk.MediaUrls[0]?.Id_Media == "" ? "/images/products/placeholder1.png" : dataProduk.MediaUrls[0]?.Id_Media)" alt="@dataProduk.Nama_Display">
                                                                    <img class="img2" src="@(dataProduk.MediaUrls[1]?.Id_Media == null || dataProduk.MediaUrls[1]?.Id_Media == "" ? "/images/products/placeholder1.png" : dataProduk.MediaUrls[1]?.Id_Media)" alt="@dataProduk.Nama_Display">
                                                                }
                                                                else if (dataProduk.MediaUrls.Count() == 1)
                                                                {
                                                                    <img src="@(dataProduk.MediaUrls[0]?.Id_Media == null || dataProduk.MediaUrls[0]?.Id_Media == "" ? "/images/products/placeholder1.png" : dataProduk.MediaUrls[0]?.Id_Media)" alt="@dataProduk.Nama_Display">
                                                                }
                                                                else
                                                                {
                                                                    <img src="/images/products/placeholder1.png" alt="@dataProduk.Nama_Display">
                                                                }

                                                                @if (dataProduk.Diskon1 != null || dataProduk.Diskon1 >= 1)
                                                                {
                                                                    <span class="sale-tag">-@dataProduk.Diskon1.ToString()%</span>
                                                                }

                                                                @if (dataProduk.Tgl_Created != null && (DateTime.Now - dataProduk.Tgl_Created).TotalDays <= 3)
                                                                {
                                                                    <span class="new-tag">New</span>
                                                                }
                                                            </div>
                                                            <div class="product-info">
                                                                <h4 class="title">
                                                                    <NavLink style="cursor:pointer; display:inline-block;max-height: 90px;overflow: hidden;text-overflow: ellipsis;" @onclick=@(() => NavigateToDetailProduk(dataProduk.No_Id))>
                                                                        <p class="line-clamp-2 underline-anim">
                                                                            @dataProduk.Nama_Display
                                                                        </p>
                                                                    </NavLink>
                                                                </h4>
                                                                @* <ul class="review">
                                                                    <li><i class="lni lni-star-filled"></i></li>
                                                                    <li><i class="lni lni-star-filled"></i></li>
                                                                    <li><i class="lni lni-star-filled"></i></li>
                                                                    <li><i class="lni lni-star-filled"></i></li>
                                                                    <li><i class="lni lni-star"></i></li>
                                                                    <li><span>4.0 Review(s)</span></li>
                                                                </ul> *@
                                                                <div class="price">
                                                                    <span>
                                                                        @if (dataProduk.Diskon1 != null || dataProduk.Diskon1 >= 1)
                                                                        {
                                                                            @string.Format("Rp. {0:N0}", (dataProduk.Harga - ((dataProduk.Diskon1 / 100) * dataProduk.Harga)))
                                                                        } else
                                                                        {
                                                                            @string.Format("Rp. {0:N0}", dataProduk.Harga)
                                                                        }
                                                                    </span>
                                                                    @if (dataProduk.Diskon1 != null || dataProduk.Diskon1 >= 1)
                                                                    {
                                                                        <span class="discount-price">@string.Format("Rp. {0:N0}", dataProduk.Harga)</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <!-- End Single Product -->
                                                    </div>
                                                }
                                        
                                        
                                            </div>
                                        </div>


                                    </div>
                                </li>
                            }
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
           
<div class="offcanvas offcanvas-end" style="width: 500px;" tabindex="-1" id="offcanvascart" aria-labelledby="offcanvascartLabel">
    <div class="offcanvas-header">
        <h5 id="offcanvascartLabel" style="font-size: 1.5rem;font-weight: 800; position:relative">
            Keranjang
            <span class="total-items-cart">@ScopedDataServices?.ScopedData?.ListDataCart.Count()</span>
        </h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="row" style="height:100%;">
            <div class="col-12 col-data" style="display: flex;flex-direction: column;justify-content: space-between;">
                            
                <ul class="shopping-list">
                    @foreach(var cart in ScopedDataServices?.ScopedData?.ListDataCart)
                    {
                        <li class="flex-wrap pb-0">
                            <div class="cart-img-head d-flex flex-row gap-3" >
                                @if(cart.Id_Media != null && cart.Id_Media != "")
                                {
                                    <img class="cart-img" src="@cart.Id_Media" style="width:33%; margin-right:0px;" alt="#">
                                } else
                                {
                                    <div style="display:flex; align-items:center;justify-content:center; width:33%; height: 80px; border-radius:5px; background-color:lightgray; color:dimgrey">
                                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M73-889 889-73l-57 57-104-104H200q-33 0-56.5-23.5T120-200v-528L16-832l57-57Zm287 447L200-282v82h448L544-304l-22 24-162-162ZM200-648v252l126-126-126-126Zm36-192h524q33 0 56.5 23.5T840-760v524l-80-80v-234L650-426l-57-57 167-187v-90H316l-80-80Zm357 357Zm-158 70ZM326-522Zm34 80Zm176-98Z"/></svg>
                                    </div>
                                }
                                <div class="d-flex flex-column justify-content-center h-100" style="gap:5px; width:90%">
                                    <h4>
                                        <a href="javascript:void(0)" class="line-clamp-1" style="font-size:15px">
                                            @(cart.Nama_Display)
                                        </a>
                                    </h4>
                                    <p class="variant" style="background-color: #eee;width: fit-content;padding: 1px 5px;border-radius: 0px;">
                                        @($"{cart.Option_Label}, {cart.Size_Label}")
                                    </p>
                                    <p class="quantity">
                                        <span class="amount" style="font-size:16px; font-weight:600;">@string.Format("Rp. {0:N0}", cart.Harga)</span>
                                    </p>
                                </div>
                            </div>

                            <div class="content content-qty">
                                <div style="display: flex;justify-content:space-between;flex-direction: row-reverse;width:80%;">
                                    <a @onclick=@(() => deleteItemCart(cart)) class="hapus-card-item" style="cursor:pointer;" title="Remove this item">
                                        @if(loadProses)
                                        {
                                            <div class="spinner-border spinner-border-sm" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        } else
                                        {
                                            <span>
                                                <svg xmlns="http://www.w3.org/2000/svg" height="25px" viewBox="0 -960 960 960" width="25px" fill="currentColor">
                                                    <path d="M312-144q-29.7 0-50.85-21.15Q240-186.3 240-216v-480h-48v-72h192v-48h192v48h192v72h-48v479.57Q720-186 698.85-165T648-144H312Zm336-552H312v480h336v-480ZM384-288h72v-336h-72v336Zm120 0h72v-336h-72v336ZM312-696v480-480Z" />
                                                </svg>
                                            </span>
                                        }
                                    </a>
                                    <label class="custom-checkbox">
                                        <input type="checkbox" checked="@cart.SelectCart" @onchange="(e) => SelectItemCart(cart)">
                                        <span></span>
                                    </label>
                                </div>
                                <div class="qty-box" style="width: 80%;height: 34px;padding: 21px 5px;gap: 8px;">
                                    <button style="font-size: 15px;" @onclick="() => Decrease(cart.Id_Cart)">–</button>
                                    <span style="font-size: 15px;height: 100%;display: flex;align-items: center;">@cart.Qty</span>
                                    <button style="font-size: 20px;" @onclick="() => Increase(cart.Id_Cart)">+</button>
                                </div>
                            </div>

                            <div class="w-100 pt-2 pb-2">
                                @if (cart.Show_Min_Order)
                                {
                                    <span class="text-danger" style="font-size: 13px; font-weight: 700;">
                                        *Minimal order @cart?.Min_Order item
                                    </span>
                                }

                                @if (cart.Show_Max_Order)
                                {
                                    <span class="text-danger" style="font-size: 13px; font-weight: 700;">
                                        *Maximal order @cart?.Stock item
                                    </span>
                                }

                                @if (cart.Show_Add_Product)
                                {
                                    <span class="text-danger" style="font-size: 13px; font-weight: 700;">
                                        *Produk gagal ditambahkan
                                    </span>
                                }
                            </div>
                        </li>
                    }
                            
                    @if(ScopedDataServices?.ScopedData?.ListDataCart.Count() <= 0)
                    {
                        <div class="d-flex flex-column align-items-center mt-4 py-5" style="color:#6b7280">
                            <svg xmlns="http://www.w3.org/2000/svg" height="2rem" viewBox="0 -960 960 960" width="2rem" class="mb-3" fill="currentColor">
                                <path d="m634-440-81-80h69l110-200H353l-80-80h525q23 0 35.5 19.5t.5 42.5L692-482q-11 20-28 31t-30 11ZM280-80q-33 0-56.5-23.5T200-160q0-33 23.5-56.5T280-240q33 0 56.5 23.5T360-160q0 33-23.5 56.5T280-80Zm540 52L566-280H304q-44 0-67-37.5t-3-78.5l42-86-72-162L28-820l56-56L876-84l-56 56ZM486-360l-80-80h-62l-40 80h182Zm136-160h-69 69Zm58 440q-33 0-56.5-23.5T600-160q0-33 23.5-56.5T680-240q33 0 56.5 23.5T760-160q0 33-23.5 56.5T680-80Z"/>
                            </svg>
                            <h5 style="color:#6b7280">Your cart is currently empty.</h5>
                        </div>
                    }

                </ul>
                            
                @if(ScopedDataServices?.ScopedData?.ListDataCart.Count() >= 1)
                {
                    <div class="bottom" style="border-top:1px solid #e6e6e6;padding-top: 10px;">
                    <div class="total" >
                        <span>Total</span>
                        @if(loadProsesNetto)
                        {
                            <div class="spinner-border" style="width: 0.8rem;height: 0.8rem; border: .15em solid currentColor;" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        } else
                        {
                            <span class="total-amount">
                                @string.Format("Rp. {0:N0}", nettoKeranjang)
                            </span>
                        }
                    </div>
                    <div style="display:flex; flex-direction:row; gap:10px;">
                        <div class="button" style="width:40%">
                            <NavLink @onclick="@(e => NavigateToHome("cart-page/keranjang"))" class="btn animate animate-view" style="border-radius: 0px;display: flex;align-items: center;gap: 4px;">
                                Lihat
                                <i class="lni lni-cart-1 mt-0"></i>
                            </NavLink>
                        </div>
                        <div class="button" style="width:60%;">
                            <NavLink @onclick="@(e => CheckoutCart())" class="btn animate" style="border-radius:0px;">Checkout</NavLink>
                        </div>
                    </div>
                </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade review-modal" id="exampleModalLogout" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered px" style="max-width:480px;">
        <div class="modal-content" style="border-radius: 0px;">
            <div class="modal-header justify-content-end d-flex border-bottom-0 pb-0 pt-3">
                <button type="button" class="btn-close m-0" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-0 px-3">
                <div class="row px-3">
                    <div class="col-12">
                        <p style="font-size:18px; font-weight:400; letter-spacing:-1px; margin-top: -15px; width:fit-content" class="mb-3">
                            Yakin berhenti belanja dan keluar?
                        </p>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-center button border-top-0 pt-2 px-5">
                <button type="button" @onclick=@(() => Logout()) class="btn-slide" style="font-weight:500; font-size:15px; z-index:0; letter-spacing:-0.5px; width:fit-content;">
                    <span class="position-relative">Keluar</span>
                </button>
            </div>
        </div>
    </div>
</div>


