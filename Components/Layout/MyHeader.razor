<div class="offcanvas offcanvas-end" style="width: 500px;" tabindex="-1" id="offcanvascart" aria-labelledby="offcanvascartLabel">
    <div class="offcanvas-header">
        <h5 id="offcanvascartLabel" style="font-size: 1.5rem;font-weight: 800; position:relative">
            Keranjang
            <span class="total-items-cart">@ScopedDataServices?.ScopedData?.ListDataCart.Count()</span>
        </h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body py-0">
        <div class="row" style="height:100%;">
            <div class="col-12 col-data px-0 h-100" style="display: flex;flex-direction: column;justify-content: space-between;">
                            
                <ul class="shopping-list p-0 gap-0" style="height:100%; max-height:unset;">

                    @if(ScopedDataServices?.ScopedData?.ListDataCart.Count() >= 0)
                    {
                        <li class="flex-wrap pb-3 px-3" style="background-color:white; gap: 10px;align-items: center;justify-content: flex-start;">
                            <label class="custom-checkbox d-flex">
                                <input type="checkbox" checked=@checkAll @onchange=@( e => checkAllItem(e) ) >
                                <span></span>
                            </label>
                            <h5 style="font-size: 14px">Pilih Semua</h5>
                        </li>
                    }



                    @foreach(var cart in ScopedDataServices?.ScopedData?.ListDataCart)
                    {
                        <li class="flex-wrap py-3 px-3" style=@(cart.Qty < cart.Min_Order || cart.Qty > cart.Stock ? "background-color:whitesmoke" : "background-color:white")>
                            <div class="cart-img-head d-flex flex-row gap-3" >
                                @if(cart.Id_Media != null && cart.Id_Media != "")
                                {
                                    <img class="cart-img" src="@cart.Id_Media" style="width:33%; margin-right:0px;" alt="#">
                                } else
                                {
                                    <img class="cart-img" src="/images/products/placeholder1.png" style="width:33%; margin-right:0px;" alt="#">
                                }
                                <div class="d-flex flex-column justify-content-center h-100" style="gap:5px; width:90%">
                                    <h4>
                                        <a @onclick=@(() => NavigateToDetailProduk(cart.Id_Produk)) class="line-clamp-1" style="font-size:15px; cursor:pointer">
                                            @(cart.Nama_Display)
                                        </a>
                                    </h4>
                                    <p class="variant" style="background-color: #eee;width: fit-content;padding: 1px 5px;border-radius: 0px;">
                                        @($"{cart.Option_Label}, {cart.Size_Label}")
                                    </p>
                                    <p class="quantity">
                                        <span class="amount" style="font-size:16px; font-weight:600;">@string.Format("Rp. {0:N0}", (cart?.Harga - (cart?.Harga * (cart?.Diskon1 / 100))))</span>
                                    </p>
                                </div>
                            </div>

                            <div class="content content-qty">
                                <div style="display: flex;justify-content:space-between;flex-direction: row-reverse;width:80%;">
                                    <a @onclick=@(() => deleteItemCart(cart)) class="hapus-card-item" style="cursor:pointer;" title="Remove this item">
                                        @if(loadProses)
                                        {
                                            <div class="spinner-border spinner-border-sm" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        } else
                                        {
                                            <span>
                                                <svg xmlns="http://www.w3.org/2000/svg" height="25px" viewBox="0 -960 960 960" width="25px" fill="currentColor">
                                                    <path d="M312-144q-29.7 0-50.85-21.15Q240-186.3 240-216v-480h-48v-72h192v-48h192v48h192v72h-48v479.57Q720-186 698.85-165T648-144H312Zm336-552H312v480h336v-480ZM384-288h72v-336h-72v336Zm120 0h72v-336h-72v336ZM312-696v480-480Z" />
                                                </svg>
                                            </span>
                                        }
                                    </a>
                                    <label class="custom-checkbox">
                                        <input type="checkbox" checked="@cart.SelectCart" @onchange="(e) => SelectItemCart(cart)">
                                        <span></span>
                                    </label>
                                </div>
                                <div class="qty-box" style="width: 80%;height: 34px;padding: 21px 5px;gap: 8px;">
                                    <button disabled=@(cart.Show_Min_Order || cart.Qty <= cart.Min_Order) style="font-size: 15px; @(cart.Show_Min_Order || cart.Qty <= cart.Min_Order ? "cursor:not-allowed" : "") " @onclick="() => Decrease(cart.Id_Cart)">–</button>
                                    <span style="font-size: 15px;height: 100%;display: flex;align-items: center;">@cart.Qty</span>
                                    <button disabled=@(cart.Show_Max_Order || cart.Qty >= cart.Stock) style="font-size: 20px; @(cart.Show_Max_Order || cart.Qty >= cart.Stock ? "cursor:not-allowed" : "") " @onclick="() => Increase(cart.Id_Cart)">+</button>
                                </div>
                            </div>

                            <div class="w-100">
                                @if (cart.Show_Min_Order || cart.Qty < cart.Min_Order)
                                {
                                    <span class="text-danger pt-2 pb-0" style="font-size: 13px; font-weight: 700;">
                                        *Minimal order @cart?.Min_Order item
                                    </span>
                                }

                                @if (cart.Show_Max_Order || cart.Qty > cart.Stock)
                                {
                                    <span class="text-danger pt-2 pb-0" style="font-size: 13px; font-weight: 700;">
                                        *Maximal order @cart?.Stock item
                                    </span>
                                }

                                @if (cart.Show_Add_Product)
                                {
                                    <span class="text-danger pt-2 pb-0" style="font-size: 13px; font-weight: 700;">
                                        *Produk gagal ditambahkan
                                    </span>
                                }

                            </div>
                        </li>
                    }
                            
                    @if(ScopedDataServices?.ScopedData?.ListDataCart.Count() <= 0)
                    {
                        <div class="d-flex flex-column align-items-center mt-4 py-5" style="color:#6b7280">
                            <svg xmlns="http://www.w3.org/2000/svg" height="2rem" viewBox="0 -960 960 960" width="2rem" class="mb-3" fill="currentColor">
                                <path d="m634-440-81-80h69l110-200H353l-80-80h525q23 0 35.5 19.5t.5 42.5L692-482q-11 20-28 31t-30 11ZM280-80q-33 0-56.5-23.5T200-160q0-33 23.5-56.5T280-240q33 0 56.5 23.5T360-160q0 33-23.5 56.5T280-80Zm540 52L566-280H304q-44 0-67-37.5t-3-78.5l42-86-72-162L28-820l56-56L876-84l-56 56ZM486-360l-80-80h-62l-40 80h182Zm136-160h-69 69Zm58 440q-33 0-56.5-23.5T600-160q0-33 23.5-56.5T680-240q33 0 56.5 23.5T760-160q0 33-23.5 56.5T680-80Z"/>
                            </svg>
                            <h5 style="color:#6b7280">Keranjang Anda saat ini kosong.</h5>
                        </div>
                    }

                </ul>
            </div>
        </div>
    </div>
    <div class="offcanvas-header pb-3 pt-0" style="align-items:normal; width:100%;">
        @if(ScopedDataServices?.ScopedData?.ListDataCart.Count() >= 1)
        {
            <div class="bottom px-3 w-100 pt-3" style="border-top:1px solid #e6e6e6;height:15%;">
                <div class="total" >
                    <span>Total</span>
                    @if(loadProsesNetto)
                    {
                        <div class="spinner-border" style="width: 0.8rem;height: 0.8rem; border: .15em solid currentColor;" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    } else
                    {
                        <span class="total-amount">
                            @string.Format("Rp. {0:N0}", nettoKeranjang)
                        </span>
                    }
                </div>
                <div style="display:flex; flex-direction:row; gap:10px;">
                    <div class="button" style="width:40%">
                        <NavLink @onclick="@(e => NavigateToHome("cart-page/keranjang"))" class="btn animate animate-view" style="border-radius: 0px;display: flex;align-items: center;gap: 4px;">
                            Lihat
                            <i class="lni lni-cart-1 mt-0"></i>
                        </NavLink>
                    </div>
                    <div class="button"  style="width:60%; @(ScopedDataServices?.ScopedData?.ListDataCart.Where(x => x.SelectCart).FirstOrDefault( cart => cart.Qty < cart.Min_Order || cart.Qty > cart.Stock ) != null || ScopedDataServices?.ScopedData?.ListDataCart.Where(x => x.SelectCart)?.Count() <= 0 ? "cursor:not-allowed" : "")">
                        <button @onclick="@(e => CheckoutCart())" class="btn animate" disabled="@( ScopedDataServices?.ScopedData?.ListDataCart.Where(x => x.SelectCart).FirstOrDefault( cart => cart.Qty < cart.Min_Order || cart.Qty > cart.Stock ) != null || ScopedDataServices?.ScopedData?.ListDataCart.Where(x => x.SelectCart)?.Count() <= 0 ? true : false)"  style="border-radius:0px;" >Bayar Sekarang</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

