<div class="col-12 mt-4 pt-5">
    <div class="section-title mb-1 pt-5">
        <h2>You may also like</h2>
    </div>
</div>

<!-- Start Trending Product Area -->
<section class="trending-product section pt-3">
    <div class="container-fluid">
        <div class="row px-0 px-lg-3 px-xl-4 px-xxl-10"> 

            @if (loadContent)
            {
                @for (var i = 0; i <= 11; i++)
                {
                    <div class="col-lg-3 col-md-4 col-6 col-xxl-2 pt-2 pb-2">
                        <div class="card p-3 border-0" style="border-radius:0px;" aria-busy="true">
                            <div class="skeleton skeleton-rect mb-3"></div>
                            <div class="d-flex align-items-center justify-content-between">
                                <div style="flex:1" class="d-flex flex-column align-items-center">
                                    <div class="skeleton skeleton-title mb-2" style="width:90%"></div>
                                    <div class="skeleton skeleton-subtitle mb-2" style="width:50%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            } 

            @foreach (var dataProduk in dataSourch?.ListDataProduk)
            {
                <div class="col-lg-3 col-md-4 col-6 col-xxl-2 pt-2 pb-2 product">
                    <!-- Start Single Product -->
                    <div class="single-product">
                        <div class="product-image">
                            @if (dataProduk.MediaUrls.Count() >= 2)
                            {
                                <img src="@dataProduk.MediaUrls[0]?.Id_Media" alt="@dataProduk.Nama_Display">
                                <img class="img2" src="@dataProduk.MediaUrls[1]?.Id_Media" alt="@dataProduk.Nama_Display">
                            } else if (dataProduk.MediaUrls.Count() == 1)
                            {
                                <img src="@dataProduk.MediaUrls[0]?.Id_Media" alt="@dataProduk.Nama_Display">
                            } else
                            {
                                <img src="images/products/placeholder.jpg" alt="@dataProduk.Nama_Display">
                            }

                            @if (dataProduk.Diskon1 != null || dataProduk.Diskon1 >= 1)
                            {
                                <span class="sale-tag">-@dataProduk.Diskon1.ToString()%</span>
                            }
                            @if (dataProduk.Tgl_Created != null && (DateTime.Now - dataProduk.Tgl_Created).TotalDays <= 3)
                            {
                                <span class="new-tag">New</span>
                            }

                            <div class="button">
                                <button @onclick="@(e => selectProduk(dataProduk.No_Id))" data-bs-toggle="offcanvas" data-bs-target="#offdetailprod" aria-controls="offdetailprod" class="btn d-none d-lg-flex">Tambahkan <i class="lni lni-cart-1 ms-3"></i></button>
                            </div>

                            <div class="button-search-produk">
                                <button @onclick="@(e => selectProduk(dataProduk.No_Id))" data-bs-toggle="offcanvas" data-bs-target="#offdetailprod" aria-controls="offdetailprod" class="btn">
                                    <i class="lni lni-search-1 d-none d-lg-flex"></i>
                                    <i class="lni lni-cart-1 d-flex d-lg-none"></i>
                                </button>
                            </div>
                        </div>
                        <div class="product-info">
                            <h4 class="title">
                                <NavLink style="cursor:pointer;" @onclick="@(e => NavigateToDetailProduk(dataProduk.No_Id))">
                                    <p class="line-clamp-2 underline-anim">
                                        @dataProduk.Nama_Display
                                    </p>
                                </NavLink>
                            </h4>
                            @* <ul class="review">
                            <li><i class="lni lni-star-filled"></i></li>
                            <li><i class="lni lni-star-filled"></i></li>
                            <li><i class="lni lni-star-filled"></i></li>
                            <li><i class="lni lni-star-filled"></i></li>
                            <li><i class="lni lni-star"></i></li>
                            <li><span>4.0 Review(s)</span></li>
                        </ul> *@
                            <div class="price">
                                <span>
                                    @if (dataProduk.Diskon1 != null || dataProduk.Diskon1 >= 1)
                                    {
                                        @string.Format("Rp. {0:N0}", (dataProduk.Harga - ((dataProduk.Diskon1 / 100) * dataProduk.Harga)))
                                    } else
                                    {
                                        @string.Format("Rp. {0:N0}", dataProduk.Harga)
                                    }
                                </span>
                                @if (dataProduk.Diskon1 != null || dataProduk.Diskon1 >= 1)
                                {
                                    <span class="discount-price">@string.Format("Rp. {0:N0}", dataProduk.Harga)</span>
                                }
                            </div>
                        </div>
                    </div>
                    <!-- End Single Product -->
                </div>
            }    
        
        </div>
    </div>
</section>
<!-- End Trending Product Area -->


<PacificWeb.Components.Sections.SelectProduk dataSourch=@dataSourch Quantity=DataProdukModal.Min_Order DataProduk="DataProdukModal" header_page="header_page" />

@if (dataSourch?.DataProduk != null && dataSourch?.DataProduk?.No_Id != "")
{
    <div id="flayer" class="d-flex flex-row px-2 py-1 px-xl-5">
        <div class="col-12 col-md-5 d-none d-md-flex">
            <Image Src="@dataSourch?.DataProduk?.MediaUrls.FirstOrDefault()?.Id_Media" Class="h-100 w-auto" />

            <div class="d-flex flex-column justify-content-center gap-1">

                <h5 class="title" style="font-size: 0.9rem;font-weight: 400;letter-spacing: -0.5px;">@dataSourch?.DataProduk?.Nama_Display</h5>

                <p style="color:black;font-weight: 700;" class="d-flex align-items-center">
                    @if (dataSourch?.DataProduk?.Diskon1 != null || dataSourch?.DataProduk?.Diskon1 >= 1)
                    {
                        <span class="text-primary">
                            @string.Format("Rp. {0:N0}", (dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Harga - ((dataSourch?.DataProduk?.Diskon1 / 100) * dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Harga)))
                        </span>
                    }
                    else
                    {
                        <span class="text-primary" >
                            @string.Format("Rp. {0:N0}", dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Harga)
                        </span>
                    }

                    @if (dataSourch?.DataProduk?.Diskon1 != null || dataSourch?.DataProduk?.Diskon1 >= 1) 
                    {
                        <span style="display: inline-block; margin-left: 15px; color: #888; text-decoration: line-through; font-size: 12px; font-weight: 400; font-style:italic" >
                            @string.Format("Rp. {0:N0}", dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Harga)
                        </span>
                    }
                </p>

            </div>
        </div>

        <div class="col-12 col-md-7 d-flex">
            <div class="bottom-content d-flex align-items-center justify-content-center justify-content-lg-end" style="width: 100%;">
                <div class="row px-0 px-lg-3 align-items-end justify-content-center justify-content-lg-end row-style d-flex w-100" style="">
                
                    <div class="col-4 col-xl-3 px-1 px-lg-2">
                        <div class="btn-group w-100">
                            <button class="dropdown-toggle btn-slide px-0 justify-content-around" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span style="width: 54%;overflow: hidden;text-overflow: ellipsis;">
                                    @dataSourch?.DataProduk?.Option_Default
                                </span>
                                <i class="lni lni-chevron-up" style="transform: rotateZ(180deg);font-size: 18px;font-weight: 500;"></i>
                            </button>
                            <ul class="dropdown-menu">
                                @foreach (var Option in dataSourch?.DataProduk?.Options)
                                    {
                                        <li class="style-drop">
                                            <button 
                                                type="button" 
                                                class="dropdown-item @(dataSourch?.DataProduk?.Id_Option_Default == Option.Option_Id ? "active" : "") d-flex flex-row align-items-center gap-2"
                                                disabled="@(dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == Option.Option_Id && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Stock >= dataSourch?.DataProduk?.Min_Order ? false : true)"
                                                @onclick="() => OnVariantChanged(Option.Option_Id)">
                                                <Image Style="width:50px; height:50px;" Src="@Option.MediaUrl?.Id_Media" />
                                                @Option.Option_Label
                                            </button>
                                        </li>
                                    }
                            </ul>
                        </div>
                    </div>
                    <div class="col-3 col-xl-3 px-1 px-lg-2">
                        <div class="btn-group w-100">
                            <button class="dropdown-toggle btn-slide px-0 justify-content-around" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span style="width: 54%;overflow: hidden;text-overflow: ellipsis;">
                                    @dataSourch?.DataProduk?.Size_Default
                                </span>
                                <i class="lni lni-chevron-up" style="transform: rotateZ(180deg);font-size: 18px;font-weight: 500;" ></i>
                            </button>
                            <ul class="dropdown-menu">
                                @foreach (var size in dataSourch?.DataProduk?.Sizes)
                                {
                                    <li class="style-drop">
                                        <button 
                                            type="button"
                                            disabled="@(dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == size.Size_Id)?.Stock >= dataSourch?.DataProduk?.Min_Order ? false : true)"
                                            class="dropdown-item @(dataSourch?.DataProduk?.Id_Size_Default == size.Size_Id ? "active" : "")" 
                                            @onclick="() => OnSizeChanged(size.Size_Id)">
                                            @size.Size_Label
                                        </button>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                    <div class="col-3 d-none d-xl-flex">
                        <div class="qty-box">
                            <button @onclick="Decrease">-</button>
                            <span style="font-size:15px; color:black;">@Quantity</span>
                            <button @onclick="Increase">+</button>
                        </div>
                    </div>
                    <div class="col-5 col-lg-3 px-1 px-lg-2">
                        <div class="btn-group w-100">
                            <button class="btn-slide" @onclick=@(() => tambahKeranjang(dataSourch?.DataProduk, "detail"))  type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Tambahkan <i class="lni lni-cart-2 ms-2"></i>
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>}


