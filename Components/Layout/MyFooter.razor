<style>
    .section-footer h5 {
        font-weight: 400;
        font-size: 22px;
        letter-spacing: -0.7px;
    }
    .section-footer p {
        font-weight: 400;
        font-size: 14px;
    }
    .section-footer li {
        font-weight: 400;
        font-size: 14px;
        margin-bottom:5px;
    }
    .section-footer li {
        display:flex;
        flex-direction:row;
        gap:10px;
        align-items:center;
        justify-content:start;
    }

    .filter-content {
        border:unset;
    }

    .filter-content p {
        font-weight: 400;
        font-size: 14px;
    }
    
    label.filter-label {
        font-weight: 400;
        font-size: 18px;
        letter-spacing: -0.7px;
    }
</style>


@code {

    [Inject]
    protected IJSRuntime JSRuntime { get; set; }

    [Parameter] public SourchData dataSourch { get; set; } = null;

    public bool loadContent { get; set; } = true;
    public string MailUrl { get; set; } = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            int count = 0;
            while (dataSourch.Finised == false)
            {
                if (count >= 6)
                {
                    await Task.Delay(1000);

                    if (count >= 10)
                    {
                        await Task.Delay(1000);

                        Console.WriteLine("Gagal memuat data header & footer");

                        if (count >= 15)
                        {
                            dataSourch.Finised = true;
                        }
                    }
                } 

                else
                {
                    await Task.Delay(500);
                }

                count++;
            }

            StateHasChanged();
            loadContent = false;

            MailUrl = $"https://mail.google.com/mail/?view=cm&fs=1&to={dataSourch?.ListDataCompany?.FirstOrDefault()?.Email}&su=Permintaan%20Informasi%20Produk%20Terbaru%20%E2%80%93%20{dataSourch?.ListDataCompany?.FirstOrDefault()?.Nama_Toko}&body=Halo%20Tim%20{dataSourch?.ListDataCompany?.FirstOrDefault()?.Nama_Toko}%2C%0A%0ASaya%20tertarik%20dengan%20produk%20Anda%20dan%20ingin%20mendapatkan%20informasi%20lebih%20lanjut.%0A%0ABerikut%20detail%20permintaan%20saya%3A%0A-%20Nama%3A%20%5BNama%20Anda%5D%0A-%20Perusahaan%3A%20%5BNama%20Perusahaan%20Anda%5D%0A-%20Produk%20yang%20diminati%3A%20%5BNama%20Produk%5D%0A-%20Pertanyaan%20tambahan%3A%20%5BTuliskan%20pertanyaan%20Anda%5D%0A%0AMohon%20informasinya%20beserta%20katalog%2Fpenawaran%20harga%20jika%20memungkinkan.%0A%0ATerima%20kasih%2C%0A%5BNama%20Anda%5D%0A%5BNo.%20Telepon%5D";

            StateHasChanged();

        }
    }

}