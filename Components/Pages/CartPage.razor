@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider


@page "/cart-page/{pageTabs}"


@if(pageTabs == "keranjang"){
    <PageTitle>@ti.ToTitleCase(pageTabs)</PageTitle>
} else
{
    <PageTitle>Pesanan - @ti.ToTitleCase(pageTabs)</PageTitle>
}

<MyHeadProfile dataSourch=@dataSourch pageRoute=@pageTabs @ref="header_page"/>


<div class="tab-content mb-5" id="pills-tabContent">
    
    <div class="tab-pane fade @(pageTabs == "keranjang" ? "show active" : "")" id="pills-keranjang" role="tabpanel" aria-labelledby="pills-keranjang-tab">
        <div class="row" style="justify-content: center; margin-top: 6rem;">
            <div class="col-12">
                <div class="section-title" style="margin-bottom:0px;">
                </div>
            </div>
        </div>
        <div class="row position-relative" style="justify-content: center; margin-top: 0rem;">
            <div class="col-12 position-absolute" style="top:16px">
                <div class="section-title" style="margin-bottom:0px;">
                    <h2>Keranjang</h2>
                </div>
            </div>
        </div>
        <div class="cart-page" style="padding: 0px 20px 5rem 20px; margin-top:20px;">
            <div class="cart-container d-flex flex-xl-row flex-column">

                <div class="cart-items col-12 col-xl-8">
                    
                    <div class="py-5"></div>
                    <!-- Contoh looping item -->
                    <div class="cart-item d-none d-lg-flex" style="padding: 0px 16px;">
                        <div class="img-harga" style="width:5%">
                            <p class="item-price"></p>
                        </div>
                        <div class="img-item" style="width:45%">
                            <p class="item-price">Produk</p>
                        </div>
                        <div class="img-nama" style="width:20%">
                            <p class="item-price">Harga</p>
                        </div>
                        <div class="img-qty" style="width:25%">
                            <p class="item-price">Qty</p>
                        </div>
                        <div class="img-harga" style="width:5%">
                            <p class="item-price"></p>
                        </div>
                    </div>

                    @if (loadContent)
                    {
                        @for(var i = 0; i <= 5; i++)
                        {
                            <div class="" style="padding: 0px 20px 20px 20px; margin-top:20px;">
                                <div class="card p-3 mb-5 border-0" style="border-radius:0px;" aria-busy="true">
                                    <div class="skeleton skeleton-rect mb-3"></div>
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div style="flex:1">
                                                <div class="skeleton skeleton-title mb-2"></div>
                                                <div class="skeleton skeleton-subtitle mb-2" style="width:50%"></div>
                                        </div>
                                        <div class="ms-3">
                                            <div class="skeleton skeleton-pill"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    } else
                    {
                        @foreach (var item in dataSourch?.ListDataCart)
                        {
                            <div class="cart-item d-none d-lg-flex">
                                <div class="img-harga d-flex align-items-center gap-3" style="width:5%">
                                    <label class="custom-checkbox d-flex">
                                        <input type="checkbox" checked="@item.SelectCart" @onchange="(e) => SelectItemCart(item)">
                                        <span></span>
                                    </label>
                                </div>
                                <div class="img-item" style="width:45%">
                                    @if(item.Id_Media != null && item.Id_Media != "")
                                    {
                                        <img class="cart-img" src="@item.Id_Media" style="min-width:80px; max-width:80px; height: 80px; margin-right:0px;" alt="#">
                                    } else
                                    {
                                        <div style="display:flex; align-items:center;justify-content:center; min-width:80px; max-width:80px; height: 80px; border-radius:5px; background-color:lightgray; color:dimgrey">
                                            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M73-889 889-73l-57 57-104-104H200q-33 0-56.5-23.5T120-200v-528L16-832l57-57Zm287 447L200-282v82h448L544-304l-22 24-162-162ZM200-648v252l126-126-126-126Zm36-192h524q33 0 56.5 23.5T840-760v524l-80-80v-234L650-426l-57-57 167-187v-90H316l-80-80Zm357 357Zm-158 70ZM326-522Zm34 80Zm176-98Z"/></svg>
                                        </div>
                                    }
                                    @* <img src="@item.Id_Media" alt="@item.Nama_Display" class="item-img" /> *@
                                    <div class="item-produk d-flex flex-column justify-content-center gap-2">
                                        <h2 class="item-name">@item.Nama_Display</h2>
                                        <p class="variant" style="background-color: #eee;width: fit-content;padding: 1px 5px;border-radius: 0px;">
                                            @($"{item.Option}, {item.Size}")
                                        </p>
                                    </div>
                                </div>
                                <div class="img-nama" style="width:20%">
                                    <h2 class="item-name">@string.Format("Rp {0:N0}", item.Harga)</h2>
                                </div>
                                <div class="img-qty" style="width:25%">
                                    <div class="item-qty">
                                        <button @onclick="() => Decrease(item.Id_Cart)">–</button>
                                        <span>@item.Qty</span>
                                        <button @onclick="() => Increase(item.Id_Cart)">+</button>
                                    </div>
                                </div>
                                <div class="img-harga d-flex align-items-center gap-3" style="width:5%">
                                    <a @onclick=@(() => deleteItemCart(item)) class="hapus-card-item" style="cursor:pointer;" title="Remove this item">
                                        @if (loadProses)
                                        {
                                            <div class="spinner-border spinner-border-sm" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span>
                                                <svg xmlns="http://www.w3.org/2000/svg" height="30px" viewBox="0 -960 960 960" width="30px" fill="currentColor">
                                                    <path d="M312-144q-29.7 0-50.85-21.15Q240-186.3 240-216v-480h-48v-72h192v-48h192v48h192v72h-48v479.57Q720-186 698.85-165T648-144H312Zm336-552H312v480h336v-480ZM384-288h72v-336h-72v336Zm120 0h72v-336h-72v336ZM312-696v480-480Z"/>
                                                </svg>
                                            </span>
                                        }
                                    </a>
                                </div>
                            </div>
                        }
                    
                    
                        <div class="cart-item d-flex d-lg-none flex-column" style="padding: 0px 16px;">
                            <ul class="shopping-list w-100" style="overflow:unset; max-height: unset">
                                @foreach (var cart in dataSourch?.ListDataCart)
                                {
                                    <li>
                                        <div class="cart-img-head d-flex flex-row gap-3" >
                                            @if(cart.Id_Media != null && cart.Id_Media != "")
                                            {
                                                <img class="cart-img" src="@cart.Id_Media" style="min-width:80px; max-width:80px; height: 80px; margin-right:0px;" alt="#">
                                            } else
                                            {
                                                <div style="display:flex; align-items:center;justify-content:center; min-width:80px; max-width:80px; height: 80px; border-radius:5px; background-color:lightgray; color:dimgrey">
                                                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M73-889 889-73l-57 57-104-104H200q-33 0-56.5-23.5T120-200v-528L16-832l57-57Zm287 447L200-282v82h448L544-304l-22 24-162-162ZM200-648v252l126-126-126-126Zm36-192h524q33 0 56.5 23.5T840-760v524l-80-80v-234L650-426l-57-57 167-187v-90H316l-80-80Zm357 357Zm-158 70ZM326-522Zm34 80Zm176-98Z"/></svg>
                                                </div>
                                            }
                                            <div class="d-flex flex-column justify-content-center h-100" style="gap:5px;">
                                                <h4>
                                                    <a href="javascript:void(0)" class="line-clamp-1" style="font-size:15px">
                                                        @(cart.Nama_Display)
                                                    </a>
                                                </h4>
                                                <p class="variant" style="background-color: #eee;width: fit-content;padding: 1px 5px;border-radius: 0px;">
                                                    @($"{cart.Option}, {cart.Size}")
                                                </p>
                                                <p class="quantity">
                                                    <span class="amount" style="font-size:16px; font-weight:600;">@string.Format("Rp. {0:N0}", cart.Harga)</span>
                                                </p>
                                            </div>
                                        </div>

                                        <div class="content content-qty">
                                            <div style="display: flex;justify-content:space-between;flex-direction: row-reverse;width:80%;">
                                                <a @onclick=@(() => deleteItemCart(cart)) class="hapus-card-item" style="cursor:pointer;" title="Remove this item">
                                                    @if (loadProses)
                                                    {
                                                        <div class="spinner-border spinner-border-sm" role="status">
                                                            <span class="visually-hidden">Loading...</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span>
                                                            <svg xmlns="http://www.w3.org/2000/svg" height="25px" viewBox="0 -960 960 960" width="25px" fill="currentColor">
                                                                <path d="M312-144q-29.7 0-50.85-21.15Q240-186.3 240-216v-480h-48v-72h192v-48h192v48h192v72h-48v479.57Q720-186 698.85-165T648-144H312Zm336-552H312v480h336v-480ZM384-288h72v-336h-72v336Zm120 0h72v-336h-72v336ZM312-696v480-480Z" />
                                                            </svg>
                                                        </span>
                                                    }
                                                </a>
                                                <label class="custom-checkbox">
                                                    <input type="checkbox" checked="@cart.SelectCart" @onchange="(e) => SelectItemCart(cart)">
                                                    <span></span>
                                                </label>
                                            </div>
                                            <div class="qty-box" style="width: 80%;height: 34px;padding: 21px 5px;gap: 8px;">
                                                <button style="font-size: 15px;" @onclick="() => Decrease(cart.Id_Cart)">–</button>
                                                <span style="font-size: 15px;height: 100%;display: flex;align-items: center;">@cart.Qty</span>
                                                <button style="font-size: 20px;" @onclick="() => Increase(cart.Id_Cart)">+</button>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    
                        @if(dataSourch?.ListDataCart.Count() <= 0 && !loadContent)
                        {
                            <div class="d-flex flex-column align-items-center mt-4 py-5" style="color:#6b7280">
                                <svg xmlns="http://www.w3.org/2000/svg" height="2rem" viewBox="0 -960 960 960" width="2rem" class="mb-3" fill="currentColor">
                                    <path d="m634-440-81-80h69l110-200H353l-80-80h525q23 0 35.5 19.5t.5 42.5L692-482q-11 20-28 31t-30 11ZM280-80q-33 0-56.5-23.5T200-160q0-33 23.5-56.5T280-240q33 0 56.5 23.5T360-160q0 33-23.5 56.5T280-80Zm540 52L566-280H304q-44 0-67-37.5t-3-78.5l42-86-72-162L28-820l56-56L876-84l-56 56ZM486-360l-80-80h-62l-40 80h182Zm136-160h-69 69Zm58 440q-33 0-56.5-23.5T600-160q0-33 23.5-56.5T680-240q33 0 56.5 23.5T760-160q0 33-23.5 56.5T680-80Z"/>
                                </svg>
                                <h5 style="color:#6b7280">Your cart is currently empty.</h5>
                            </div>
                        }
                    }

                </div>

                    <aside class="order-summary col-12 col-xl-4 border-0 sticky-xl-top py-0" style="border-radius:0px;">
                        <div class="py-xl-5 py-2"></div>
                        <h2 class="summary-title">Order Summary</h2>
                        <div class="summary-line total">
                            <span>Total</span>
                            <span>@string.Format("Rp {0:N0}", nettoKeranjang)</span>
                        </div>

                        @if(dataSourch?.ListDataCart.Count() >= 1 && !loadContent)
                        {
                            <button class="btn btn-primary" @onclick=@( () => CheckoutCart()) style="border-radius:0px;">Checkout</button>
                        }
                    </aside>
            </div>
        </div>
    </div>

    <div class="tab-pane fade @(pageTabs == "belum-bayar" ? "show active" : "")" id="pills-belum-bayar" role="tabpanel" aria-labelledby="pills-belum-bayar-tab">
        <div class="row" style="justify-content: center; margin-top: 7rem;">
            <div class="col-12">
                <div class="section-title" style="margin-bottom:0px;">
                    <h2>Belum Bayar</h2>
                </div>
            </div>
        </div>

        @if (loadContent)
        {
            @for(var i = 0; i <= 5; i++)
            {
                <div class="" style="padding: 0px 20px 20px 20px; margin-top:20px;">
                    <div class="card p-3 mb-5 border-0" style="border-radius:0px;" aria-busy="true">
                        <div class="skeleton skeleton-rect mb-3"></div>
                            <div class="d-flex align-items-center justify-content-between">
                                <div style="flex:1">
                                    <div class="skeleton skeleton-title mb-2"></div>
                                    <div class="skeleton skeleton-subtitle mb-2" style="width:50%"></div>
                            </div>
                            <div class="ms-3">
                                <div class="skeleton skeleton-pill"></div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        } 
        else
        {
            @if (dataSourch?.DataPesanan?.Header.Count(x => x.Status_Order_1.ToLower() == "belum bayar") >= 1) {
                <div class="cart-page" style="padding: 0px 20px 20px 20px; margin-top:20px;">
                    <div class="cart-container p-0 px-lg-5">
                        <div class="cart-items">

                            <div class="accordion" style="gap: 15px;display: flex;flex-direction: column;" id="accordionPanelsStayOpenExample">
                      
                                @foreach (var item in dataSourch?.DataPesanan?.Header.Where(x => x.Status_Order_1.ToLower() == "belum bayar").ToList())
                                {
                                    <div class="accordion-item rounded-0">
                                        <h2 class="accordion-header rounded-0" id="panelsStayOpen-headingOne">
                                            <div class="d-flex w-100 flex-column gap-3 p-3 p-lg-4">
                                                <div class="d-flex flex-row justify-content-between gap-3 py-1 ">
                                                    <h5>
                                                        @item.No_Bukti
                                                    </h5>
                                                    <p style="color:#1500b2">
                                                        @ti.ToTitleCase(item.Status_Order_1)
                                                    </p>
                                                </div>


                                                <div class="d-flex flex-lg-row flex-column justify-content-between w-100 gap-3">
                                                    <div class="d-flex flex-col gap-3 w-100">
                                                        
                                                        @if(@dataSourch?.DataPesanan?.Items.FirstOrDefault(x => x.No_Bukti == item.No_Bukti).Var_Id_Media != null && @dataSourch?.DataPesanan?.Items.FirstOrDefault(x => x.No_Bukti == item.No_Bukti).Var_Id_Media != "")
                                                        {
                                                            <img class="cart-img img-payment" src="@dataSourch?.DataPesanan?.Items.FirstOrDefault(x => x.No_Bukti == item.No_Bukti).Var_Id_Media" style="" alt="#">
                                                        } 
                                                        
                                                        else
                                                        {
                                                            <div class="cart-img img-payment" style="display:flex; align-items:center;justify-content:center; background-color:lightgray; color:dimgrey">
                                                                <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M73-889 889-73l-57 57-104-104H200q-33 0-56.5-23.5T120-200v-528L16-832l57-57Zm287 447L200-282v82h448L544-304l-22 24-162-162ZM200-648v252l126-126-126-126Zm36-192h524q33 0 56.5 23.5T840-760v524l-80-80v-234L650-426l-57-57 167-187v-90H316l-80-80Zm357 357Zm-158 70ZM326-522Zm34 80Zm176-98Z"/></svg>
                                                            </div>
                                                        }

                                                        <div class="d-flex flex-column gap-2 w-100 justify-content-between">
                                                            <div class="d-flex flex-column gap-2">
                                                                <h5 style="font-size:15px;" class="line-clamp-1">
                                                                    @dataSourch?.DataPesanan?.Items.FirstOrDefault(x => x.No_Bukti == item.No_Bukti).Nama_Display
                                                                </h5>
                                                                <p class="variant" style="background-color: #eee;width: fit-content;padding: 1px 5px;border-radius: 0px;">
                                                                    @($"{@dataSourch?.DataPesanan?.Items.FirstOrDefault(x => x.No_Bukti == item.No_Bukti).Var_Option}, {@dataSourch?.DataPesanan?.Items.FirstOrDefault(x => x.No_Bukti == item.No_Bukti).Var_Size}")
                                                                </p>
                                                                <h5 style="font-size:15px;" class="">
                                                                    @string.Format("Rp. {0:N0}", @dataSourch?.DataPesanan?.Items.FirstOrDefault(x => x.No_Bukti == item.No_Bukti).Harga_Satuan) 
                                                                    @($" x {dataSourch?.DataPesanan?.Items.FirstOrDefault(x => x.No_Bukti == item.No_Bukti).Qty} = ")
                                                                    <span style="color:#1500b2; font-weight:700;" class="d-lg-inline d-none">
                                                                        @string.Format("Rp. {0:N0}", dataSourch?.DataPesanan?.Items.FirstOrDefault(x => x.No_Bukti == item.No_Bukti).Harga_Total)
                                                                    </span>
                                                                </h5>
                                                                <h5 style="font-size:15px;" class="d-lg-none d-flex line-clamp-1">
                                                                    <span style="color:#1500b2; font-weight:700;">
                                                                        @string.Format("Rp. {0:N0}", dataSourch?.DataPesanan?.Items.FirstOrDefault(x => x.No_Bukti == item.No_Bukti).Harga_Total)
                                                                    </span>
                                                                </h5>
                                                            </div>
                                                            <div class="d-lg-flex d-none flex-row gap-2 w-100 justify-content-between align-items-center">
                                                                <div class="d-flex none-accord-@item.No_Bukti flex-column gap-1">
                                                                    <h5 style="font-size:15px; " class="">
                                                                        @($"Total {@dataSourch?.DataPesanan?.Items.Where(x => x.No_Bukti == item.No_Bukti).ToList().Count()} produk: ") 
                                                                        <span style="color:#1500b2;">
                                                                            @string.Format("Rp. {0:N0}", item.Grand_Total)
                                                                        </span>
                                                                    </h5>
                                                                    @if(@dataSourch?.DataPesanan?.Items.Where(x => x.No_Bukti == item.No_Bukti).ToList().Count() >= 2) 
                                                                    {
                                                                        <button @onclick="@( x => openDropdown(@item.No_Bukti))" class="accordion-button header-accord-@item.No_Bukti collapsed rounded-0 mt-1" style="padding: 0px;font-size: 13px;width: fit-content;display: flex;gap: 10px;" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-@item.No_Bukti" aria-expanded="true" aria-controls="panelsStayOpen-@item.No_Bukti"> Tampil Selangkapnya
                                                                        </button>
                                                                    }
                                                                </div>
                                                                <button @onclick="@( x => openPayment(@item))" class="btn none-accord-@item.No_Bukti btn-primary" style="height: 36px !important;border-radius: 0px !important;font-size: 13px !important;padding: 0px 14px !important;" id="modalPaymentStatus2" type="button" data-bs-toggle="modal" data-bs-target="#staticBackdrop2">
                                                                    Bayar Sekarang
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                            
                                                    <div class="d-flex d-lg-none flex-row gap-2 w-100 justify-content-between align-items-center">
                                                        <div class="d-flex none-accord-@item.No_Bukti total-bottom flex-column gap-1 mt-2">
                                                            <h5 style="font-size:15px; " class="">
                                                                @($"Total {@dataSourch?.DataPesanan?.Items.Where(x => x.No_Bukti == item.No_Bukti).ToList().Count()} produk: ") 
                                                                <span style="color:#1500b2;">
                                                                    @string.Format("Rp. {0:N0}", item.Grand_Total)
                                                                </span>
                                                            </h5>
                                                            @if(@dataSourch?.DataPesanan?.Items.Where(x => x.No_Bukti == item.No_Bukti).ToList().Count() >= 2) 
                                                            {
                                                                <button @onclick="@( x => openDropdown(@item.No_Bukti))" class="accordion-button header-accord-@item.No_Bukti collapsed rounded-0 mt-1" style="padding: 0px;font-size: 13px;width: fit-content;display: flex;gap: 10px;" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-@item.No_Bukti" aria-expanded="true" aria-controls="panelsStayOpen-@item.No_Bukti"> Tampil Selangkapnya
                                                                </button>
                                                            }
                                                        </div>
                                                        <button @onclick="@( x => openPayment(@item))" class="btn none-accord-@item.No_Bukti btn-primary" style="height: 36px !important;border-radius: 0px !important;font-size: 13px !important;padding: 0px 14px !important;" id="modalPaymentStatus2" type="button" data-bs-toggle="modal" data-bs-target="#staticBackdrop2">
                                                            Bayar Sekarang
                                                        </button>
                                                    </div>
                                                </div>

                                            </div>
                                        </h2>



                                        <div id="panelsStayOpen-@item.No_Bukti" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingOne">
                                            <div class="accordion-body px-3 px-lg-4">
                                                @foreach(var produk in dataSourch?.DataPesanan?.Items.Where(x => x.No_Bukti == item.No_Bukti).ToList())
                                                {
                                                    @if(produk.Id_Detil == @dataSourch?.DataPesanan?.Items.FirstOrDefault(x => x.No_Bukti == item.No_Bukti).Id_Detil) { continue; }

                                                    <div class="d-flex flex-col gap-3 w-100">
                                                        @if(@produk.Var_Id_Media != null && @produk.Var_Id_Media != "")
                                                        {
                                                            <img class="cart-img img-payment" src="@produk.Var_Id_Media" style="" alt="#">
                                                        } 
                                                        
                                                        else
                                                        {
                                                            <div class="cart-img img-payment" style="display:flex; align-items:center;justify-content:center; background-color:lightgray; color:dimgrey">
                                                                <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M73-889 889-73l-57 57-104-104H200q-33 0-56.5-23.5T120-200v-528L16-832l57-57Zm287 447L200-282v82h448L544-304l-22 24-162-162ZM200-648v252l126-126-126-126Zm36-192h524q33 0 56.5 23.5T840-760v524l-80-80v-234L650-426l-57-57 167-187v-90H316l-80-80Zm357 357Zm-158 70ZM326-522Zm34 80Zm176-98Z"/></svg>
                                                            </div>
                                                        }
                                                        <div class="d-flex flex-column gap-2 w-100 justify-content-between">
                                                            <div class="d-flex flex-column gap-2">
                                                                <h5 style="font-size:15px;" class="line-clamp-1">
                                                                    @produk.Nama_Display
                                                                </h5>
                                                                <p class="variant" style="background-color: #eee;width: fit-content;padding: 1px 5px;border-radius: 0px;">
                                                                    @($"{@produk.Var_Option}, {@produk.Var_Size}")
