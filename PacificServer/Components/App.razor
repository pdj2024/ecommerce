        function selectPrediction(placeSelect) {
            placesService.getDetails({
                placeId: placeSelect.place_id,
                fields: ["name", "geometry", "formatted_address", "address_components"]
            }, (place, status) => {
                if (status !== google.maps.places.PlacesServiceStatus.OK) return;


                geocoder.geocode({ location: place.geometry.location }, (results, status) => {

                    if (status !== "OK" || !results || results.length === 0) {
                        console.log("Geocoder gagal:", status);
                        return;
                    }

                    // 🔎 Cari result dengan address_components terbanyak
                    let bestResult = null;
                    let maxComponents = 0;

                    for (const r of results) {
                        const count = r.address_components ? r.address_components.length : 0;

                        // Prioritas utama: yang >= 7 langsung pakai kalau paling besar
                        if (count >= 7 && count > maxComponents) {
                            bestResult = r;
                            maxComponents = count;
                        }

                        // Backup: simpan yang paling banyak kalau tak ada yg >= 7
                        if (!bestResult && count > maxComponents) {
                            bestResult = r;
                            maxComponents = count;
                        }
                    }

                    // Kalau tetap gak ada (kasus sangat jarang), pakai result pertama
                    if (!bestResult) {
                        bestResult = results[0];
                    }

                    console.log("Dipilih result dengan komponen:", maxComponents, bestResult.formatted_address);

                    let components = normalizeComponents(bestResult.address_components);

                    fillAddress(
                        components,
                        bestResult.geometry.location.lat(),
                        bestResult.geometry.location.lng()
                    );

                });

                marker.position = place.geometry.location;
                panToWithOffset(place.geometry.location, 100);
                ShowMaps(true);

            });

            const input = document.getElementById("txtAlamatManual");
            input.value = (placeSelect.structured_formatting.main_text + " - " + placeSelect.structured_formatting.secondary_text);
        }

        function panToWithOffset(latLng, offsetY = 150) {

            if (!map.getProjection()) {
                google.maps.event.addListenerOnce(map, "idle", () => {
                    panToWithOffset(latLng, 100);
                });
                return;
            }

            const scale = Math.pow(2, map.getZoom());
            const proj = map.getProjection();

            const point = proj.fromLatLngToPoint(latLng);
            point.y -= offsetY / scale;

            const newCenter = proj.fromPointToLatLng(point);
            map.setCenter(newCenter);
        }

