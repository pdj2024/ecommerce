@rendermode InteractiveServer
@page "/payment-page"


<!-- Start Content Area -->



<header class="checkout-header">
    <img src="images/logo/logo.svg" alt="Logo" class="checkout-logo">
    <NavLink>
        <i class="lni lni-cart ms-3 flip-logo logo-custom"></i>
    </NavLink>
</header>

  <!-- Grid Utama -->
<div class="checkout">
    <!-- Kiri: Form -->
    <div class="checkout-main">
        <div class="panel section-payment">
            <div class="panel__header">Informasi Pengiriman</div>
            <div class="panel__body panel_custom">
                <div class="form-grid">
                    <div class="field">
                        <label>Nama Lengkap</label>
                        <input type="text" class="input">
                    </div>
                    <div class="field">
                        <label>Email</label>
                        <input type="email" class="input">
                    </div>
                </div>
                <div class="form-grid form-grid--single">
                    <div class="field">
                        <label>Alamat</label>
                        <input type="text" class="input">
                    </div>
                </div>
            </div>
        </div>

        <div class="panel section-payment">
            <div class="panel__header">Metode Pengiriman</div>
            <div class="panel__body shipping-list">
                <label class="shipping-item">
                    <div class="custom-payment">
                        <input type="radio" name="ship" checked>
                        <span>Reguler (2-4 hari)</span>
                    </div>
                    <div class="shipping-item__right">Rp 20.000</div>
                </label>
                <label class="shipping-item">
                    <div class="custom-payment">
                        <input type="radio" name="ship">
                        <span>Ekspres (1-2 hari)</span>
                    </div>
                    <div class="shipping-item__right">Rp 40.000</div>
                </label>
            </div>
        </div>

        <div class="panel section-payment">
            <div class="panel__header">Metode Pembayaran</div>
            <div class="panel__body payment-list">
                @foreach(var payment_method in ListData)
                {
                    <label class="payment-item">
                        <div class="custom-payment">
                            <input type="radio" name="pay" value="@payment_method.Cara_Bayar" checked>
                            <span>@payment_method.Display</span>
                        </div>
                        <div class="shipping-item__right">@payment_method.Fee</div>
                    </label>
                    
                }
            </div>
        </div>

        <!-- Footer -->
        <footer class="checkout-footer">
        <p>© 2025 Department Checkout. Semua hak dilindungi.</p>
        </footer>

    </div>

    <!-- Kanan: Ringkasan Order -->
    <aside class="checkout-summary panel">
        <div class="summary__items">
            <div class="summary-item">
              <div class="summary-item__thumb"></div>
              <div>
                <div class="summary-item__title">Produk A</div>
                <div class="summary-item__meta">1x</div>
              </div>
              <div>Rp 150.000</div>
            </div>
            <div class="summary-item">
              <div class="summary-item__thumb"></div>
              <div>
                <div class="summary-item__title">Produk B</div>
                <div class="summary-item__meta">2x</div>
              </div>
              <div>Rp 200.000</div>
            </div>
          </div>

          <div class="summary__line">
            <span>Subtotal</span>
            <span>Rp 350.000</span>
          </div>
          <div class="summary__line">
            <span>Pengiriman</span>
            <span>Rp 20.000</span>
          </div>
          <div class="summary__line summary__line--bold">
            <span>Total</span>
            <span>Rp 370.000</span>
          </div>

        <button class="btn btn--primary btn--full">Selesaikan Pesanan</button>
    </aside>
</div>


<!-- End Content Area -->
