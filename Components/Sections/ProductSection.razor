@rendermode InteractiveServer

<section class="trending-product section px-0 px-lg-3 px-xl-5 px-xxl-10" style="margin-top: 0px;">
    <div class="container-fluid">
        <div class="row py-0 py-lg-3 py-xl-4 py-xxl-5">
            <div class="col-12">
                <div class="section-title">
                    <h2>@GlobalDataService.GlobalData.ListDataTexkSection.FirstOrDefault(x => x.Section_Name == "section1")?.Judul</h2>
                    <p>
                        @GlobalDataService.GlobalData.ListDataTexkSection.FirstOrDefault(x => x.Section_Name == "section1")?.Keterangan
                    </p>
                </div>
            </div>
        </div>

        <div class="row product-shimer">
            @for (var i = 0; i <= 11; i++)
            {
                <div class="col-lg-3 col-md-4 col-6 col-xxl-2 pt-2 pb-2">
                    <div class="card p-3 border-0" style="border-radius:0px;" aria-busy="true">
                        <div class="skeleton skeleton-rect mb-3"></div>
                        <div class="d-flex align-items-center justify-content-between">
                            <div style="flex:1" class="d-flex flex-column align-items-center">
                                <div class="skeleton skeleton-title mb-2" style="width:90%"></div>
                                <div class="skeleton skeleton-subtitle mb-2" style="width:50%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row product-content" style="display:none;">
            @foreach (var dataProduk in GlobalDataService?.GlobalData?.ListDataProduk)
            {
                <div class="col-lg-3 col-md-4 col-6 col-xxl-2 pt-2 pb-2 product">
                    <!-- Start Single Product -->
                    <PacificWeb.Components.Sections.ProductDisplay DataProduk="dataProduk" selectProduk="@selectProduk" />
                    <!-- End Single Product -->
                </div>
            }
        </div>

    </div>
</section>
