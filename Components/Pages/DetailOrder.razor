@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@using PacificWeb.Components.Sections


<div class="col-12 p-0">
    <div class="tab-content pb-5" id="pills-tabContent">

        <div class="tab-pane fade show active" id="pills-belum-bayar" role="tabpanel" aria-labelledby="pills-belum-bayar-tab">

            @if (loadContent)
            {
                @for(var i = 0; i <= 5; i++)
                {
                    <div class="" style="padding: 0px ; margin-top:0px;">
                        <div class="card p-3 mb-5 border-0" style="border-radius:0px;" aria-busy="true">
                            <div class="skeleton skeleton-rect mb-3"></div>
                                <div class="d-flex align-items-center justify-content-between">
                                    <div style="flex:1">
                                        <div class="skeleton skeleton-title mb-2"></div>
                                        <div class="skeleton skeleton-subtitle mb-2" style="width:50%"></div>
                                </div>
                                <div class="ms-3">
                                    <div class="skeleton skeleton-pill"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            } 
            else
            {
                @if (ScopedDataServices?.ScopedData?.DataPesananDetail?.Data.Header.Count(x => x.No_Tracking == noBukti) >= 1) {
                    <div class="cart-page" style="padding: 0px; margin:0px 0px 0px 0px; max-width:100%">
                        <div class="cart-container p-0">

                            <div class="cart-items">

                                <div class="accordion" style="gap: 2rem;display: flex;flex-direction: column;" id="accordionPanelsStayOpenExample">

                                    @foreach (var item in ScopedDataServices?.ScopedData?.DataPesananDetail?.Data.Header.Where(x => x.No_Tracking == noBukti).ToList())
