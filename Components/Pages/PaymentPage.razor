@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@page "/payment-page/{CartList}/{itemVariant}"




<PageTitle>Payment</PageTitle>
<!-- Start Content Area -->

@if (contentCrash)
{
    <div class="w-100 p-0">
        <div class="row m-0">
            <div class="col-12 col-lg-6 px-0">
                <div class="w-100 ps-0 ps-xxl-5 h-auto" style="">
                    <div class="w-100 h-100 ps-0 ps-lg-5 pe-0 pe-lg-3 pt-2 pb-2">

                        <div class="w-100 h-100 d-flex flex-column" >

                            <div class="checkout-header pb-2">
                                @if (loadContent)
                                {
                                    <form aria-busy="true" class="mb-2 w-100">
                                        <div class="d-flex align-items-start gap-3" aria-busy="true">
                                            <div style="flex:1">
                                                <div class="skeleton skeleton-text mb-2" style="width:30%"></div>
                                            </div>
                                            <div class="ms-3">
                                                <div class="skeleton" style="width:56px; height:16px; border-radius:8px;"></div>
                                            </div>
                                        </div>
                                    </form>
                                }
                                else
                                {
                                    <NavLink @onclick="@(x => NavigationManager.NavigateTo("/", true))" style="cursor:pointer;">
                                        <img src="@(@GlobalDataService?.GlobalData?.ListDataCompany?.FirstOrDefault()?.Media?.FirstOrDefault(x => x.Media_Type == "landscape").Id_Media ?? "images/logo/logo-pdj.png")" alt="Logo" class="checkout-logo">
                                    </NavLink>
                                    <NavLink @onclick="@(x => NavigationManager.NavigateTo("/cart-page/keranjang", true))" class="btn btn-slide border-0" style="width:fit-content; border-radius:100%; padding: 12px 10px;">
                                        <i class="lni lni-cart-1 cart-icon-pay"> </i>
                                    </NavLink>
                                }
                            </div>

                            <div class="accordion accordion-flush d-block d-md-block d-lg-none" id="accordionFlushExample">
                                <div class="accordion-item" style="background-color:#f5f5f5">
                                    <h2 class="accordion-header" id="flush-headingOne">
                                        <button class="accordion-button collapsed" style="font-weight: 700;" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseOne" aria-expanded="false" aria-controls="flush-collapseOne">
                                            Ringkasan Pesanan
                                        </button>
                                    </h2>
                                    <div id="flush-collapseOne" class="accordion-collapse collapse" aria-labelledby="flush-headingOne" data-bs-parent="#accordionFlushExample">
                                        <div class="accordion-body" style="padding:0px">
                                            <div class="summary__items" style="max-height: 400px;">
                                                <div style="max-height: 335px;overflow-y: auto;padding: 10px 10px;display: flex;flex-direction: column;gap: 10px;">
                                                    @foreach (var display in dataSourch?.ListDataCart)
                                                    {
                                                        <div class="summary-item" style="padding-bottom: 10px;border-bottom: 1px solid #e5e7eb;">
                                                            <div class="summary-item__thumb">
                                                                @if (@display?.Id_Media == null || @display?.Id_Media == "")
                                                                {
                                                                    <img src="/images/products/placeholder1.png" alt="@display?.Nama_Display" />
                                                                }
                                                                else
                                                                {
                                                                    <Image Src="@display?.Id_Media" Alt="@display?.Nama_Display" />
                                                                }
                                                            </div>
                                                            <div style="height: 100%;display: flex;flex-direction: column;justify-content: space-between;padding: 2px 0px; gap:5px;">
                                                                <div class="summary-item__title">
                                                                    <p class="line-clamp-1" style="margin: 0;padding: 0;font-size: 14px;line-height: 16px;">
                                                                        @display.Nama_Display
                                                                    </p>
                                                                </div>
                                                                <p class="variant" style="background-color: #d1d1d1;width: fit-content;padding: 1px 6px;border-radius: 0px;font-size: 12px;font-weight: 700;font-style: italic;">
                                                                    @($"{display.Option_Label}, {display.Size_Label}")
                                                                </p>
                                                                <div class="summary-item__meta" style="font-size:13px">@($"{display?.Qty} x " + string.Format("Rp. {0:N0}", (display?.Harga - (display?.Harga * (display?.Diskon1 / 100)))))</div>
                                                            </div>
                                                            <div style="font-weight: 600;">@string.Format("Rp. {0:N0}", ((display?.Harga * display?.Qty) - ((display?.Harga * display?.Qty) * (display?.Diskon1 / 100))))</div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="panel section-payment" style="border-radius:0px">
                                <div class="panel__header">Informasi Pengiriman</div>
                                @if (loadContent)
                                {
                                    <form aria-busy="true" class="mb-3 mt-3">
                                        <div class="mb-3">
                                            <div class="skeleton skeleton-subtitle mb-2" style="width:25%"></div>
                                            <div class="skeleton" style="height:38px;width:100%;border-radius:.375rem"></div>
                                        </div>
                                        <div class="mb-3">
                                            <div class="skeleton skeleton-subtitle mb-2" style="width:20%"></div>
                                            <div class="skeleton" style="height:38px;width:100%;border-radius:.375rem"></div>
                                        </div>
                                    </form>
                                }
                                else
                                {
                                    <div class="row px-3 pt-3">
                                        @foreach (var Head in Pesanan_Info.Header)
                                        {
                                            <div class="col-12 col-lg-6">
                                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                                    <input style="background-color:transparent !important; font-weight: 700; font-size:15px;" type="text" class="form-control search-form form-text" placeholder="" aria-label="Search" aria-describedby="basic-addon1" required @bind-value=@Head.Nama_Penerima />
                                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Nama Penerima <span class="text-danger">*</span></label>
                                                </div>
                                            </div>
                                            <div class="col-12 col-lg-6">
                                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                                    <input style="background-color:transparent !important; font-weight: 700; font-size:15px;" type="text" class="form-control search-form form-text" placeholder="" aria-label="Search" aria-describedby="basic-addon1" required @bind-value="@Head.Telpon_Penerima" />
                                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Telpon Penerima <span class="text-danger">*</span></label>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                                    <textarea rows="2" style="background-color:transparent !important; font-weight: 700;  font-size:15px;" class="form-control search-form form-text" placeholder="" aria-label="Search" aria-describedby="basic-addon1" required @bind=@Head.Alamat_Kirim />
                                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Alamat Kirim <span class="text-danger">*</span></label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                            </div>

                            <div class="panel section-payment" style="border-radius:0px">
                                <div class="panel__header">Metode Pengiriman</div>

                                @if (loadContent)
                                {
                                    <div class="table-responsive" aria-busy="true">
                                        <table class="table">
                                            <thead>
                                                <tr>
                                                    <th style="border-bottom-color:#dee2e6"><div class="skeleton" style="width:120px;height:16px;border-radius:8px;"></div></th>
                                                    <th style="border-bottom-color:#dee2e6"><div class="skeleton" style="width:160px;height:16px;border-radius:8px;"></div></th>
                                                    <th style="border-bottom-color:#dee2e6"><div class="skeleton" style="width:80px;height:16px;border-radius:8px;"></div></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td><div class="skeleton" style="width:80%;height:14px;border-radius:6px;"></div></td>
                                                    <td><div class="skeleton" style="width:60%;height:14px;border-radius:6px;"></div></td>
                                                    <td><div class="skeleton" style="width:40px;height:14px;border-radius:6px;"></div></td>
                                                </tr>
                                                <tr>
                                                    <td><div class="skeleton" style="width:70%;height:14px;border-radius:6px;"></div></td>
                                                    <td><div class="skeleton" style="width:50%;height:14px;border-radius:6px;"></div></td>
                                                    <td><div class="skeleton" style="width:40px;height:14px;border-radius:6px;"></div></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="panel__body shipping-list">
                                        @foreach (var shipping_method in GlobalDataService?.GlobalData?.ListDataPengiriman)
                                        {
                                            <label class="shipping-item">
                                                <div class="custom-payment w-75">
                                                    <input type="radio" name="ship" checked="@shipping_method.selectShipping" @onchange="(e) => SelectShipingMethod(shipping_method)">
                                                    <span class="w-75" style="text-overflow:ellipsis; overflow:hidden;">@shipping_method.Nama</span>
                                                </div>
                                                <div class="shipping-item__right">@string.Format("Rp. {0:N0}", @shipping_method.Fee)</div>
                                            </label>
                                        }
                                    </div>
                                }


                            </div>

                            <div class="panel section-payment" style="border-radius:0px">
                                <div class="panel__header">Metode Pembayaran</div>

                                @if (loadContent)
                                {
                                    <div class="table-responsive" aria-busy="true">
                                        <table class="table">
                                            <thead>
                                                <tr>
                                                    <th style="border-bottom-color:#dee2e6"><div class="skeleton" style="width:120px;height:16px;border-radius:8px;"></div></th>
                                                    <th style="border-bottom-color:#dee2e6"><div class="skeleton" style="width:160px;height:16px;border-radius:8px;"></div></th>
                                                    <th style="border-bottom-color:#dee2e6"><div class="skeleton" style="width:80px;height:16px;border-radius:8px;"></div></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td><div class="skeleton" style="width:80%;height:14px;border-radius:6px;"></div></td>
                                                    <td><div class="skeleton" style="width:60%;height:14px;border-radius:6px;"></div></td>
                                                    <td><div class="skeleton" style="width:40px;height:14px;border-radius:6px;"></div></td>
                                                </tr>
                                                <tr>
                                                    <td><div class="skeleton" style="width:70%;height:14px;border-radius:6px;"></div></td>
                                                    <td><div class="skeleton" style="width:50%;height:14px;border-radius:6px;"></div></td>
                                                    <td><div class="skeleton" style="width:40px;height:14px;border-radius:6px;"></div></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="panel__body payment-list">
                                        @foreach (var payment_method in GlobalDataService?.GlobalData?.ListDataPembayaran)
                                        {
                                            <label class="payment-item">
                                                <div class="custom-payment w-75">
                                                    <input type="radio" name="pay" checked="@payment_method.selectPayment" @onchange="(e) => SelectPaymentMethod(payment_method)">
                                                    <span class="" style="text-overflow:ellipsis; overflow:hidden;">@payment_method.Display</span>
                                                </div>
                                                <div class="shipping-item__right">@string.Format("Rp. {0:N0}", @payment_method.Fee)</div>
                                            </label>
                                        }
                                    </div>
                                }
                            </div>
                    
                            <aside class="checkout-summary2 panel d-flex d-md-flex d-lg-none px-0">
                                <div class="summary__items" style="max-height: 320px; height:auto">
                                    @if (loadContent)
                                    {
                                        <form aria-busy="true" class="mb-2 px-5">
                                            <div class="d-flex align-items-start gap-3 mb-3" aria-busy="true">
                                                <div class="skeleton skeleton-avatar"></div>
                                                <div style="flex:1">
                                                    <div class="skeleton skeleton-text mb-2" style="width:80%"></div>
                                                    <div class="skeleton skeleton-text" style="width:60%"></div>
                                                </div>
                                                <div class="ms-3">
                                                    <div class="skeleton" style="width:56px; height:16px; border-radius:8px;"></div>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-start gap-3 mb-3" aria-busy="true">
                                                <div class="skeleton skeleton-avatar"></div>
                                                <div style="flex:1">
                                                    <div class="skeleton skeleton-text mb-2" style="width:80%"></div>
                                                    <div class="skeleton skeleton-text" style="width:60%"></div>
                                                </div>
                                                <div class="ms-3">
                                                    <div class="skeleton" style="width:56px; height:16px; border-radius:8px;"></div>
                                                </div>
                                            </div>
                                        </form>
                                    }
                                    else
                                    {
                                        <div class="panel__header px-3" style="padding: 5px 20px 18px 0px; font-size:22px;">Ringkasan Pesanan</div>
                                        <div class="pe-2" style="max-height: 260px;overflow-y: auto;padding: 10px 10px;display: flex;flex-direction: column;gap: 10px;">
                                            @foreach (var display in dataSourch?.ListDataCart)
                                            {
                                                <div class="summary-item" style="padding-bottom: 10px;border-bottom: 1px solid #e5e7eb;">
                                                    <div class="summary-item__thumb">
                                                        @if (@display?.Id_Media == null || @display?.Id_Media == "")
                                                        {
                                                            <img src="/images/products/placeholder1.png" alt="@display?.Nama_Display" />
                                                        }
                                                        else
                                                        {
                                                            <Image Src="@display?.Id_Media" Alt="@display?.Nama_Display" />
                                                        }
                                                    </div>
                                                    <div style="height: 100%;display: flex;flex-direction: column;justify-content: space-between;padding: 2px 0px; gap:5px;">
                                                        <div class="summary-item__title">
                                                            <p class="line-clamp-1" style="margin: 0;padding: 0;font-size: 14px;line-height: 16px;">
                                                                @display.Nama_Display
                                                            </p>
                                                        </div>
                                                        <p class="variant" style="background-color: #d1d1d1;width: fit-content;padding: 1px 6px;border-radius: 0px;font-size: 12px;font-weight: 700;font-style: italic;">
                                                            @($"{display.Option_Label}, {display.Size_Label}")
                                                        </p>
                                                        <div class="summary-item__meta" style="font-size:13px">@($"{display?.Qty} x " + string.Format("Rp. {0:N0}", (display?.Harga - (display?.Harga * (display?.Diskon1 / 100)))))</div>
                                                    </div>
                                                    <div style="font-weight: 600;">@string.Format("Rp. {0:N0}", ((display?.Harga * display?.Qty) - ((display?.Harga * display?.Qty) * (display?.Diskon1 / 100))))</div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="px-3">

                                    @if (loadContent)
                                    {
                                        <form aria-busy="true" class="mb-2 px-5">
                                            <div class="mb-3">
                                                <div class="skeleton" style="height:38px;width:100%;border-radius:.375rem"></div>
                                            </div>
                                            <div class="mb-3">
                                                <div class="skeleton" style="height:38px;width:100%;border-radius:.375rem"></div>
                                            </div>
                                            <div class="mb-3">
                                                <div class="skeleton" style="height:38px;width:100%;border-radius:.375rem"></div>
                                            </div>
                                            <div class="mb-3">
                                                <div class="skeleton" style="height:35px;width:100%;border-radius:.375rem"></div>
                                            </div>
                                        </form>
                                    }
                                    else
                                    {
                                        <div class="summary__line">
                                            <span>Subtotal Barang</span>
                                            <span style="font-weight:600;">@string.Format("Rp. {0:N0}", totalDpp)</span>
                                        </div>
                                        <div class="summary__line">
                                            <span>
                                                Biaya Pengiriman
                                            </span>
                                            <span style="font-weight:600;">@string.Format("Rp. {0:N0}", shipingMethodFee)</span>
                                        </div>
                                        <div class="summary__line">
                                            <span>Biaya Layanan</span>
                                            <span style="font-weight:600;">@string.Format("Rp. {0:N0}", paymentMethodFee)</span>
                                        </div>

                                        @if (GlobalDataService?.GlobalData?.ListDataNilaiDefault.FirstOrDefault()?.Incl_Ppn == false)
                                        {
                                            <div class="summary__line">
                                                <span style="font-style:italic;">PPN (@GlobalDataService?.GlobalData?.ListDataNilaiDefault.FirstOrDefault()?.Ppn%)</span>
                                                <span style="font-weight:600;">@string.Format("Rp. {0:N0}", ppnValue)</span>
                                            </div>
                                        }

                                        <div class="summary__line summary__line--bold" style="font-size:1.2rem">
                                            <span>Total Pembayaran</span>
                                            <span>@string.Format("Rp. {0:N0}", nettoKeranjang)</span>
                                        </div>
                                    }

                                </div>
                            </aside>
                        
                            @if (loadContent)
                            {
                                <form aria-busy="true" class="mb-5">
                                    <div class="mb-3">
                                        <div class="skeleton" style="height:38px;width:100%;border-radius:.375rem"></div>
                                    </div>
                                </form>
                            }
                            else
                            {

                                <div style="padding: 0px 20px;">
                                    <button class="btn btn--primary btn--full" @onclick="@(() => FinisedOrder())">Selesaikan Pesanan</button>
                                </div>

                                <div style="padding: 0px 20px;" class="mt-3">
                                    @if (alertPayment)
                                    {
                                        <span class="mt-2" style="color:red;">
                                            * Pastikan anda telah memilih metode pembayaran dan pengiriman.
                                        </span>
                                    }
                                    @if (alertProfile)
                                    {
                                        <span class="mt-1" style="color:red;">
                                            * Pastikan anda telah mengisi alamat kirim, nama dan telepon penerima.
                                        </span>
                                    }
                                </div>

                            }

                            <div style="padding: 0px 0px;">
                                <button style="opacity: 1;position: absolute;width: 0;height: 0;padding: 0;" id="modalPaymentStatus" type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#staticBackdrop" />
                            </div>

                            <div style="padding: 0px 0px;">
                                <button style="opacity: 1;position: absolute;width: 0;height: 0;padding: 0;" id="modalPaymentStatus2" type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#staticBackdrop2" />
                            </div>

                            <div style="padding: 0px 0px;">
                                <button style="opacity: 1;position: absolute;width: 0;height: 0;padding: 0;" id="modalPaymentStatus3" type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#staticBackdrop3" />
                            </div>

                            <div style="padding: 0px 0px;">
                                <button style="opacity: 1;position: absolute;width: 0;height: 0;padding: 0;" id="modalPaymentStatus4" type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCartNotFound" />
                            </div>

                            <div style="padding: 0px 0px;">
                                <button style="opacity: 1;position: absolute;width: 0;height: 0;padding: 0;" id="modalPaymentStatus5" type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalPaymentLost" />
                            </div>

                        
                            <footer class="checkout-footer text-center" style="max-width:100%; width:100%;">
                                <p>Copyright by Pacific Data Jaya ©2025</p>
                            </footer>
                    
                        </div>
                
                    </div>
                </div>
            </div>

            <div class="col-6 d-none d-lg-flex position-relative h-100 ">
                <div class="position-fixed h-100 pe-0 pe-xxl-5 w-50" style="top:0px; right:0px; background-color: #f5f5f5;">
                    <div class="w-100 h-100 pe-0 pe-lg-5 ps-0 ps-lg-3 pt-2 pb-2">

                        <div class="w-100 h-100 d-flex flex-column">
                            <aside class="checkout-summary2 panel d-none d-md-none d-lg-flex h-100 px-0 py-3 m-0 position-relative" style="justify-content:normal">
                                
