                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
            
                    <div class="modal-footer justify-content-center button border-top-0 pt-2 px-5">
                        <button type="button" style="border-radius:0px;width: auto;margin: 0px 3px;" disabled=@loadProses class="btn btn-success bg-success px-2" @onclick="@( x => refreshStatus(Head))" >
                            @if(loadProses) 
                            {
                                <div class="spinner-border spinner-border-sm" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            } 
                            else
                            {
                                @("Cek Status")

                                @* <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M480-160q-134 0-227-93t-93-227q0-134 93-227t227-93q69 0 132 28.5T720-690v-110h80v280H520v-80h168q-32-56-87.5-88T480-720q-100 0-170 70t-70 170q0 100 70 170t170 70q77 0 139-44t87-116h84q-28 106-114 173t-196 67Z"/></svg> *@
                            }
                        </button>

                        @if (@Head?.Status_Order_1 == "belum bayar") 
                        {
                            <button type="button" class="btn btn-primary px-2" style="border-radius:0px" @onclick="@( x => GantiMethod(Head))" >Ganti Metode</button>
                        }

                        <button class="d-none px-2" id="buttonChangeMethod" style="width:0px; height:0px;" type="button" data-bs-toggle="modal" data-bs-target="#staticBackdrop3"></button>

                        <button class="d-none px-2" id="buttonBatalMethod" style="width:0px; height:0px;" type="button" data-bs-toggle="modal" data-bs-target="#staticBackdrop4"></button>
                       
                        <button class="d-none px-2" id="closeModal" style="width:0px; height:0px;" type="button" data-bs-dismiss="modal" ></button>
                        
                        @if (@Head?.Status_Order_1 == "belum bayar") 
                        {
                            <button type="button" @onclick="@( x => BatalkanPesanan(Head))" class="btn btn-danger bg-danger px-2" style="font-weight:500; font-size:15px; z-index:0; letter-spacing:-0.5px; width:fit-content;border-radius:0px;">
                                <span class="position-relative">Batalkan Pesanan</span>
                            </button>
                        }
                    </div>
                }

            }

        </div>
    </div>
</div>

<div class="modal fade review-modal overflow-auto" id="staticBackdrop3" data-bs-backdrop="static" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:600px;">
        <div class="modal-content" style="border-radius: 0px;" >
            <div class="modal-header justify-content-between d-flex border-bottom-0 pb-0">
                <h5 class="modal-title w-100 text-center" id="exampleModalLabel" style="letter-spacing: -1px; font-size: 22px;font-weight: 400;">Pilih Metode Pembayaran</h5>
            </div>

            <div class="modal-body">
                <div class="panel section-payment">
                    <div class="panel__body payment-list py-0">

                        @foreach(var payment_method in dataSourch?.ListDataPembayaran)
                        {
                            <label class="payment-item @(payment_method.disabeldPayment ? "bg-secondary" : "")">
                                <div class="custom-payment w-75">
                                    <input type="radio" name="pay" disabled=@payment_method.disabeldPayment checked="@payment_method.selectPayment" @onchange="(e) => SelectPaymentMethod(payment_method)">
                                    <span class="" style="text-overflow:ellipsis; overflow:hidden;">@payment_method.Display</span>
                                </div>
                                <div class="shipping-item__right">@string.Format("Rp. {0:N0}", @payment_method.Fee)</div>
                            </label>
                        }   


                        <aside class="checkout-summary2 panel d-flex px-0 mt-3 h-auto">

                            <div class="px-3">
                                <div class="summary__line border-0">
                                    <span>Items</span>
                                    <span style="font-weight:600;">@string.Format("Rp. {0:N0}", totalDpp)</span>
                                </div>
                                <div class="summary__line">
                                    <span>
                                        Shipping Costs
                                    </span>
                                    <span style="font-weight:600;">@string.Format("Rp. {0:N0}", shipingMethodFee)</span>
                                </div>
                                <div class="summary__line">
                                    <span>Service Fee</span>
                                    <span style="font-weight:600;">@string.Format("Rp. {0:N0}", paymentMethodFee)</span>
                                </div>

                                @if (Pesanan_Change.Incl_PPN == false)
                                {
                                    <div class="summary__line">
                                        <span style="font-style:italic;">PPN (@Pesanan_Change.PPN%)</span>
                                        <span style="font-weight:600;">@string.Format("Rp. {0:N0}", ppnValue)</span>
                                    </div>
                                }

                                <div class="summary__line summary__line--bold">
                                    <span>Total</span>
                                    <span>@string.Format("Rp. {0:N0}", nettoKeranjangChange)</span>
                                </div>
                            </div>

                        </aside>


                        @if(infoChange == true) 
                        {
                            <div class="modal-body">
                                <div class="row">
                                    <p style="font-size:17px; font-weight:500;" class="text-danger text-center">
                                        Gagal mengganti metode pembayaran! Coba lagi nanti.
                                    </p>
                                </div>
                            </div>
                        }


                    </div>
                </div>
            </div>
            
            <div class="modal-footer justify-content-center button border-top-0 pt-2 px-5">

                <button type="button" id="closeModalChange" data-bs-dismiss="modal" class="btn btn-danger bg-danger" style="font-weight:500; font-size:15px; z-index:0; letter-spacing:-0.5px; width:fit-content;border-radius:0px;">
                    <span class="position-relative">Batal</span>
                </button>

                <button type="button" disabled=@(dataSourch.ListDataPembayaran.FirstOrDefault(x => x.selectPayment == true) == null || loadProses) class="btn btn-success bg-success" style="font-weight:500; font-size:15px; z-index:0; letter-spacing:-0.5px; width:fit-content; border-radius:0px;" @onclick=@(x => ChangePaymentMethod(Pesanan_Change) ) >
                    @if (loadProses)
                    {
                        <div class="spinner-border spinner-border-sm position-relative" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    }
                    else
                    {
                        <span class="position-relative">
                            Simpan
                        </span>
                    }
                </button>

            </div>

        </div>
    </div>
</div>

<div class="modal fade review-modal overflow-auto" id="staticBackdrop4" data-bs-backdrop="static" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:600px;">
        <div class="modal-content" style="border-radius: 0px;" >
            <div class="modal-header justify-content-between d-flex border-bottom-0 pb-0">
                <h5 class="modal-title w-100 text-center" id="exampleModalLabel" style="letter-spacing: -1px; font-size: 22px;font-weight: 400;">Konfirmasi Pembatalan</h5>
                <button type="button" class="btn-close m-0" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            @if(infoPembatalan == null) {
                <div class="modal-body">
                    <div class="row">
                        <p style="font-size:17px; font-weight:500;" class="text-danger text-center">
                            Yakin membatalkan pesanan @Pesanan_Change.No_Tracking?
                        </p>
                    </div>
                </div>
            } else if(infoPembatalan == true) {
                <div class="modal-body">
                    <div class="row">
                        <p style="font-size:17px; font-weight:500;" class="text-success text-center">
                            Pesanan @Pesanan_Change.No_Tracking berhasil dibatalkan
                        </p>
                    </div>
                </div>

            } else {
                <div class="modal-body">
                    <div class="row">
                        <p style="font-size:17px; font-weight:500;" class="text-danger text-center">
                            Pesanan @Pesanan_Change.No_Tracking gagal dibatalkan, coba lagi nanti
                        </p>
                    </div>
                </div>
            }

            
            <div class="modal-footer justify-content-center button border-top-0 pt-2 px-5">
                @if(infoPembatalan == null)
                {
                        <button type="button" @onclick="@( x => BatalkanPesanan(null, true))" class="btn btn-danger bg-danger" style="font-weight:500; font-size:15px; z-index:0; letter-spacing:-0.5px; width:fit-content; border-radius:0px;">
                            <span class="position-relative">
                                @if(loadProses) 
                                {
                                    <div class="spinner-border spinner-border-sm" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                } 
                                else {
                                    @("Batalkan Pesanan")
                                }
                                </span>
                        </button>
            
                } else {
                    <button type="button" id="closeModal" data-bs-dismiss="modal" class="btn btn-danger bg-danger" style="font-weight:500; font-size:15px; z-index:0; letter-spacing:-0.5px; width:fit-content;border-radius:0px;">
                        <span class="position-relative">Tutup</span>
                    </button>
                }
            </div>
                

        </div>
    </div>
</div>

<div class="modal fade review-modal" id="exampleModalChangeNumber" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
     <div class="modal-dialog modal-dialog-centered" style="max-width:480px;height: 33rem;">
        <div class="modal-content" style="border-radius: 0px; border-radius: 0px; height: fit-content; overflow: hidden;" >
            <div class="d-flex flex-column login-effect">

                <div class="otp-view" style="">
                    <div class="modal-header justify-content-center d-flex flex-column border-bottom-0 pb-0">
                        <h5 class="modal-title w-100 text-xl-center" id="exampleModalLabel" style="letter-spacing: -1px; font-size: 22px;font-weight: 400;">Verifikasi OTP</h5>
                        <button type="button" id="closeLoginRegis" style="position: absolute;top: 25px;right: 25px;" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pb-3">
                        <div class="row">
                            <div class="col-12">
                                <OtpPage IdInfo=@dataChange NoTlp=@ModelRegist.NoTlp Pass=@ModelRegist.Password/>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="signup-page" style="">
                    <div class="modal-header justify-content-center d-flex flex-column border-bottom-0 pb-0">
                        <h5 class="modal-title w-100 text-xl-center" id="exampleModalLabel" style="letter-spacing: -1px; font-size: 22px;font-weight: 400;">
                            Ganti Nomer Telepon
                        </h5>
                        <button type="button" style="position: absolute;top: 25px;right: 25px;" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
            
                    <div class="modal-body pb-3">
                        <div class="row">
                            <div class="col-12">
                                <div class="input-group mb-3 style-grup px-1 border-1 pt-2 pb-2 form-style">
                                    <InputText id="phone-change" @bind-value=@ModelRegist.NoTlp @oninput=@(x => NumberOnlyInput(x, "regist")) type="tel" name="phone" class="form-control search-form form-text input-otp" autocomplete="off" aria-label="Search" aria-describedby="basic-addon1" placeholder="Nomer Telepon Baru (e.x 081234567899) *" required style="padding-left: 85px; font-size: 14px;" />
                                </div>

                                <div>
                                    <div id="result-change" class="result-box" style="display:none;">
                                        <strong id="e164Number-change"></strong>
                                    </div>
                                </div>

                                <p style="font-size:13px; font-weight:300; font-style:italic;">Kolom yang bertanda * wajib diisi.</p>
                            </div>
                        </div>
                    </div>

                    @if (infoSubmit == 2) {
                        <div class="toast show showing align-items-center mt-1 mb-3 mx-auto border-0 shadow-none" style="opacity : 1 !important;" role="alert" aria-live="assertive" aria-atomic="true">
                            <div class="d-flex w-100">
                                <div class="toast-body text-center w-100">
                                    <strong class="me-auto text-danger text-center">Nomor telpon tidak valid !</strong>
                                </div>
                            </div>
                        </div>
                    } 

                    @if (infoSubmit == 1) {
                        <div class="toast show showing align-items-center mt-1 mb-3 mx-auto border-0 shadow-none" style="opacity : 1 !important;" role="alert" aria-live="assertive" aria-atomic="true">
                            <div class="d-flex w-100">
                                <div class="toast-body text-center w-100">
                                    <strong class="me-auto text-danger text-center">Isi nomer telepon yang baru !</strong>
                                </div>
                            </div>
                        </div>
                    } 

            
                    <div class="modal-footer justify-content-center button border-top-0 pt-5 pb-3 px-5">
                        <button type="submit" @onclick="@(x => changeLogin("otp-view", false, "nomer"))" class="btn-slide py-2 px-4" style="font-weight:500; font-size:15px; z-index:0; letter-spacing:-0.5px; width:fit-content;">
                            <span class="position-relative">Perbarui Nomer</span>
                        </button>
                    </div>
                </div>
                
                <div class="login-page active" style="">
                    <div class="modal-header justify-content-center d-flex flex-column border-bottom-0 pb-0">
                        <h5 class="modal-title w-100 text-xl-center" id="exampleModalLabel" style="letter-spacing: -1px; font-size: 22px;font-weight: 400;">
                            Ganti Kata Sandi
                        </h5>
                        <button type="button" style="position: absolute;top: 25px;right: 25px;" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body pb-3">
                        <div class="row">
                            <div class="col-12">
                                <div class="input-group mb-3 style-grup px-1 border-1 py-1 pb-2 form-style">
                                    <InputText type="password" @bind-value=@ModelRegist.Password id="Password-Regist" style="font-size: 14px;" class="form-control search-form form-text" placeholder="Masukkan Kata Sandi Baru *" autocomplete="off" aria-label="Search" aria-describedby="basic-addon1" required />
                                </div>

                                <p style="font-size:13px; font-weight:300; font-style:italic;">Kolom yang bertanda * wajib diisi.</p>
                            </div>
                        </div>
                    </div>

                    @if (infoSubmit == 1) {
                        <div class="toast show showing align-items-center mt-1 mb-3 mx-auto border-0 shadow-none" style="opacity : 1 !important;" role="alert" aria-live="assertive" aria-atomic="true">
                            <div class="d-flex w-100">
                                <div class="toast-body text-center w-100">
                                    <strong class="me-auto text-danger text-center">Isi kata sandi yang baru !</strong>
                                </div>
                            </div>
                        </div>
                    } 

                    <div class="modal-footer justify-content-center button border-top-0 pt-5 pb-3 px-5">
                        <button type="submit" @onclick="@(x => changeLogin("otp-view", false, "password"))" class="btn-slide py-2 px-4" style="font-weight:500; font-size:15px; z-index:0; letter-spacing:-0.5px; width:fit-content;">
                            <span class="position-relative">Perbarui Kata Sandi</span>
                        </button>
                    </div>
                </div>
        
            </div>
        </div>
    </div>
</div>


<style>
