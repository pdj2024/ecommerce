        function fillAddress(components, lat, lng) {
            const get = (type) => components.find(c => c.types.includes(type))?.long_name || "";

            const address = {
                streetDetail: (get("route") + " " + get("street_number")).trim(),
                district: get("administrative_area_level_3"),
                city: get("administrative_area_level_2"),
                province: get("administrative_area_level_1"),
                postcode: get("postal_code"),
                latitude: lat,
                longitude: lng
            };

            dotNetMap.invokeMethodAsync("CurrentAddress", address);
        }

        function normalizeComponents(components) {
          return components.map(c => {
            // Geocoder lama (klik map)
            if (c.long_name) {
              return {
                long_name: c.long_name,
                short_name: c.short_name,
                types: c.types
              };
            }

            // Places API baru (autocomplete)
            // properti disingkat oleh Google (nh = longText, oh = shortText, mh = types)
            if (c.nh && c.mh) {
              return {
                long_name: c.nh,
                short_name: c.oh,
                types: c.mh
              };
            }

            return null;
          }).filter(Boolean);
        }


