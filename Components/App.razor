        function initslideHomeProduct() {

            const products = document.querySelectorAll(".product");

            if (products.length === 0) return;

            const observer = new IntersectionObserver(entries => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("show");
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.2 });

            products.forEach(p => observer.observe(p));
        }

        function initslideProduct() {
            const products = document.querySelectorAll(".product");

            if (products.length === 0) return;

            const observer = new IntersectionObserver(entries => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("show");
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.2 });

            products.forEach(p => observer.observe(p));
        }

        function initItemsOrder(data) {
            const headerBtn = document.querySelector(".header-accord-" + data);
            const noneAccords = document.querySelectorAll(".none-accord-" + data);

            if (!headerBtn) return;

            if (!headerBtn.classList.contains("collapsed")) {
                // kalau accordion terbuka ? sembunyikan
                noneAccords.forEach(el => {
                    el.classList.add("hide");
                    setTimeout(() => {
                        el.style.setProperty("display", "none", "important");
                    }, 10);
                });
            } else {
                // kalau accordion tertutup ? tampilkan lagi
                noneAccords.forEach(el => {
                    el.style.display = "block";
                    setTimeout(() => {
                        el.classList.remove("hide");
                    }, 10);
                });
            }
        }

