@rendermode InteractiveServer

<div class="offcanvas offcanvas-end" style="width: 500px;" tabindex="-1" id="offdetailprod" aria-labelledby="offdetailprod">
    <div class="offcanvas-body" style="padding:0px 0px 10px 0px !important;">
        <button id="closeDetailProd" type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" style="position: absolute;top: 10px;right: 25px;padding: 1rem; z-index: 20; background-color: white;border-radius: 100%;" aria-label="Close"></button>
        
        <div class="row" style="gap:2rem;width: 100%;margin-left: 0px !important;">
            <div class="col-12" style="padding:0px">
                <div class="swiper mySwiper1">
                    <div class="swiper-wrapper">
                        @foreach (var img in DataProduk?.MediaUrls)
                        {
                            <div class="swiper-slide">
                                <Image Src="@img.Id_Media" Class="vw-100 h-100" />
                            </div>
                        }
                    </div>
                    <div class="swiper-button-next"></div>
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-pagination"></div>
                </div>
            </div>

            <div class="col-12 item-details" style="background-color:white;padding: 0px 20px 80px 20px;">
                <div class="product-info" style="padding:0px;">
                    <h2 class="title">@DataProduk?.Nama_Display</h2>
                    <p class="category" style="display: flex;align-items: center;">
                        <svg xmlns="http://www.w3.org/2000/svg" style="width: 14px;transform: scaleX(-1);margin-right: 6px;" viewBox="0 0 640 640">
                            <path d="M96.5 160L96.5 309.5C96.5 326.5 103.2 342.8 115.2 354.8L307.2 546.8C332.2 571.8 372.7 571.8 397.7 546.8L547.2 397.3C572.2 372.3 572.2 331.8 547.2 306.8L355.2 114.8C343.2 102.7 327 96 310 96L160.5 96C125.2 96 96.5 124.7 96.5 160zM208.5 176C226.2 176 240.5 190.3 240.5 208C240.5 225.7 226.2 240 208.5 240C190.8 240 176.5 225.7 176.5 208C176.5 190.3 190.8 176 208.5 176z" /></svg>
                        Kategori:
                        @foreach (var kategori in DataProduk.Nama_Kategori)
                        {
                            <a href="javascript:void(0)">
                                @kategori
                            </a>
                        }
                    </p>
                    <h3 class="price">
                        @string.Format("Rp. {0:N0}", DataProduk?.Harga) @if (DataProduk?.Diskon1 != null || DataProduk?.Diskon1 >= 1) {
                        <span>@string.Format("Rp. {0:N0}", ((DataProduk?.Diskon1 / 100) * DataProduk?.Harga))</span>
                                                }
                    </h3>
                    <p class="info-text">
                        @DataProduk?.Deskripsi
                    </p>

                    <div class="row" style="margin-bottom:20px;">
                        <h5 class="tag-variasi" style="font-weight:400;"><span style="font-weight:800">Opsi:</span> @DataProduk.Option_Default</h5>
                        <div class="size-options d-flex flex-row flex-wrap" style="gap: 10px;">
                            @foreach (var Option in DataProduk?.Options)
                            {
                                <label style="gap: 15px; width:fit-content; justify-content:start;" class="size-box pe-3 @(DataProduk.Id_Option_Default == Option.Option_Id ? "active" : "")">
                                    <Image Style="width:50px; height:50px;" Src="@Option.MediaUrl?.Id_Media" />
                                    <input type="radio" name="variant" value="@Option.Option_Id"
                                            checked="@(DataProduk.Id_Option_Default == Option.Option_Id)"
                                            @onchange="() => OnVariantChanged(Option.Option_Id)" />
                                    <span style="width: fit-content;overflow: hidden;text-overflow: ellipsis; text-align:center;">@Option.Option_Label</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="row">
                        <h5 class="tag-variasi" style="font-weight:400;"><span style="font-weight:800">Size:</span> @DataProduk.Size_Default</h5>
                        <div class="size-options d-flex flex-row flex-wrap" style="gap: 10px;">
                            @foreach (var size in DataProduk?.Sizes)
                            {
                                <label class="size-box @(DataProduk.Id_Size_Default == size.Size_Id ? "active" : "")">
                                    <input type="radio" name="size" value="@size.Size_Id"
                                            checked="@(DataProduk.Id_Size_Default == size.Size_Id)"
                                            @onchange="() => OnSizeChanged(size.Size_Id)" />
                                    <span style="">@size.Size_Label</span>
                                </label>
                            }
                        </div>
                    </div>


                    <div class="bottom-content">
                        <div class="row align-items-end row-style" style="">
                            <div class="col-lg-4 col-md-4 col-12 rowbox-style">
                                <div class="qty-box">
                                    <button @onclick="Decrease">-</button>
                                    <span style="font-size:15px;">@Quantity</span>
                                    <button @onclick="Increase">+</button>
                                </div>
                            </div>
                            <div class="col-lg-8 col-md-8 col-12 rowbox-style ps-md-2 ps-0">
                                <div class="wish-button">
                                    <button @onclick=@(() => tambahKeranjang(DataProduk)) class="btn" style="border-radius:0px;">
                                    @if(loadProses)
                                    {
                                        <div class="spinner-border" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    } else
                                    {
                                        <span>Tambahkan</span><i class="lni lni-cart-2 ms-2"/>
                                    }
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="row align-items-end mt-3 row-style">
                            <div class="col-12 rowbox-style">
                                <div class="button cart-button" >
                                    <button class="btn" @onclick="@(e => NavigateToHome("payment-page"))" style="width: 100%;display: flex; border-radius:0px; z-index:0;">Beli Sekarang</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            
            <div class="ps-0" style="position:fixed; bottom:0px; width:500px;">
                <div class="" style="width:100%; padding-right:5px;">
                    <div class="btn-group w-100">
                        <button @onclick="@(e => NavigateToDetailProduk(DataProduk.No_Id))" class="btn-slide border-start-0 border-bottom-0 border-end-0 justify-content-between" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="padding: 20px 12px 20px 20px;font-size: 15px;font-weight: 500;">
                            View Full Details <i class="lni lni-chevron-up" style="transform: rotateZ(90deg);font-size: 20px;font-weight: 400;"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
    </div>
</div>

