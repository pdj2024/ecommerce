                                                                <span class="visually-hidden">Loading...</span>
                                                            </div>

                                                            <div class="spinner-grow spinner-grow-sm text-warning position-absolute top-2 left-0" role="status">
                                                                <span class="visually-hidden">Loading...</span>
                                                            </div>

                                                            <div class="spinner-grow spinner-grow-sm text-warning position-absolute top-2 left-0" style="animation: .65s linear infinite spinner-grow;" role="status">
                                                                <span class="visually-hidden">Loading...</span>
                                                            </div>
                                                            <p class="ms-4 text-warning">Cepat, hanya tersisa @( dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Stock.ToString()) barang dalam stok.
                                                                
                                                                @if(dataSourch.DataProduk.Show_Min_Order)
                                                                {
                                                                    <span class="ms-3 text-danger" style="font-size: 13px; font-weight: 700;" >
                                                                        *Minimal order @dataSourch?.DataProduk?.Min_Order item
                                                                    </span>
                                                                }

                                                                @if(dataSourch.DataProduk.Show_Max_Order)
                                                                {
                                                                    <span class="ms-3 text-danger" style="font-size: 13px; font-weight: 700;" >
                                                                        *Maximal order @dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default).Stock item
                                                                    </span>
                                                                }
                                                            </p>
                                                        </div>
                                                    </div>
                                                } else {
                                                    <div class="col-12">
                                                        <div style="position:relative" class="d-flex flex-column justify-content-center">
                                                            <div class="spinner-grow spinner-grow-sm text-primary position-absolute top-2 left-0" style="animation: .85s linear infinite spinner-grow;" role="status">
                                                                <span class="visually-hidden">Loading...</span>
                                                            </div>

                                                            <div class="spinner-grow spinner-grow-sm text-primary position-absolute top-2 left-0" role="status">
                                                                <span class="visually-hidden">Loading...</span>
                                                            </div>

                                                            <div class="spinner-grow spinner-grow-sm text-primary position-absolute top-2 left-0" style="animation: .65s linear infinite spinner-grow;" role="status">
                                                                <span class="visually-hidden">Loading...</span>
                                                            </div>
                                                            <p class="ms-4 text-primary">Tersisa @( dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Stock.ToString()) stok
                                                                
                                                                @if(dataSourch.DataProduk.Show_Min_Order)
                                                                {
                                                                    <span class="ms-3 text-danger" style="font-size: 13px; font-weight: 700;" >
                                                                        *Minimal order @dataSourch?.DataProduk?.Min_Order item
                                                                    </span>
                                                                }

                                                                @if(dataSourch.DataProduk.Show_Max_Order)
                                                                {
                                                                    <span class="ms-3 text-danger" style="font-size: 13px; font-weight: 700;" >
                                                                        *Maximal order @dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default).Stock item
                                                                    </span>
                                                                }
                                                            </p>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        
                                        } else
                                        {
                                            <p class="text-danger">
