                            @foreach (var Option in DataProduk.Options)
                            {
                                <label style="gap: 15px; width:100%; justify-content:start;" class="size-box @(DataProduk.Id_Option_Default == Option.Option_Id ? "active" : "")">
                                    <Image Style="width:50px; height:50px;" Src="@Option.MediaUrl.Id_Media" />
