                            </div>
                            <div style="display:flex; flex-direction:column; gap:5px; width:50%;">
                                <h5 class="va-title">Status</h5>
                                <h4 class="va-title-sec" style=@(Head?.Status_Order_1 == "belum bayar" ? "color:red" : "color:orange")> 
                                    @ti.ToTitleCase(Head?.Status_Order_1) 
                                </h4>
                            </div>
                        </div>

                        <div style="display:flex; flex-direction:row;">
                            <div style="display:flex; flex-direction:column; gap:5px; width:50%;">
                                <h5 class="va-title">Total Pembayaran</h5>
                                <h4 class="va-title-total">@string.Format("Rp. {0:N0}", @Head?.Grand_Total)</h4>
                            </div>
                            <div style="display:flex; flex-direction:column; gap:5px; width:50%;">
                                <h5 class="va-title">Metode</h5>
                                <h4 class="va-title-sec">@Head?.Metode_Bayar</h4>
                            </div>
                        </div>

                        @if (@Head?.Metode_Bayar != "QRIS" && @Head?.Status_Order_1 == "belum bayar") 
                        {
                            <div style="display:flex; flex-direction:row;">
                                <div style="display:flex; flex-direction:column; gap:5px; width:50%;">
                                    <h5 class="va-title">Expired</h5>
                                    <h4 class="va-title-total">@Head?.Expiry_Time?.ToLocalTime()</h4>
                                </div>
                            </div>
                        }
                    
                        @if (@Head?.Metode_Bayar == "QRIS" && @Head?.Status_Order_1 == "belum bayar") 
                        {
                            <div class="d-flex align-items-center justify-content-center mt-3">
                                <img class="qr-payment" style="max-width:50%" src="@Head?.QrBase64" alt="Alternate Text" />
                            </div>
                        }
                        else if (@Head?.Metode_Bayar != "QRIS" && @Head?.Status_Order_1 == "belum bayar")
                        {
                            @if (@Head?.Metode_Bayar == "VA MANDIRI" || @Head?.Metode_Bayar == "COUNTER INDOMARET") {
                                <div>
                                    <div class="va-box" data-va="@Head?.Payment_Number_1">
                                        <div class="va-content">
                                            <div class="va-header">@(Head?.Metode_Bayar == "VA MANDIRI" ? "Biller Code" : "Payment Code")</div>
                                            <div class="va-body" id="va-text">
                                                @Head?.Payment_Number_1
                                                <button class="copy-btn copy-btn-@Head?.No_Bukti-code" type="button" aria-label="Copy VA" @onclick=@( x => clickCopy(Head,"-code"))>Copy</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="va-box" data-va="@Head?.Payment_Number_2">
                                        <div class="va-content">
                                            <div class="va-header">@(Head?.Metode_Bayar == "VA MANDIRI" ? "Bill Key" : "Merchant Id")</div>
                                            <div class="va-body" id="va-text">
                                                @Head?.Payment_Number_2
                                                <button class="copy-btn copy-btn-@Head?.No_Bukti-key" type="button" aria-label="Copy VA" @onclick=@( x => clickCopy(Head,"-key"))>Copy</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else {
                                <div>
                                    <div class="va-box" data-va="@Head?.Payment_Number_1">
                                        <div class="va-content">
                                            <div class="va-header">Nomor VA</div>
                                            <div class="va-body" id="va-text">
                                                @Head?.Payment_Number_1
                                                <button class="copy-btn copy-btn-@Head?.No_Bukti" type="button" aria-label="Copy VA" @onclick=@( x => clickCopy(Head))>Copy</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                    </div>

                    <div class="modal-footer">
                        @if (@Head?.Status_Order_1 == "belum bayar") {
                            <button type="button" style="min-width:7rem;" disabled=@loadProses class="btn btn-primary" @onclick="@( x => refreshStatus(Head))" >
                                @if(loadProses) 
                                {
                                    <div class="spinner-border" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                } 
                            
                                else
                                {
                                    @("Refresh")
                                }
                            </button>
                        }

                        @if (@Head?.Metode_Bayar == "QRIS" && @Head?.Status_Order_1 == "belum bayar") 
                        {
                            <button type="button" class="btn btn-success" @onclick="@( x => DownloadImage(Head))" >Download</button>
                        }

                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" >Tutup</button>
                    </div>

                }
            
            
            </div>
        </div>
    </div>


<MyFooter @ref="footer_page"/>