                            <div class="col-12 py-xl-2">
                            </div>

                            <div class="breadcrumbs p-0 py-4" style="">
                                <div class="container-fluid px-2">
                                    <div class="row align-items-center">
                                        <div class="col-12 px-0 pb-2">
                                            <ul class="breadcrumb-nav">
                                                <li><div class="skeleton skeleton-subtitle mb-2" style="width:50%"></div></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div style="--swiper-navigation-color: #fff; --swiper-pagination-color: #fff" class="swiper mySwiper2">
                                <div class="row">
                                    <div class="w-100 col-12">
                                        <div class="skeleton skeleton-rect mb-3" style="border-radius:0px;height:30rem;width:100%;"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12 d-flex">
                                    <div class="col-3">
                                        <div class="skeleton skeleton-rect mb-3" style="border-radius:0px;height:10rem;width:100%;"></div>
                                    </div>
                                    <div class="col-3">
                                        <div class="skeleton skeleton-rect mb-3" style="border-radius:0px;height:10rem;width:100%;"></div>
                                    </div>
                                    <div class="col-3">
                                        <div class="skeleton skeleton-rect mb-3" style="border-radius:0px;height:10rem;width:100%;"></div>
                                    </div>
                                    <div class="col-3">
                                        <div class="skeleton skeleton-rect mb-3" style="border-radius:0px;height:10rem;width:100%;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
