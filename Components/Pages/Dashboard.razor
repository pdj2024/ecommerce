@rendermode InteractiveServer
@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using PacificWeb.Components.Sections
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@GlobalDataService?.GlobalData?.ListDataCompany?.FirstOrDefault()?.Nama_Toko</PageTitle>


<MyHeader @ref="header_page" />

 <!-- Start Hero Area -->
@if (loadContent)
{
    <section class="hero-area" style="margin-top: 85px;">
        <div class="container p-0 pe-lg-3" style="width:100%; max-width:100%;">
            <div class="row">
                <div class="col-12 custom-padding-right">
                    <div class="card py-3 px-0 border-0" style="border-radius:0px;" aria-busy="true">
                        <div class="skeleton skeleton-rect mb-3" style="border-radius:0px;height:100dvh"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
else 
{
    <section class="hero-area" style="margin-top: 85px;">
    <div class="container p-0 pe-lg-3" style="width:100%; max-width:100%;">
        <div class="row">
            <div class="col-12 custom-padding-right d-none d-md-none d-lg-none d-xl-none d-xxl-flex">
                <div class="slider-head">

                    <!-- Start Hero Slider -->
                    <div class="hero-slider">
                        <!-- Start Single Slider -->
                        @foreach (var banner in GlobalDataService?.GlobalData?.ListDataBanner)
                        {
                            <div class="single-slider">
                                @if (@banner.Media_Desktop.Id_Media != null || @banner.Media_Desktop.Id_Media != "")
                                {
                                    <Image Src="@banner.Media_Desktop.Id_Media" Class="img-cover" Style="max-height:54rem"></Image>
                                } else
                                {
                                    <Image Src="/images/products/placeholder1.png" Class="img-cover" Style="max-height:54rem"></Image>
                                }
                            </div>


                        }
                        <!-- End Single Slider -->
                    </div>
                    <!-- End Hero Slider -->

                </div>
            </div>

            <div class="col-12 custom-padding-right d-none d-md-none d-lg-none d-xl-flex d-xxl-none">
                <div class="slider-head">

                    <!-- Start Hero Slider -->
                    <div class="hero-slider-laptop">
                        <!-- Start Single Slider -->
                        @foreach (var banner in GlobalDataService?.GlobalData?.ListDataBanner)
                        {
                            <div class="single-slider">
                                @if (@banner.Media_Desktop.Id_Media != null || @banner.Media_Desktop.Id_Media != "")
                                {
                                    <Image Src="@banner.Media_Desktop.Id_Media" Class="img-cover" Style="max-height:54rem"></Image>
                                }
                                else
                                {
                                    <Image Src="/images/products/placeholder1.png" Class="img-cover" Style="max-height:54rem"></Image>
                                }
                            </div>
                        }
                        <!-- End Single Slider -->
                    </div>
                    <!-- End Hero Slider -->

                </div>
            </div>

            <div class="col-12 custom-padding-right d-none d-md-flex d-lg-flex d-xl-none">
                <div class="slider-head">

                    <!-- Start Hero Slider -->
                    <div class="hero-slider-tablet">
                        <!-- Start Single Slider -->
                        @foreach (var banner in GlobalDataService?.GlobalData?.ListDataBanner)
                        {
                            <div class="single-slider">
                                @if (@banner.Media_Tablet.Id_Media != null || @banner.Media_Tablet.Id_Media != "")
                                {
                                    <Image Src="@banner.Media_Tablet.Id_Media" Class="img-cover" Style="max-height:54rem"></Image>
                                }
                                else
                                {
                                    <Image Src="/images/products/placeholder1.png" Class="img-cover" Style="max-height:54rem"></Image>
                                }
                            </div>
                        }
                        <!-- End Single Slider -->
                    </div>
                    <!-- End Hero Slider -->

                </div>
            </div>

            <div class="col-12 custom-padding-right d-flex d-md-none d-lg-none d-xl-none">
                <div class="slider-head">

                    <!-- Start Hero Slider -->
                    <div class="hero-slider-phone">
                        <!-- Start Single Slider -->
                        @foreach (var banner in GlobalDataService?.GlobalData?.ListDataBanner)
                        {
                            <div class="single-slider">
                                @if (@banner.Media_Phone.Id_Media != null || @banner.Media_Phone.Id_Media != "")
                                {
                                    <Image Src="@banner.Media_Phone.Id_Media" Class="img-cover" Style="max-height:54rem"></Image>
                                }
                                else
                                {
                                    <Image Src="/images/products/placeholder1.png" Class="img-cover" Style="max-height:54rem"></Image>
                                }
                            </div>
                        }
                        <!-- End Single Slider -->
                    </div>
                    <!-- End Hero Slider -->

                </div>
            </div>

        </div>
    </div>
</section>
}
<!-- End Hero Area -->


<!-- Start Slider Brand Area -->
@if (!loadContent)
{
    <section class="slider-container-brand">
        <div class="slider-brand">
            <div class="slide-track-brand">
                @foreach (var brand in GlobalDataService?.GlobalData?.ListDataBrand)
                {
                    <a class="slide-brand"><img @onclick=@(x => SearchCombo(brand)) style="cursor: pointer;" src="@brand.Id_Media" alt="@brand.No_Id_Media"></a>
                }

                @foreach (var brand in GlobalDataService?.GlobalData?.ListDataBrand)
                {
                    <a class="slide-brand"><img @onclick=@(x => SearchCombo(brand)) style="cursor: pointer;" src="@brand.Id_Media" alt="@brand.No_Id_Media"></a>
                }

                @foreach (var brand in GlobalDataService?.GlobalData?.ListDataBrand)
                {
                    <a class="slide-brand"><img @onclick=@(x => SearchCombo(brand)) style="cursor: pointer;" src="@brand.Id_Media" alt="@brand.No_Id_Media"></a>
                }

            </div>
        </div>
    </section>
}
<!-- End Slider Brand Area -->

<!-- Start Trending Product Area -->
<section class="trending-product section px-0 px-lg-3 px-xl-5 px-xxl-10" style="margin-top: 0px;">
    <div class="container-fluid">
        <div class="row py-0 py-lg-3 py-xl-4 py-xxl-5">
            <div class="col-12">
                <div class="section-title">
                    <h2>@GlobalDataService.GlobalData.ListDataTexkSection.FirstOrDefault(x => x.Section_Name == "section1")?.Judul</h2>
                    <p>
                        @GlobalDataService.GlobalData.ListDataTexkSection.FirstOrDefault(x => x.Section_Name == "section1")?.Keterangan
                    </p>
                </div>
            </div>
        </div>
        <div class="row"> 
                
            @if (loadContent)
            {
                @for (var i = 0; i <= 11; i++)
                {
                    <div class="col-lg-3 col-md-4 col-6 col-xxl-2 pt-2 pb-2">
                        <div class="card p-3 border-0" style="border-radius:0px;" aria-busy="true">
                            <div class="skeleton skeleton-rect mb-3"></div>
                            <div class="d-flex align-items-center justify-content-between">
                                <div style="flex:1" class="d-flex flex-column align-items-center">
                                    <div class="skeleton skeleton-title mb-2" style="width:90%"></div>
                                    <div class="skeleton skeleton-subtitle mb-2" style="width:50%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            } 
            
            @foreach (var dataProduk in GlobalDataService?.GlobalData?.ListDataProduk)
            {

                <div class="col-lg-3 col-md-4 col-6 col-xxl-2 pt-2 pb-2 product">

                    <!-- Start Single Product -->
                    <PacificWeb.Components.Sections.ProductDisplay DataProduk="dataProduk" selectProduk="@selectProduk" />
                    <!-- End Single Product -->

                </div>
            
            }

        </div>
    </div>
</section>
<!-- End Trending Product Area -->

<!-- Start Call Action Area -->
<section class="call-action section">
    <div class="container">
        <div class="row ">
            <div class="col-lg-8 offset-lg-2 col-12">
                <div class="inner">
                    <div class="content">
                        <h2 class="wow fadeInUp mt-3" data-wow-delay=".4s">
                            @GlobalDataService.GlobalData.ListDataTexkSection.FirstOrDefault(x => x.Section_Name == "section2")?.Judul
                        </h2>
                        <p class="wow fadeInUp" data-wow-delay=".6s">
                            @GlobalDataService.GlobalData.ListDataTexkSection.FirstOrDefault(x => x.Section_Name == "section1")?.Keterangan
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- End Call Action Area -->

@if (loadContent)
{
    <!-- Start Banner Area -->
    <section class="banner section px-0 px-lg-3 px-xl-5 px-xxl-10">
    <div class="container-fluid">
        <div class="row">
            @for (var i = 0; i <= 2; i++)
            {
                <div class="col-lg-4 col-md-4 col-12">
                    <div class="card py-3 px-0 border-0" style="border-radius:0px;" aria-busy="true">
                        <div class="skeleton skeleton-rect mb-3" style="border-radius:0px;height:100dvh"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
}

<section class="banner section px-0 px-lg-3 px-xl-5 px-xxl-10">
    <div class="container-fluid">
        <div class="row">
            @foreach (var kategori in GlobalDataService?.GlobalData?.ListDataKategori)
            {
                @if (kategori.Nama_Group_Kategori.ToLower() != "gender") { continue; }
                <div class="col-lg-4 col-md-4 col-12" style="margin-bottom: 20px;">
                    <div class="single-banner">
                        <div class="content" style="overflow: hidden; height:40vw;">
                            <Image Src="@kategori.Id_Media" Class="image-content"/>
                            <div class="content-single">
                                <div class="button">
                                    <button @onclick=@(x => header_page.searchCombo(null, null, kategori)) class="btn content-btn">Katalog @kategori.Nama_Kategori</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- End Banner Area -->

<SelectProduk DataProduk="DataProduk" Quantity=@DataProduk.Min_Order header_page="header_page"/>

<MyFooter @ref="footer_page" />