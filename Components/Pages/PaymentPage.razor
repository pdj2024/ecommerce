                                                        <div class="summary-item__meta" style="font-size:13px">@($"{display?.Qty} x " + string.Format("Rp. {0:N0}", (display?.Harga - (display?.Harga * (display?.Diskon1 / 100)))))</div>
                                                    </div>
                                                    <div style="font-weight: 600;">@string.Format("Rp. {0:N0}", ((display?.Harga * display?.Qty) - ((display?.Harga * display?.Qty) * (display?.Diskon1 / 100))))</div>
                                                </div>
                                            }
                                        </div>
