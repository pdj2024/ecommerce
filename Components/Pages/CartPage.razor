                                                        </button>
                                                    }
                                                </div>
                                                <button @onclick="@( x => openPayment(@item))" class="btn none-accord-@item.No_Bukti btn-primary" style="height: 36px !important;border-radius: 0px !important;font-size: 13px !important;padding: 0px 14px !important;" id="modalPaymentStatus2" type="button" data-bs-toggle="modal" data-bs-target="#staticBackdrop2">
                                                    Bayar Sekarang
                                                </button>
                                            </div>
                                        </div>

                                    </div>
                                </h2>



                                <div id="panelsStayOpen-@item.No_Bukti" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingOne">
                                    <div class="accordion-body px-3 px-lg-4">
                                        @foreach(var produk in dataSourch?.DataPesanan?.Items.Where(x => x.No_Bukti == item.No_Bukti).ToList())
                                        {
                                            @if(produk.Id_Detil == @dataSourch?.DataPesanan?.Items.FirstOrDefault(x => x.No_Bukti == item.No_Bukti).Id_Detil) { continue; }

                                            <div class="d-flex flex-col gap-3 w-100">
                                                @if(@produk.Var_Id_Media != null && @produk.Var_Id_Media != "")
                                                {
                                                    <img class="cart-img img-payment" src="@produk.Var_Id_Media" style="" alt="#">
                                                } 
                                                        
                                                else
                                                {
                                                    <div class="cart-img img-payment" style="display:flex; align-items:center;justify-content:center; background-color:lightgray; color:dimgrey">
                                                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M73-889 889-73l-57 57-104-104H200q-33 0-56.5-23.5T120-200v-528L16-832l57-57Zm287 447L200-282v82h448L544-304l-22 24-162-162ZM200-648v252l126-126-126-126Zm36-192h524q33 0 56.5 23.5T840-760v524l-80-80v-234L650-426l-57-57 167-187v-90H316l-80-80Zm357 357Zm-158 70ZM326-522Zm34 80Zm176-98Z"/></svg>
                                                    </div>
                                                }
                                                <div class="d-flex flex-column gap-2 w-100 justify-content-between">
                                                    <div class="d-flex flex-column gap-2">
                                                        <h5 style="font-size:15px;" class="line-clamp-1">
                                                            @produk.Nama_Display
                                                        </h5>
                                                        <p class="variant" style="background-color: #eee;width: fit-content;padding: 1px 5px;border-radius: 0px;">
                                                            @($"{@produk.Var_Option}, {@produk.Var_Size}")
                                                        </p>
                                                        <h5 style="font-size:15px;" class="">
                                                            @string.Format("Rp. {0:N0}", @produk.Harga_Satuan) 
                                                            @($" x {produk.Qty} = ")
                                                            <span style="color:#1500b2; font-weight:700;" class="d-lg-inline d-none">
                                                                @string.Format("Rp. {0:N0}", produk.Harga_Total)
                                                            </span>
                                                        </h5>
                                                        <h5 style="font-size:15px;" class="d-lg-none d-flex line-clamp-1">
                                                            <span style="color:#1500b2; font-weight:700;">
                                                                @string.Format("Rp. {0:N0}", produk.Harga_Total)
                                                            </span>
                                                        </h5>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        <div class="d-flex flex-row gap-1 w-100 justify-content-between align-items-center">
                                            <div class="d-flex flex-column gap-1 total-bottom">
                                                <h5 style="font-size:15px; " class="">
                                                    @($"Total {@dataSourch?.DataPesanan?.Items.Where(x => x.No_Bukti == item.No_Bukti).ToList().Count()} produk: ") 
                                                    <span style="color:#1500b2;">
                                                        @string.Format("Rp. {0:N0}", item.Grand_Total)
                                                    </span>
                                                </h5>
                                                @if(@dataSourch?.DataPesanan?.Items.Where(x => x.No_Bukti == item.No_Bukti).ToList().Count() >= 2) 
                                                {
                                                    <button @onclick="@( x => openDropdown(@item.No_Bukti))" class="accordion-button header-accord-@item.No_Bukti collapsed rounded-0 mt-1" style="padding: 0px;font-size: 13px;width: fit-content;display: flex;gap: 10px;" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-@item.No_Bukti" aria-expanded="true" aria-controls="panelsStayOpen-@item.No_Bukti"> Tampil Selangkapnya
                                                    </button>
                                                }
                                            </div>
                                            <button @onclick="@( x => openPayment(@item))" class="btn btn-primary" style="height: 36px !important;border-radius: 0px !important;font-size: 13px !important;padding: 0px 14px !important;" id="modalPaymentStatus2" type="button" data-bs-toggle="modal" data-bs-target="#staticBackdrop2">
                                                Bayar Sekarang
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    
                    
                    </div>
                </div>
            </div>
        </div>
        } else
        {
            <div class=" w-100 d-flex justify-content-center align-items-center" style="height: 10rem;margin-bottom: 10rem;" >
                <h5 style="font-size:1rem; color:lightgray; text-decoration:underline" >Tidak Ada Transaksi</h5>
            </div>
        }
    
        }

    </div>

    <div class="tab-pane fade @(pageTabs == "histori" ? "show active" : "")" id="pills-histori" role="tabpanel" aria-labelledby="pills-histori-tab">
        <div class="row" style="justify-content: center; margin-top: 7rem;">
            <div class="col-12">
                <div class="section-title" style="margin-bottom:0px;">
                    <h2>Histori Beli</h2>
                </div>
            </div>
        </div>

        @if (loadContent)
        {
            @for(var i = 0; i <= 5; i++)
            {
                <div class="" style="padding: 0px 20px 20px 20px; margin-top:20px;">
                    <div class="card p-3 mb-5 border-0" style="border-radius:0px;" aria-busy="true">
                        <div class="skeleton skeleton-rect mb-3"></div>
                            <div class="d-flex align-items-center justify-content-between">
                                <div style="flex:1">
                                    <div class="skeleton skeleton-title mb-2"></div>
                                    <div class="skeleton skeleton-subtitle mb-2" style="width:50%"></div>
                            </div>
                            <div class="ms-3">
                                <div class="skeleton skeleton-pill"></div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        } 
        else
        {
            @if (dataSourch?.DataPesanan?.Header.Count(x => x.Status_Order_1.ToLower() == "histori") >= 1) {

            } else
            {
                <div class=" w-100 d-flex justify-content-center align-items-center" style="height: 10rem;margin-bottom: 10rem;" >
                    <h5 style="font-size:1rem; color:lightgray; text-decoration:underline" >Tidak Ada Transaksi</h5>
                </div>
            }
        }

    
    
    </div>

</div>



<!-- Review Modal -->
<div class="modal fade review-modal" id="staticBackdrop2" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:600px;">
        <div class="modal-content" style="border-radius: 0px;" >
            <div class="modal-header justify-content-between d-flex border-bottom-0 pb-0">
                <h5 class="modal-title w-100 text-center" id="exampleModalLabel" style="letter-spacing: -1px; font-size: 22px;font-weight: 400;">Informasi Pembayaran</h5>
            </div>


            @if(loadRefresh) 
            {
                <form aria-busy="true" class="mb-2 px-5">
                    <div class="mb-3">
                        <div class="skeleton skeleton-subtitle mb-2" style="width:25%"></div>
                        <div class="skeleton" style="height:38px;width:100%;border-radius:.375rem"></div>
                    </div>
                    <div class="mb-3">
                        <div class="skeleton skeleton-subtitle mb-2" style="width:20%"></div>
                        <div class="skeleton" style="height:38px;width:100%;border-radius:.375rem"></div>
                    </div>
                </form>
                <form aria-busy="true" class="mb-5 px-5">
                    <div class="mb-3">
                        <div class="skeleton skeleton-subtitle mb-2" style="width:25%"></div>
                        <div class="skeleton" style="height:38px;width:100%;border-radius:.375rem"></div>
                    </div>
                    <div class="mb-3">
                        <div class="skeleton skeleton-subtitle mb-2" style="width:20%"></div>
                        <div class="skeleton" style="height:38px;width:100%;border-radius:.375rem"></div>
                    </div>
                    <div class="d-flex gap-2">
                        <div class="skeleton" style="width:120px;height:38px;border-radius:.375rem"></div>
                        <div class="skeleton" style="width:80px;height:38px;border-radius:.375rem"></div>
                    </div>
                </form>

                <div class="modal-footer justify-content-center button border-top-0 pt-2 px-5"> 
                    <button type="button" data-bs-dismiss="modal" class="btn-slide" style="font-weight:500; font-size:15px; z-index:0; letter-spacing:-0.5px; width:fit-content;">
                        <span class="position-relative">Tutup</span>
                    </button>
                </div>

            } else {

                @foreach (var Head in Pesanan_Create.Header)
                {
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-6">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                    <input readonly style="background-color:transparent !important; font-weight: 700; font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your name*" aria-label="Search" aria-describedby="basic-addon1" required value="@Head?.No_Bukti" />
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Order Id</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                    <input readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px; @(Head?.Status_Order_1 == "belum bayar" ? "color:red" : "color:orange")" type="text" class="form-control search-form form-text" placeholder="Your email*" aria-label="Search" aria-describedby="basic-addon1" required value="@ti.ToTitleCase(Head?.Status_Order_1)"/>
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Status</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                    <input readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your phone" aria-label="Search" aria-describedby="basic-addon1" required value="@Head?.Metode_Bayar"/>
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Metode Pembayaran</label>
                                </div>
                            </div>
                            @if (@Head?.Status_Order_1 == "belum bayar") {
                                <div class="col-6">
                                    <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                        <input readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your phone" aria-label="Search" aria-describedby="basic-addon1" required value="@Head?.Expiry_Time.ToString()" />
                                        <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Expired</label>
                                    </div>
                                </div>
                            }
                            <div class="col-12">
                                <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3">
                                    <input readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your phone" aria-label="Search" aria-describedby="basic-addon1" required value="@string.Format("Rp. {0:N0}", @Head?.Grand_Total)" />
                                    <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">Total Pembayaran</label>
                                </div>
                            </div>

                            <div class="col-12">
                                @if (@Head?.Metode_Bayar == "QRIS" && @Head?.Status_Order_1 == "belum bayar") 
                                {
                                    <div class="d-flex align-items-center justify-content-center mt-3">
                                        <img class="qr-payment" style="max-width:50%" src="@Head?.QrBase64" alt="Alternate Text" />
                                    </div>
                                }
                                else if (@Head?.Metode_Bayar != "QRIS" && @Head?.Status_Order_1 == "belum bayar")
                                {
                                    @if (@Head?.Metode_Bayar == "VA MANDIRI" || @Head?.Metode_Bayar == "COUNTER INDOMARET") 
                                    {
                                        <div class="col-12 ">
                                            <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3 va-box" style="border-radius:0px; max-width:100%" data-va="@Head?.Payment_Number_1">
                                                <input readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your phone" aria-label="Search" aria-describedby="basic-addon1" required value="@Head?.Payment_Number_1" />
                                                <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">
                                                    @(Head?.Metode_Bayar == "VA MANDIRI" ? "Biller Code" : "Payment Code")
                                                </label>
                                                <button class="copy-btn copy-btn-@Head?.Payment_Number_1-code border-0" style="border-radius: 0px;position: absolute;top: 12px;right: 15px;" type="button" aria-label="Copy VA" @onclick=@( x => clickCopy(Head, $"{Head?.Payment_Number_1}-code"))>Copy</button>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3 va-box" style="border-radius:0px; max-width:100%" data-va="@Head?.Payment_Number_2">
                                                <input readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your phone" aria-label="Search" aria-describedby="basic-addon1" required value="@Head?.Payment_Number_2" />
                                                <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">
                                                    @(Head?.Metode_Bayar == "VA MANDIRI" ? "Bill Key" : "Merchant Id")
                                                </label>

                                                <button class="copy-btn copy-btn-@Head?.Payment_Number_2-code border-0" style="border-radius: 0px;position: absolute;top: 12px;right: 15px;" type="button" aria-label="Copy VA" @onclick=@( x => clickCopy(Head, $"{Head?.Payment_Number_2}-code"))>Copy</button>
                                            </div>
                                        </div>
                                    }
                                    else 
                                    {
                                        <div class="col-12">
                                            <div class="input-group mb-3 style-grup px-1 border-1 form-style position-relative pb-1 pt-3 va-box" style="border-radius:0px; max-width:100%" data-va="@Head?.Payment_Number_1">
                                                <input readonly style="background-color:transparent !important; font-weight: 700;  font-size:15px;" type="text" class="form-control search-form form-text" placeholder="Your phone" aria-label="Search" aria-describedby="basic-addon1" required value="@Head?.Payment_Number_1" />
                                                <label style="position: absolute;top: 5px;left: 16px;font-size: 14px;letter-spacing: -0.5px; color: dimgray; font-style:italic">
                                                    Virtual Account
                                                </label>
                                                <button class="copy-btn copy-btn-@Head?.Payment_Number_1-code border-0" style="border-radius: 0px;position: absolute;top: 12px;right: 15px;" type="button" aria-label="Copy VA" @onclick=@( x => clickCopy(Head, $"{Head?.Payment_Number_1}-code"))>Copy</button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
            
                    <div class="modal-footer justify-content-center button border-top-0 pt-2 px-5">
                        <button type="button" style="min-width:7rem; border-radius:0px;" disabled=@loadProses class="btn btn-primary" @onclick="@( x => refreshStatus(Head))" >
                            @if(loadProses) 
                            {
                                <div class="spinner-border spinner-border-sm" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            } 
                            else
                            {
                                @("Refresh")
                            }
                        </button>

                        @if (@Head?.Metode_Bayar == "QRIS" && @Head?.Status_Order_1 == "belum bayar") 
                        {
                            <button type="button" class="btn btn-success" @onclick="@( x => DownloadImage(Head))" >Download</button>
                        }

                        <button type="button" data-bs-dismiss="modal" class="btn-slide" style="font-weight:500; font-size:15px; z-index:0; letter-spacing:-0.5px; width:fit-content;">
                            <span class="position-relative">Tutup</span>
                        </button>
                    </div>
                }

            }

        </div>
    </div>
</div>

<!-- End Review Modal -->
<MyFooter dataSourch=@dataSourch @ref="footer_page"/>