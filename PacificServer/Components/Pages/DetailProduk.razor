                                    {
                                        if (dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default) != null)
                                        {

                                            <div class="row mt-4">

                                                @if(dataSourch?.DataProduk?.Variants.FirstOrDefault(x => x.Option_Id == dataSourch?.DataProduk?.Id_Option_Default && x.Size_Id == dataSourch?.DataProduk?.Id_Size_Default)?.Stock <= 5) {
                                                    <div class="col-12">
                                                        <div style="position:relative" class="d-flex flex-column justify-content-center">
