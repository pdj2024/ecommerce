@inject Services.TabService TabService
@rendermode InteractiveServer
@using Models
@using Services

@if (loadContent)
{
    <header class="header navbar navbar-area">
        <!-- Start Header Bottom -->
        <div class="container-fluid px-md-5 px-2" style="height:100%">
            <div class="row align-items-center vw-100" style="height:100%; width:100%; margin:0px">
                <div class="col-4 d-flex align-items-center justify-content-start"><div class="skeleton skeleton-subtitle mb-2" style="width:50%"></div></div>
                <div class="col-4 d-flex align-items-center justify-content-center"><div class="skeleton skeleton-subtitle mb-2" style="width:80%"></div></div>
                <div class="col-4 d-flex align-items-center justify-content-end"><div class="skeleton skeleton-subtitle mb-2" style="width:50%"></div></div>
            </div>
        </div>
    </header>
}
else
{
    <header class="header navbar navbar-area">
        <!-- Start Header Bottom -->
        <div class="container-fluid px-md-5 px-2" style="height:100%">
            <div class="row align-items-center vw-100" style="height:100%; width:100%; margin:0px">

                <div class="col-xxl-2 col-lg-2 col-md-2 col-12 d-lg-flex d-none">
                    <!-- Start Header Logo -->
                    <NavLink class="navbar-brand" style="cursor:pointer;" @onclick="@(e => NavigateToHome(""))">
                        <img src="@(GlobalDataService?.GlobalData?.ListDataCompany?.FirstOrDefault()?.Media?.FirstOrDefault(x => x.Media_Type == "landscape").Id_Media ?? "images/logo/logo-pdj.png")" alt="Logo">
                    </NavLink>
                    <!-- End Header Logo -->
                </div>

                @if(pageRoute == "setting")
                {
                    <div class="col-lg-8 col-md-4 col-4" style="height:100%">
                        <div class="nav-inner" style="height:100%">
                            <nav class="navbar-expand-lg" style="height:100%; display: flex;">
                                <button class="navbar-toggler mobile-menu-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasLeft" aria-controls="offcanvasLeft"
                                        aria-expanded="false" aria-label="Toggle navigation" >
                                    <span class="toggler-icon"></span>
                                    <span class="toggler-icon"></span>
                                    <span class="toggler-icon"></span>
                                </button>
                            </nav>
                        </div>
                    </div>
                } 
                else 
                {
                    <div class="col-lg-8 col-md-4 col-4" style="height:100%">
                        <div class="nav-inner" style="height:100%">
                            <!-- Start Navbar -->
                            <nav class="navbar-expand-lg" style="height:100%; display: flex;">
                                <button class="navbar-toggler mobile-menu-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasLeft" aria-controls="offcanvasLeft"
                                        aria-expanded="false" aria-label="Toggle navigation" >
                                    <span class="toggler-icon"></span>
                                    <span class="toggler-icon"></span>
                                    <span class="toggler-icon"></span>
                                </button>
                                <div class="collapse navbar-collapse sub-menu-bar" id="navbarSupportedContent" style="height:100%">
                                    <ul class="nav nav-pills" id="pills-tab" role="tablist">
                                        <li class="nav-item" style="position:relative" role="presentation">
                                            <button class="nav-link @(pageRoute == "keranjang" ? "active" : "")" id="pills-keranjang-tab" data-bs-toggle="pill" data-bs-target="#pills-keranjang" type="button" role="tab" aria-controls="pills-keranjang" aria-selected="true">Keranjang</button>
                                            <span class="total-items-profil">@ScopedDataServices?.ScopedData?.ListDataCart.Count()</span>
                                        </li>
                                        <li class="nav-item" style="position:relative" role="presentation">
                                            <button class="nav-link @(pageRoute == "belum-bayar" ? "active" : "")" @onclick=@(x => moveTabs("belum-bayar")) id="pills-belum-bayar-tab" data-bs-toggle="pill" data-bs-target="#pills-belum-bayar" type="button" role="tab" aria-controls="pills-belum-bayar" aria-selected="false">Belum Bayar</button>
                                            <span class="total-items-profil">@(ScopedDataServices?.ScopedData?.ListDataSummaryPesanan.FirstOrDefault()?.summary.FirstOrDefault(x => x.status_order_1 == "belum bayar")?.jumlah ?? 0)</span>
                                        </li>
                                        <li class="nav-item" style="position:relative" role="presentation">
                                            <button class="nav-link @(pageRoute == "dikemas" ? "active" : "")" @onclick=@(x => moveTabs("dikemas")) id="pills-dikemas-tab" data-bs-toggle="pill" data-bs-target="#pills-dikemas" type="button" role="tab" aria-controls="pills-dikemas" aria-selected="false">Dikemas</button>
                                            <span class="total-items-profil">@(ScopedDataServices?.ScopedData?.ListDataSummaryPesanan.FirstOrDefault()?.summary.FirstOrDefault(x => x.status_order_1 == "dikemas")?.jumlah ?? 0)</span>
                                        </li>
                                        <li class="nav-item" style="position:relative" role="presentation">
                                            <button class="nav-link @(pageRoute == "dikirim" ? "active" : "")" @onclick=@(x => moveTabs("dikirim")) id="pills-dikirim-tab" data-bs-toggle="pill" data-bs-target="#pills-dikirim" type="button" role="tab" aria-controls="pills-dikirim" aria-selected="false">Dikirim</button>
                                            <span class="total-items-profil">@(ScopedDataServices?.ScopedData?.ListDataSummaryPesanan.FirstOrDefault()?.summary.FirstOrDefault(x => x.status_order_1 == "dikirim")?.jumlah ?? 0)</span>
                                        </li>
                                        <li class="nav-item" style="position:relative" role="presentation">
                                            <button class="nav-link @(pageRoute == "selesai" ? "active" : "")" @onclick=@(x => moveTabs("selesai"))  id="pills-selesai-tab" data-bs-toggle="pill" data-bs-target="#pills-selesai" type="button" role="tab" aria-controls="pills-selesai" aria-selected="false">Histori Beli</button>
                                        </li>
                                    </ul>
                                </div> <!-- navbar collapse -->
                            </nav>
                            <!-- End Navbar -->
                        </div>
                    </div>
                }


                <div class="col-4 d-lg-none d-flex justify-content-center">
                    <!-- Start Header Logo -->
                    <NavLink class="navbar-brand" style="cursor:pointer;" @onclick="@(e => NavigateToHome(""))">
                        <img src="@(GlobalDataService?.GlobalData?.ListDataCompany?.FirstOrDefault()?.Media?.FirstOrDefault(x => x.Media_Type == "landscape").Id_Media ?? "images/logo/logo-pdj.png")" alt="Logo">
                    </NavLink>

                    <!-- End Header Logo -->
                </div>

                <div class="col-xxl-2 col-lg-2 col-md-4 col-4 p-0" >
                    <div class="navbar-cart">
                        <div class="wishlist" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" aria-controls="offcanvasRight">
                            <a href="javascript:void(0)" class="menu-logo">
                                <svg xmlns="http://www.w3.org/2000/svg" class="" width="22" height="22" viewBox="0 0 24 24" fill="none">
                                    <path d="M10.875 18.75C15.2242 18.75 18.75 15.2242 18.75 10.875C18.75 6.52576 15.2242 3 10.875 3C6.52576 3 3 6.52576 3 10.875C3 15.2242 6.52576 18.75 10.875 18.75Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                    <path d="M16.4434 16.4453L20.9997 21.0016" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                </svg>
                            </a>
                        </div>

                        <AuthorizeView>

                            <Authorized>

                                <div class="dropdown text-end wishlist-2"> 
                                    <a href="#" class="d-block link-body-emphasis text-decoration-none dropdown-toggle item-head menu-logo" data-bs-toggle="dropdown" aria-expanded="false"> 
                                        <i class="lni lni-user-4" style="font-size:20px"></i>
                                        <span class="total-items">
                                            @(ScopedDataServices?.ScopedData?.ListDataSummaryPesanan.FirstOrDefault()?.summary.Where(x => x.status_order_1 != "selesai")?.Sum(x => x.jumlah) ?? 0)
                                        </span> 
                                    </a> 
                                    <ul class="dropdown-menu text-small" style=""> 
                                        <li style="cursor:pointer;" class="d-md-flex d-lg-none">
                                            <button class="dropdown-item dropdown-item-custom" @onclick="@(e => NavigateToHome("cart-page/keranjang"))">
                                                <div class="d-flex flex-row justify-content-end gap-3">
                                                    <i style="font-size:26px;" class="lni lni-cart-1"></i>
                                                    <span>Keranjang</span>
                                                </div>
                                                <span class="qty-info">@ScopedDataServices?.ScopedData?.ListDataCart.Count()</span>
                                            </button>
                                        </li> 
                                        <li style="cursor:pointer;">
                                            <button class="dropdown-item dropdown-item-custom" @onclick="@(e => NavigateToHome("cart-page/belum-bayar"))">
                                                <div class="d-flex flex-row justify-content-end gap-3">
                                                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M200-200v-560 560Zm0 80q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v100h-80v-100H200v560h560v-100h80v100q0 33-23.5 56.5T760-120H200Zm320-160q-33 0-56.5-23.5T440-360v-240q0-33 23.5-56.5T520-680h280q33 0 56.5 23.5T880-600v240q0 33-23.5 56.5T800-280H520Zm280-80v-240H520v240h280Zm-160-60q25 0 42.5-17.5T700-480q0-25-17.5-42.5T640-540q-25 0-42.5 17.5T580-480q0 25 17.5 42.5T640-420Z"/></svg>
                                                    <span>Belum Bayar</span>
                                                </div>
                                                <span class="qty-info">@(ScopedDataServices?.ScopedData?.ListDataSummaryPesanan.FirstOrDefault()?.summary.FirstOrDefault(x => x.status_order_1 == "belum bayar")?.jumlah ?? 0)</span>
                                            </button>
                                        </li> 
                                        <li style="cursor:pointer;">
                                            <button class="dropdown-item dropdown-item-custom" @onclick="@(e => NavigateToHome("cart-page/dikemas"))">
                                                <div class="d-flex flex-row justify-content-end gap-3">
                                                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M200-640v440h560v-440H640v320l-160-80-160 80v-320H200Zm0 520q-33 0-56.5-23.5T120-200v-499q0-14 4.5-27t13.5-24l50-61q11-14 27.5-21.5T250-840h460q18 0 34.5 7.5T772-811l50 61q9 11 13.5 24t4.5 27v499q0 33-23.5 56.5T760-120H200Zm16-600h528l-34-40H250l-34 40Zm184 80v190l80-40 80 40v-190H400Zm-200 0h560-560Z"/></svg>
                                                    <span>Dikemas</span>
                                                </div>
                                                <span class="qty-info">@(ScopedDataServices?.ScopedData?.ListDataSummaryPesanan.FirstOrDefault()?.summary.FirstOrDefault(x => x.status_order_1 == "dikemas")?.jumlah ?? 0)</span>
                                            </button>
                                        </li> 
                                        <li style="cursor:pointer;">
                                            <button class="dropdown-item dropdown-item-custom" @onclick="@(e => NavigateToHome("cart-page/dikirim"))">
                                                <div class="d-flex flex-row justify-content-end gap-3">
                                                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M280-160q-50 0-85-35t-35-85H60l18-80h113q17-19 40-29.5t49-10.5q26 0 49 10.5t40 29.5h167l84-360H182l4-17q6-28 27.5-45.5T264-800h456l-37 160h117l120 160-40 200h-80q0 50-35 85t-85 35q-50 0-85-35t-35-85H400q0 50-35 85t-85 35Zm357-280h193l4-21-74-99h-95l-28 120Zm-19-273 2-7-84 360 2-7 34-146 46-200ZM20-427l20-80h220l-20 80H20Zm80-146 20-80h260l-20 80H100Zm180 333q17 0 28.5-11.5T320-280q0-17-11.5-28.5T280-320q-17 0-28.5 11.5T240-280q0 17 11.5 28.5T280-240Zm400 0q17 0 28.5-11.5T720-280q0-17-11.5-28.5T680-320q-17 0-28.5 11.5T640-280q0 17 11.5 28.5T680-240Z"/></svg>
                                                    <span>Dikirim</span>
                                                </div>
                                                <span class="qty-info">@(ScopedDataServices?.ScopedData?.ListDataSummaryPesanan.FirstOrDefault()?.summary.FirstOrDefault(x => x.status_order_1 == "dikirim")?.jumlah ?? 0)</span>
                                            </button>
                                        </li> 
                                        <li style="cursor:pointer;">
                                            <button class="dropdown-item dropdown-item-custom" @onclick="@(e => NavigateToHome("cart-page/selesai"))">
                                                <div class="d-flex flex-row justify-content-end gap-3">
                                                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#1f1f1f"><path d="m787-145 28-28-75-75v-112h-40v128l87 87Zm-587 25q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v268q-19-9-39-15.5t-41-9.5v-243H200v560h242q3 22 9.5 42t15.5 38H200Zm0-120v40-560 243-3 280Zm80-40h163q3-21 9.5-41t14.5-39H280v80Zm0-160h244q32-30 71.5-50t84.5-27v-3H280v80Zm0-160h400v-80H280v80ZM720-40q-83 0-141.5-58.5T520-240q0-83 58.5-141.5T720-440q83 0 141.5 58.5T920-240q0 83-58.5 141.5T720-40Z"/></svg>
                                                    <span>Histori Pembelian</span>
                                                </div>
                                            </button>
                                        </li> 
                                        <li style="cursor:pointer;">
                                            <button class="dropdown-item dropdown-item-custom" @onclick="@(e => NavigateToHome("cart-page/setting"))">
                                                <div class="d-flex flex-row justify-content-end gap-3">
                                                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="m370-80-16-128q-13-5-24.5-12T307-235l-119 50L78-375l103-78q-1-7-1-13.5v-27q0-6.5 1-13.5L78-585l110-190 119 50q11-8 23-15t24-12l16-128h220l16 128q13 5 24.5 12t22.5 15l119-50 110 190-103 78q1 7 1 13.5v27q0 6.5-2 13.5l103 78-110 190-118-50q-11 8-23 15t-24 12L590-80H370Zm70-80h79l14-106q31-8 57.5-23.5T639-327l99 41 39-68-86-65q5-14 7-29.5t2-31.5q0-16-2-31.5t-7-29.5l86-65-39-68-99 42q-22-23-48.5-38.5T533-694l-13-106h-79l-14 106q-31 8-57.5 23.5T321-633l-99-41-39 68 86 64q-5 15-7 30t-2 32q0 16 2 31t7 30l-86 65 39 68 99-42q22 23 48.5 38.5T427-266l13 106Zm42-180q58 0 99-41t41-99q0-58-41-99t-99-41q-59 0-99.5 41T342-480q0 58 40.5 99t99.5 41Zm-2-140Z"/>
                                                    </svg>
                                                    <span>Pengaturan</span>
                                                </div>
                                            </button>
                                        </li> 
                                        <li style="cursor:pointer;">
                                            <button class="dropdown-item dropdown-item-custom" type="button" data-bs-toggle="modal" id="" data-bs-target="#exampleModalLogout" >
                                                <div class="d-flex flex-row justify-content-end gap-3">
                                                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h280v80H200Zm440-160-55-58 102-102H360v-80h327L585-622l55-58 200 200-200 200Z"/>
                                                    </svg>
                                                    <span>Keluar</span>
                                                </div>
                                            </button>
                                        </li> 
                                    </ul> 
                                </div>

                            </Authorized>

                        </AuthorizeView>
                    </div>
                </div>

                <div class="offcanvas offcanvas-end" style="width: 500px;" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel">
                    <div class="offcanvas-header">
                        <h5 id="offcanvasRightLabel" style="font-size: 1.5rem;font-weight: 800;">
                            Search
                        </h5>
                        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body">
                        <div class="row">
                            <div class="col-12">
                                <div class="input-group mb-3 style-grup">
                                    <span class="input-group-text" id="basic-addon1" style="padding: 0px;"><i class="lni lni-search-1" style="font:normal normal normal 22px/1 'Lineicons';"></i></span>
                                    <InputText autocomplete="off" @onkeydown="HandleKeyDown" @bind-Value=@SearchText @oninput="@(e => OnSearchInput(e.Value?.ToString()))" type="text" class="form-control search-form" placeholder="Search" aria-label="Search" aria-describedby="basic-addon1" />
                                    <button class="clear-search" @onclick="@(e => OnClearInput())" >
                                        @if(loadProses)
                                            {
                                                <div class="spinner-border spinner-border-sm" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            } else
                                            {
                                                <span>Clear</span>
                                            }
                                    </button>
                                </div>
                            </div>

                            @if (searchCount > 0) {

                                if (SearchList.SearchBrand.Count() >= 1) {

                                    <div class="col-12 pt-3" style="">
                                        <h5 id="offcanvasRightLabel" style="font-size: 1rem;font-weight: 600;">
                                            Brand
                                        </h5>
                                    </div>

                                    <div class="col-12 py-3" style="border-bottom:1px solid lightgray;">
                                        @foreach(var brand in SearchList.SearchBrand) {
                                            <button type="button" @onclick=@( x => searchCombo(null, brand, null) ) class="badge-search">@brand.Nama_Brand</button>
                                        }
                                    </div>

                                }


                                <div class="col-12 pt-4">
                                    <h5 id="offcanvasRightLabel" style="font-size: 1rem;font-weight: 600;">
                                        Produk
                                    </h5>
                                </div>
                        
                                <div class="col-12 py-3" style="border-bottom:1px solid lightgray;">
                                    <div class="row">
                                        @foreach(var dataProduk in SearchList.SearchProduk) {
                                            <div class="col-6 py-2">

                                                <!-- Start Single Product -->
                                                <div class="single-product">
                                                    <div class="product-image">
                                                        @if (dataProduk.MediaUrls.Count() >= 1)
                                                        {
                                                            <img src="@(dataProduk.MediaUrls[0]?.Id_Media == null || dataProduk.MediaUrls[0]?.Id_Media == "" ? "/images/products/placeholder1.png" : dataProduk.MediaUrls[0]?.Id_Media)" alt="@dataProduk.Nama_Display">
                                                        }

                                                        @if (dataProduk.Diskon1 != null || dataProduk.Diskon1 >= 1)
                                                        {
                                                            <span class="sale-tag">-@dataProduk.Diskon1.ToString()%</span>
                                                        }
                                                        @if (dataProduk.Tgl_Created != null && (DateTime.Now - dataProduk.Tgl_Created).TotalDays <= 3)
                                                        {
                                                            <span class="new-tag">New</span>
                                                        }
                                                    </div>
                                                    <div class="product-info">
                                                        <h4 class="title">
                                                            <NavLink style="cursor:pointer;"  @onclick=@(() => NavigateToDetailProduk(dataProduk.No_Id))>
                                                                <p class="line-clamp-2 underline-anim">
                                                                    @dataProduk.Nama_Display
                                                                </p>
                                                            </NavLink>
                                                        </h4>
                                                    </div>
                                                </div>
                                                <!-- End Single Product -->

                                            </div>
                                        }
                        
                                    </div>
                                </div>
                            
                                <div class="col-12 mt-3">
                                    <div class="btn-group w-100">
                                        <button class="btn-slide justify-content-start border-0" type="button" @onclick="@(x => seeResult())" aria-expanded="false">
                                            See all results for “@SearchText”
                                        </button>
                                    </div>
                                </div>
                        
                            } 
                            else if (searchCount == 0)
                            {

                            } else
                            {
                                <div class="d-flex flex-column align-items-center mt-4" style="color:#6b7280">
                                    <svg xmlns="http://www.w3.org/2000/svg" height="5rem" viewBox="0 -960 960 960" width="5rem" class="mb-3" fill="currentColor">
                                        <path d="m634-440-81-80h69l110-200H353l-80-80h525q23 0 35.5 19.5t.5 42.5L692-482q-11 20-28 31t-30 11ZM280-80q-33 0-56.5-23.5T200-160q0-33 23.5-56.5T280-240q33 0 56.5 23.5T360-160q0 33-23.5 56.5T280-80Zm540 52L566-280H304q-44 0-67-37.5t-3-78.5l42-86-72-162L28-820l56-56L876-84l-56 56ZM486-360l-80-80h-62l-40 80h182Zm136-160h-69 69Zm58 440q-33 0-56.5-23.5T600-160q0-33 23.5-56.5T680-240q33 0 56.5 23.5T760-160q0 33-23.5 56.5T680-80Z"/>
                                    </svg>
                                    <h5 style="color:#6b7280">Not Result Found "@SearchText"</h5>
                                    <p style="color:#6b7280">Check the spelling or use a different word or phrase.</p>
                                </div>
                            }

                    

                        </div>
                    </div>
                </div>
            

            </div>
        </div>
    </header>
}
<!-- Start Header Area -->

<div class="offcanvas offcanvas-start" style="width: 500px;" tabindex="-1" id="offcanvasLeft" aria-labelledby="offcanvasLeftLabel">
    <div class="offcanvas-header py-0">
        <div style="width:35%">
            <NavLink class="navbar-brand" style="cursor:pointer;" @onclick="@(e => NavigateToHome(""))" >
                <img src="@(@GlobalDataService?.GlobalData?.ListDataCompany?.FirstOrDefault()?.Media?.FirstOrDefault( x => x.Media_Type == "landscape").Id_Media ?? "images/logo/logo-pdj.png")" alt="Logo">
            </NavLink>
        </div>
        <button type="button" class="btn-close text-reset me-3" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body pt-0">
        <div class="row">
            <div class="col-12 px-0">
                <ul class="custom-nav-phone">
                    @if(GlobalDataService?.GlobalData?.ListDataNavbar?.Count() >= 1)
                    {
                        @foreach(var Navbar in GlobalDataService?.GlobalData?.ListDataNavbar) {
                            @if (Navbar?.Nav_Type.Split("_")[0] == "special") {
                                <li @onclick="@( x => searchContent(Navbar) )" class="py-2" style="" >
                                    <label style="display: flex;width: 100%;cursor: pointer;">
                                        <span class="" style="font-size:20px; font-weight:400;" >@Navbar?.Display_Text</span>
                                    </label>
                                </li>
                            } 
                            else 
                            {
                                <li class="" style="">

                                    <label class="py-2" @onclick=@(() => ShowNavbar($"{Navbar?.Nav_Type}-show-item", true) ) style="display: flex;width: 100%;align-items: center;justify-content: space-between;cursor: pointer;" >
                                        <span class="" style="font-size:20px; font-weight:400;" >@Navbar?.Display_Text</span>
