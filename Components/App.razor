    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    
    <script>
        function selectAllText(elementToBind) {
            var elementToCheck = document.getElementById(elementToBind);
            if (elementToCheck) {
                for (let child of elementToCheck.childNodes) {
                    if (child instanceof HTMLInputElement) {
                        child.addEventListener('click',
                            function () {
                                this.select();
                            });
                    }
                }
            }
        }

        function buttonClick(selectorName) {
            document.querySelector(selectorName).click();
        }

        function initFlayer() {
            const target = document.querySelector('#hidden-flayer');
            const flayer = document.querySelector('#flayer');

            const observer = new IntersectionObserver(
              (entries) => {
                entries.forEach(entry => {
                  if (entry.isIntersecting) {
                    // Section terlihat -> sembunyikan flayer
                    flayer.classList.remove('visible');
                  } else {
                    // Section tidak terlihat -> tampilkan flayer
                    flayer.classList.add('visible');
                  }
                });
              },
              {
                root: null,         // viewport
                threshold: 0,       // trigger begitu section keluar sepenuhnya
                rootMargin: '-85px 0px 0px 0px'
              }
            );

            observer.observe(target);
        }


        function initVaCopy() {
            const boxes = document.querySelectorAll('.va-box');

            boxes.forEach(box => {
                const btn = box.querySelector('.copy-btn');
                const textEl = box.querySelector('.va-body');

                let timerId = null;

                const getVa = () => {
                    // Prioritas: data-va (agar value tersembunyi juga bisa dicopy), fallback isi teks body
                    return box.getAttribute('data-va')?.trim() || textEl?.textContent?.trim() || '';
                };

                const setCopied = () => {
                    btn.textContent = 'Copied';
                    btn.classList.add('copied');
                    clearTimeout(timerId);
                    timerId = setTimeout(() => {
                        btn.textContent = 'Copy';
                        btn.classList.remove('copied');
                    }, 5000);
                };

                const copyText = async (value) => {
                    try {
                        if (navigator.clipboard?.writeText) {
                            await navigator.clipboard.writeText(value);
                        } else {
                            // Fallback untuk browser lama
                            const ta = document.createElement('textarea');
                            ta.value = value;
                            ta.style.position = 'fixed';
                            ta.style.opacity = '0';
                            document.body.appendChild(ta);
                            ta.focus();
                            ta.select();
                            document.execCommand('copy');
                            document.body.removeChild(ta);
                        }
                        setCopied();
                    } catch (e) {
                        console.error('Copy failed:', e);
                        // Jika gagal, beri sedikit feedback
                        btn.textContent = 'Failed';
                        btn.classList.remove('copied');
                        clearTimeout(timerId);
                        timerId = setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
                    }
                };

                btn.addEventListener('click', () => {
                    const value = getVa();
                    if (value) copyText(value);
                });
            });
        }


        function initslideProduct() {
            const products = document.querySelectorAll(".product");

            if (products.length === 0) return;

            const observer = new IntersectionObserver(entries => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("show");
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.2 });

            products.forEach(p => observer.observe(p));
        }

        function initItemsOrder(data) {
            const headerBtn = document.querySelector(".header-accord-" + data);
            const noneAccords = document.querySelectorAll(".none-accord-" + data);

            if (!headerBtn) return;

            if (!headerBtn.classList.contains("collapsed")) {
                // kalau accordion terbuka ? sembunyikan
                noneAccords.forEach(el => {
                    el.classList.add("hide");
                    setTimeout(() => {
                        el.style.setProperty("display", "none", "important");
                    }, 10);
                });
            } else {
                // kalau accordion tertutup ? tampilkan lagi
                noneAccords.forEach(el => {
                    el.style.display = "block";
                    setTimeout(() => {
                        el.classList.remove("hide");
                    }, 10);
                });
            }
        }

        function downloadFileFromBase64(filename, base64) {
            const link = document.createElement("a");
            link.href = "data:image/png;base64," + base64;
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }


        async function copyVa(kode) {

            // Cari tombol target spesifik berdasarkan kode
            const btn = document.querySelector(`.copy-btn-${kode}`);
            if (!btn) return;

            // Ambil nilai VA: prioritas data-va di parent
            const box = btn.closest('.va-box');
            const value = box?.getAttribute('data-va')?.trim() || btn.dataset.va?.trim() || '';

            let timerId;

            const setCopied = () => {
                btn.textContent = 'Copied';
                btn.classList.add('copied');
                clearTimeout(timerId);
                timerId = setTimeout(() => {
                    btn.textContent = 'Copy';
                    btn.classList.remove('copied');
                }, 5000);
            };

            try {
                if (navigator.clipboard?.writeText) {
                    await navigator.clipboard.writeText(value);
                } else {
                    // Fallback untuk browser lama
                    const ta = document.createElement('textarea');
                    ta.value = value;
                    ta.style.position = 'fixed';
                    ta.style.opacity = '0';
                    document.body.appendChild(ta);
                    ta.focus();
                    ta.select();
                    document.execCommand('copy');
                    document.body.removeChild(ta);
                }
                setCopied();
            } catch (err) {
                console.error('Copy failed:', err);
                btn.textContent = 'Failed';
                clearTimeout(timerId);
                timerId = setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
            }
        }




        function initHeaderMega() {
            document.querySelectorAll('.mega-parent').forEach(item => {
                item.addEventListener('mouseenter', () => {
                    item.querySelector('.mega-menu').classList.add('open');
                    document.querySelector('.overlay').classList.add('show');
                });
                item.addEventListener('mouseleave', () => {
                    item.querySelector('.mega-menu').classList.remove('open');
                    document.querySelector('.overlay').classList.remove('show');
                });
            });
        }

        function statusBarHidden() {
            window.setTimeout(fadeout, 500);
        }

        function fadeout() {
            document.querySelector('.preloader').style.opacity = '0';
            document.querySelector('.preloader').style.display = 'none';
        }

        function colLoadOut() {
            const el = document.querySelector('.col-load');
            if (!el) return console.log("class load not found");
            el.style.opacity = '0';
            setTimeout(() => {
                el.style.display = 'none';
            }, 500); // tunggu 0.5s sampai transisi selesai
        }

        function setFocusAndSelect(elementToBind) {
            setTimeout(function () {
               
                var elementToCheck = document.getElementById(elementToBind);
                if (elementToCheck) {
                 
                    // Look for the first input element (such as the one inside RadzenNumeric)
                    let inputElement = elementToCheck.querySelector('input');
                    if (inputElement) {
                        // Set focus and select the text
                      
                        inputElement.focus();
                        inputElement.select();

                        // Optionally, add a click event listener to re-select the text when clicked
                        inputElement.addEventListener('click', function () {
                            this.select();
                        });
                    }
                }
            }, 100); // Adjust this timeout duration if needed      
        }
        
        // Define the snapPay function
        function snapPay(transactionToken) {
            if (window.snap && typeof window.snap.pay === 'function') {
                window.snap.pay(transactionToken); // Call Midtrans snap.pay with the transaction token
            } else {
                console.error("Midtrans snap.js is not loaded or available.");
            }
        }

        function initTinySlider() {
            var slider = tns({
                container: ".hero-slider",
                items: 1,
                slideBy: "page",
                autoplay: true,
                nav: false,
                mouseDrag: true,
                gutter: 0,
                controls: true,
                autoplayButtonOutput: false,
                controlsText: ['<i class="lni lni-chevron-left"></i>', '<i class="lni lni-chevron-left" style="transform: scaleX(-1);"></i>'],
            });
        };

        function initDetailProd() {
            var sliderdetailProd = tns({
                container: ".slider-images",
                items: 5,
                mouseDrag: true,
                slideBy: "page",
                swipeAngle: false,
                speed: 400,
                loop: false,
                nav: false,
                controls: false,
            });
        };

        function initBigDetailProd() {
            var sliderdetailProd = tns({
                container: ".big-slider-images",
                items: 1,
                mouseDrag: true,
                slideBy: "page",
                swipeAngle: false,
                speed: 400,
                loop: false,
                nav: false,
                controls: false,
                navContainer: "#customize-thumbnails",
                navAsThumbnails: true,
            });
        };

        function initBigDetailProdInfo() {
            var swiper = new Swiper(".mySwiper", {
              loop: false,
                  spaceBetween: 0,
                  slidesPerView: 4,
                  freeMode: true,
              watchSlidesProgress: true,
            });

            var swiper2 = new Swiper(".mySwiper2", {
                loop: true,
                spaceBetween: 10,
                navigation: {
                    nextEl: ".swiper-button-next",
                    prevEl: ".swiper-button-prev",
                },
                thumbs: {
                    swiper: swiper,
                },
            });
        };

        function initMobileButton() {
            let navbarToggler = document.querySelector(".mobile-menu-btn");
            navbarToggler.addEventListener('click', function () {
                navbarToggler.classList.toggle("active");
                let navbarContent = document.querySelector("#navbarSupportedContent");
            });
        };

        let swiperInstance = null;

        function initSearchButton() {
            if (swiperInstance) {
                swiperInstance.destroy(true, true);
            }

            swiperInstance = new Swiper(".mySwiper1", {
                pagination: {
                el: ".swiper-pagination",
                type: "fraction",
                },
                navigation: {
                nextEl: ".swiper-button-next",
                prevEl: ".swiper-button-prev",
                },
            });
        };

        function scrollToTop() {
            window.scrollTo(0, 0);
        }

    </script>

</body>

