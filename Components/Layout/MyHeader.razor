                                </button>
                            </li> 
                            <li style="cursor:pointer;">
                                <button class="dropdown-item dropdown-item-custom">
                                    <div class="d-flex flex-row justify-content-end gap-3">
                                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="m370-80-16-128q-13-5-24.5-12T307-235l-119 50L78-375l103-78q-1-7-1-13.5v-27q0-6.5 1-13.5L78-585l110-190 119 50q11-8 23-15t24-12l16-128h220l16 128q13 5 24.5 12t22.5 15l119-50 110 190-103 78q1 7 1 13.5v27q0 6.5-2 13.5l103 78-110 190-118-50q-11 8-23 15t-24 12L590-80H370Zm70-80h79l14-106q31-8 57.5-23.5T639-327l99 41 39-68-86-65q5-14 7-29.5t2-31.5q0-16-2-31.5t-7-29.5l86-65-39-68-99 42q-22-23-48.5-38.5T533-694l-13-106h-79l-14 106q-31 8-57.5 23.5T321-633l-99-41-39 68 86 64q-5 15-7 30t-2 32q0 16 2 31t7 30l-86 65 39 68 99-42q22 23 48.5 38.5T427-266l13 106Zm42-180q58 0 99-41t41-99q0-58-41-99t-99-41q-59 0-99.5 41T342-480q0 58 40.5 99t99.5 41Zm-2-140Z"/>
                                        </svg>
                                        <span>Pengaturan</span>
                                    </div>
                                </button>
                            </li> 
                            <li style="cursor:pointer;">
                                <button class="dropdown-item dropdown-item-custom">
                                    <div class="d-flex flex-row justify-content-end gap-3">
                                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h280v80H200Zm440-160-55-58 102-102H360v-80h327L585-622l55-58 200 200-200 200Z"/>
                                        </svg>
                                        <span>Keluar</span>
                                    </div>
                                </button>
                            </li> 
                        </ul> 
                    </div>
                </div>
            </div>
            
            <div class="offcanvas offcanvas-end" style="width: 500px;" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel">
                <div class="offcanvas-header">
                    <h5 id="offcanvasRightLabel" style="font-size: 1.5rem;font-weight: 800;">
                        Search
                    </h5>
                    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                    <div class="row">
                        <div class="col-12">
                            <div class="input-group mb-3 style-grup">
                                <span class="input-group-text" id="basic-addon1" style="padding: 0px;"><i class="lni lni-search-2" style="font:normal normal normal 22px/1 'Lineicons';"></i></span>
                                <InputText @bind-Value=@SearchText @oninput="@(e => OnSearchInput(e.Value?.ToString()))" type="text" class="form-control search-form" placeholder="Search" aria-label="Search" aria-describedby="basic-addon1" />
                                <button class="clear-search" @onclick="@(e => OnClearInput())" >Clear</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="offcanvas offcanvas-start" style="width: 500px;" tabindex="-1" id="offcanvasLeft" aria-labelledby="offcanvasLeftLabel">
                <div class="offcanvas-header">
                    <h5 id="offcanvasLeftLabel" style="font-size: 1.5rem;font-weight: 800;">
                        Menu
                    </h5>
                    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                    <div class="row">
                        <div class="col-12">
                            
                        </div>
                    </div>
                </div>
            </div>
           
            <div class="offcanvas offcanvas-end" style="width: 500px;" tabindex="-1" id="offcanvascart" aria-labelledby="offcanvascartLabel">
                <div class="offcanvas-header">
                    <h5 id="offcanvascartLabel" style="font-size: 1.5rem;font-weight: 800; position:relative">
                        Keranjang
                        <span class="total-items-cart">@ListDataCart.Count()</span>
                    </h5>
                    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                    <div class="row" style="height:100%;">
                        <div class="col-12 col-data" style="display: flex;flex-direction: column;justify-content: space-between;">
                            <ul class="shopping-list">
                                @foreach(var cart in ListDataCart)
                                {
                                    <li>
                                        <div class="cart-img-head">
                                            @if(cart.Id_Media != null && cart.Id_Media != "")
                                            {
                                                <img class="cart-img" src="@cart.Id_Media" alt="#">
                                            } else
                                            {
                                                <div style="display:flex; align-items:center;justify-content:center; width:80px; height: 80px; border-radius:5px; background-color:lightgray; color:dimgrey">
                                                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M73-889 889-73l-57 57-104-104H200q-33 0-56.5-23.5T120-200v-528L16-832l57-57Zm287 447L200-282v82h448L544-304l-22 24-162-162ZM200-648v252l126-126-126-126Zm36-192h524q33 0 56.5 23.5T840-760v524l-80-80v-234L650-426l-57-57 167-187v-90H316l-80-80Zm357 357Zm-158 70ZM326-522Zm34 80Zm176-98Z"/></svg>
                                                </div>
                                            }
                                            <div class="d-flex flex-column justify-content-center h-100" style="gap:5px;">
                                                <h4>
                                                    <a href="javascript:void(0)" class="line-clamp-1" style="font-size:15px">
                                                        @(cart.Nama_Display)
                                                    </a>
                                                </h4>
                                                <p class="variant" style="background-color: #eee;width: fit-content;padding: 1px 5px;border-radius: 0px;">
                                                    @($"{cart.Option}, {cart.Size}")
                                                </p>
                                                <p class="quantity">
                                                    <span class="amount" style="font-size:16px; font-weight:600;">@string.Format("Rp. {0:N2}", cart.Harga)</span>
                                                </p>
                                            </div>
                                        </div>

                                        <div class="content content-qty">
                                            <div style="display: flex;justify-content:space-between;flex-direction: row;width:80%;">
                                                <a @onclick=@(() => deleteItemCart(cart)) class="hapus-card-item" style="cursor:pointer;" title="Remove this item">
                                                    @if(loadProses)
                                                    {
                                                        <div class="spinner-border" style="width: 0.8rem;height: 0.8rem; border: .15em solid currentColor;" role="status">
                                                            <span class="visually-hidden">Loading...</span>
                                                        </div>
                                                    } else
                                                    {
                                                        <span>hapus</span>
                                                    }
                                                </a>
                                                <label class="custom-checkbox">
                                                    <input type="checkbox" checked="@cart.SelectCart" @onchange="(e) => SelectItemCart(cart)">
                                                    <span></span>
                                                </label>
                                            </div>
                                            <div class="qty-box" style="width: 80%;height: 34px;padding: 21px 5px;gap: 8px;">
                                                <button style="font-size: 15px;" @onclick="() => Decrease(cart.Id_Cart)">–</button>
                                                <span style="font-size: 15px;height: 100%;display: flex;align-items: center;">@cart.Qty</span>
                                                <button style="font-size: 20px;" @onclick="() => Increase(cart.Id_Cart)">+</button>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                            <div class="bottom" style="border-top:1px solid #e6e6e6;padding-top: 10px;">
                                <div class="total" >
                                    <span>Total</span>
                                    @if(loadProsesNetto)
                                    {
                                        <div class="spinner-border" style="width: 0.8rem;height: 0.8rem; border: .15em solid currentColor;" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    } else
                                    {
                                        <span class="total-amount">
                                            @string.Format("Rp. {0:N2}", nettoKeranjang)
                                        </span>
                                    }
                                </div>
                                <div style="display:flex; flex-direction:row; gap:10px;">
                                    <div class="button" style="width:40%">
                                        <NavLink @onclick="@(e => NavigateToHome("cart-page/keranjang"))" class="btn animate animate-view" style="border-radius: 0px;display: flex;align-items: center;gap: 4px;">
                                            Lihat
                                            <i class="lni lni-cart-1 mt-0"></i>
                                        </NavLink>
                                    </div>
                                    <div class="button" style="width:60%;">
                                        <NavLink @onclick="@(e => CheckoutCart())" class="btn animate" style="border-radius:0px;">Checkout</NavLink>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-load" style="">
                            <div class="d-flex justify-content-center h-100 w-100 align-items-center">
                              <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                              </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

