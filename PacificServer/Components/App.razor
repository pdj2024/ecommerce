        function debounceMaps(func, delay) {
            let timeout;
            return (...args) => {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), delay);
            };
        }

        function ShowMaps(showIn) {
            var idmaps = document.getElementById("showMaps");
            var idauto = document.getElementById("showMapsAutoComplete");
            var idsim = document.getElementById("MapsSimpan");
            var idlan = document.getElementById("MapsSelanjutnya");

            if(showIn && !idmaps.classList.contains("d-block"))
            {
                idmaps.classList.remove("d-none");
                idmaps.classList.add("d-block");

                idauto.classList.remove("d-block");
                idauto.classList.add("d-none");

                idsim.classList.remove("d-none");
                idsim.classList.add("d-flex");

                idlan.classList.remove("d-flex");
                idlan.classList.add("d-none");
            } 
            else 
            {
                idmaps.classList.remove("d-block");
                idmaps.classList.add("d-none");

                idauto.classList.remove("d-none");
                idauto.classList.add("d-block");

                idlan.classList.remove("d-none");
                idlan.classList.add("d-flex");

                idsim.classList.remove("d-flex");
                idsim.classList.add("d-none");

            }
        }

        function initMapClick() {
            map.addListener("click", (e) => {
                const pos = e.latLng;

                // panToWithOffset(pos, 100);
                // map.setZoom(15);

                geocoder.geocode({ location: pos }, (results, status) => {

                    if (status !== "OK" || !results || results.length === 0) {
                        console.log("Geocoder gagal:", status);
                        return;
                    }

                    // 🔎 Cari result dengan address_components terbanyak
                    let bestResult = null;
                    let maxComponents = 0;

                    for (const r of results) {
                        const count = r.address_components ? r.address_components.length : 0;

                        // Prioritas utama: yang >= 7 langsung pakai kalau paling besar
                        if (count >= 7 && count > maxComponents) {
                            bestResult = r;
                            maxComponents = count;
                        }

                        // Backup: simpan yang paling banyak kalau tak ada yg >= 7
                        if (!bestResult && count > maxComponents) {
                            bestResult = r;
                            maxComponents = count;
                        }
                    }

                    // Kalau tetap gak ada (kasus sangat jarang), pakai result pertama
                    if (!bestResult) {
                        bestResult = results[0];
                    }

                    console.log("Dipilih result dengan komponen:", maxComponents, bestResult.formatted_address);

                    let components = normalizeComponents(bestResult.address_components);
                    

                    fillAddress(
                        components,
                        bestResult.geometry.location.lat(),
                        bestResult.geometry.location.lng()
                    );

                });

                marker.position = pos;
            });
        }

        function initAutoComplate() {
            const inputEl = document.getElementById("place-autocomplete-input");

            placeAutocomplete.addEventListener("gmp-select", async (event) => {
                const place = event.placePrediction.toPlace();

                await place.fetchFields({
                    fields: ["displayName", "formattedAddress", "location", "viewport", "addressComponents"],
                });

                if (!place.location) return;

                if (place.viewport) {
                    map.fitBounds(place.viewport);
                } else {
                    panToWithOffset(place.location, 100);
                    // map.setZoom(15);
                }


                let components = normalizeComponents(place.addressComponents);
                const get = (type) => components.find(c => c.types.includes(type))?.long_name || "";

                console.log((get("route") + " " + get("street_number")).trim());
                console.log(components);
                console.log(place.addressComponents);
                console.log(place.formattedAddress);

                const streetName = place.displayName + ", " + (get("route") + " " + get("street_number")).trim();

                inputEl.value = streetName;

                fillAddress(components, place.location.lat(), place.location.lng());

                marker.position = place.location;
            });
        }

        async function geocodeManualAddress(textAddress) {
            return new Promise((resolve, reject) => {
                geocoder.geocode({ address: textAddress }, (results, status) => {
                    if (status === "OK" && results[0]) {
                        resolve(results[0]);
                    } else {
