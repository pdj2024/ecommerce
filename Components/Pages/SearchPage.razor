@rendermode InteractiveServer
@page "/search-page"


<!-- Start Trending Product Area -->
<section class="trending-product section" style="margin-top: 2rem;">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="section-title">
                    <h2>Search "Sepatu Adidas"</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-3 d-none d-md-none d-lg-flex">
                <div class="accordion" id="accordionExample">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingOne">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                            Item #1
                        </button>
                        </h2>
                        <div id="collapseOne" class="accordion-collapse collapse show">
                        <div class="accordion-body">
                            <strong>Isi konten accordion 1.</strong>
                        </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingTwo">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                            Item #2
                        </button>
                        </h2>
                        <div id="collapseTwo" class="accordion-collapse collapse">
                        <div class="accordion-body">
                            <strong>Isi konten accordion 2.</strong>
                        </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-9">
                <div class="row">
                    @foreach (var dataProduk in ListDataProduk) {
                        <div class="col-lg-4 col-md-6 col-6 pt-2 pb-2">
                            <!-- Start Single Product -->
                            <div class="single-product">
                                <div class="product-image">
                                    @if (dataProduk.MediaUrls.Count() >= 1)
                                    {
                                        <img src="@dataProduk.MediaUrls[0]?.Id_Media" alt="@dataProduk.Nama_Display">
                                    }
                                    else
                                    {
                                        <img src="https://placehold.co/600x600" alt="@dataProduk.Nama_Display">
                                    }
                                    @if (dataProduk.Diskon1 != null || dataProduk.Diskon1 >= 1) {
                                        <span class="sale-tag">-@dataProduk.Diskon1.ToString()%</span>
                                    }
                                    @if (dataProduk.Tgl_Created != null && (DateTime.Now - dataProduk.Tgl_Created).TotalDays <= 3)
                                    {
                                        <span class="new-tag">New</span>
                                    }
                                    <div class="button">
                                        <NavLink href="@($"/detail-produk/{dataProduk.No_Id}")" class="btn">Tambahkan <i class="lni lni-cart ms-3 flip-logo"></i></NavLink>
                                    </div>
                                </div>
                                <div class="product-info">
                                    <span class="category">
                                        @foreach (var kategori in dataProduk.Nama_Kategori) 
                                        {
                                        @kategori
                                        }
                                    </span>
                                    <h4 class="title clamp-2">
                                        <NavLink href="@($"/detail-produk/{dataProduk.No_Id}")">
                                            @dataProduk.Nama_Display
                                        </NavLink>
                                    </h4>
                                    @* <ul class="review">
                                        <li><i class="lni lni-star-filled"></i></li>
                                        <li><i class="lni lni-star-filled"></i></li>
                                        <li><i class="lni lni-star-filled"></i></li>
                                        <li><i class="lni lni-star-filled"></i></li>
                                        <li><i class="lni lni-star"></i></li>
                                        <li><span>4.0 Review(s)</span></li>
                                    </ul> *@
                                    <div class="price">
                                        <span>@string.Format("Rp. {0:N2}", dataProduk.Harga)</span>
                                        @if (dataProduk.Diskon1 != null || dataProduk.Diskon1 >= 1)
                                        {
                                            <span class="discount-price">@string.Format("Rp. {0:N2}", ((dataProduk.Diskon1/100) * dataProduk.Harga))</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <!-- End Single Product -->
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- End Trending Product Area -->

