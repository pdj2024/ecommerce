    //   };
    // });



    function closeDropAddress(param1) {
        var element = document.querySelector(param1);
        if(element == null) return;

        element.classList.remove("show-addres");
    }

    function openDropAddress(param1) {
        var element = document.querySelector(param1);
        if(element == null) return;

        document.querySelectorAll(".dropdown-list-addres").forEach(
            item => {
                if(item.id === param1.slice(1)) return;
                item.classList.remove("show-addres");
            }
        );

        if(element.classList.contains("show-addres")) 
        {
            element.classList.remove("show-addres");
        } 
        else 
        {
            element.classList.toggle("show-addres");
        }
    }


</script>